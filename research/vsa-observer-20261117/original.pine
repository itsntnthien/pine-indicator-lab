    bool preview
f_c07_relation(mainValid, direction, cloudState) =>
    not mainValid ? CR_NOT_APPLICABLE : cloudState == 0 ? CR_NO_TEST : cloudState == direction ? CR_ALIGNED : CR_OPPOSED
f_c07_inspector(main, candidates, cloudState, cloudReason, entry, atr) =>
    int relation = f_c07_relation(main.valid, main.direction, cloudState)
    bool contextOk = main.valid and main.source_slot >= 0 and main.source_slot < 6 and main.source_slot < array.size(candidates)
    MainCandidate context = contextOk ? array.get(candidates, main.source_slot) : MainCandidate.new(-1, na, na, 0, 0, na, na, na, na, na, na, na, na, na, na, false, false, false, na, 0, 0, 0, 0, 0, 0, 0, -1, DIR_NEUTRAL, na, na, "-1:0:-1:-1", 0)
    contextOk := contextOk and context.slot == main.source_slot and context.family == main.family and context.subtype == main.subtype and context.direction == main.direction and context.source_bar_index == main.source_bar_index and main.commit_bar_index >= 1 and main.commit_epoch_ms >= 0
    int committedEntry = main.entry_ticks
    int source = main.stop_source
    int sl = main.sl_ticks
    int tp = main.effective_tp_ticks
    int risk = na
    int reward = na
    int rr = na
    int reason = not main.valid ? RR_NO_MAIN : not contextOk ? RR_MAIN_CONTEXT_MISMATCH : main.direction != DIR_BULLISH and main.direction != DIR_BEARISH ? RR_DIRECTION_INVALID : na(committedEntry) ? RR_MISSING_ENTRY : RR_OK
    if reason == RR_OK and source != SS_THESIS_ANCHOR and source != SS_ATR_FALLBACK and source != SS_THESIS_BUFFER and source != SS_MINIMUM_ATR_FLOOR
        reason := RR_MISSING_STOP_CONTEXT
    if reason == RR_OK and na(sl)
        reason := RR_ARITHMETIC_UNREPRESENTABLE
    if reason == RR_OK
        bool riskGeometryValid = main.direction == DIR_BULLISH ? sl < committedEntry : committedEntry < sl
        bool riskSubtractOverflow = riskGeometryValid and (main.direction == DIR_BULLISH ? sl < 0 and committedEntry > 9223372036854775807 + sl : committedEntry < 0 and sl > 9223372036854775807 + committedEntry)
        if not riskGeometryValid
            reason := RR_STOP_GEOMETRY_INVALID
        else if riskSubtractOverflow
            reason := RR_ARITHMETIC_UNREPRESENTABLE
        else
            risk := main.direction == DIR_BULLISH ? committedEntry - sl : sl - committedEntry
            if risk <= 0 or na(main.risk_ticks) or main.risk_ticks != risk
                reason := RR_STOP_GEOMETRY_INVALID
    if reason == RR_OK
        bool desiredPolicyValid = main.target_policy_mode != TPM_NONE and not na(main.desired_target_r_milli) and main.desired_target_r_milli > 0 and not na(main.desired_tp_ticks)
        if not desiredPolicyValid
            reason := RR_TARGET_GEOMETRY_INVALID
        else if risk > int(math.floor(9223372036854775807 / main.desired_target_r_milli))
            reason := RR_ARITHMETIC_UNREPRESENTABLE
        else
            int desiredDistance = int(math.floor(risk * main.desired_target_r_milli / RR_SCALE))
            bool desiredOverflow = main.direction == DIR_BULLISH ? committedEntry > 9223372036854775807 - desiredDistance : committedEntry < -9223372036854775808 + desiredDistance
            int expectedDesiredTp = desiredOverflow ? na : committedEntry + main.direction * desiredDistance
            if desiredOverflow or expectedDesiredTp != main.desired_tp_ticks
                reason := RR_ARITHMETIC_UNREPRESENTABLE
    if reason == RR_OK
        bool geometryValid = main.direction == DIR_BULLISH ? sl < committedEntry and committedEntry < tp : tp < committedEntry and committedEntry < sl
        if na(tp) or not geometryValid
            reason := RR_TARGET_GEOMETRY_INVALID
        else
            reward := math.abs(tp - committedEntry)
            if reward <= 0
                reason := RR_TARGET_GEOMETRY_INVALID
            else if reward > int(math.floor(9223372036854775807 / RR_SCALE))
                reason := RR_ARITHMETIC_UNREPRESENTABLE
            else
                rr := int(math.floor(reward * RR_SCALE / risk))
                if na(main.effective_rr_milli) or main.effective_rr_milli != rr
                    reason := RR_ARITHMETIC_UNREPRESENTABLE
    if reason == RR_OK
        bool selectedOk = main.selected_market_target_present and main.selected_market_target_type == MTT_CANONICAL_LIQUIDITY_POOL and not na(main.selected_market_target_identity) and main.selected_market_target_identity > 0 and main.selected_market_target_ticks == tp and not na(main.target_source_bar) and main.target_source_bar >= 0 and main.target_source_bar < main.commit_bar_index and main.available_rr_valid and main.available_reward_ticks == reward and main.available_rr_milli == rr
        bool absentOk = not main.selected_market_target_present and main.selected_market_target_type == MTT_NONE and na(main.selected_market_target_identity) and na(main.selected_market_target_ticks) and na(main.target_source_bar) and na(main.available_reward_ticks) and not main.available_rr_valid and na(main.available_rr_milli) and tp == main.desired_tp_ticks
        if not selectedOk and not absentOk
            reason := RR_MAIN_CONTEXT_MISMATCH
    bool valid = reason == RR_OK
    C07Inspector.new(main.valid, main.direction, main.family, main.subtype, main.source_slot, main.source_bar_index, main.grade, main.total_quality, main.grade_reason_mask, main.arbitration_reason, main.commit_bar_index, main.commit_epoch_ms, cloudState, cloudReason, relation, valid, reason, valid ? source : SS_NONE, valid ? committedEntry : na, valid ? sl : na, valid ? tp : na, valid ? risk : na, valid ? reward : na, valid ? rr : na)
float scalpSpreadPrice = input.float(0.7, "Round-trip spread allowance", minval = 0.0, maxval = 5.0, step = 0.1, group = "Release / Execution")
bool adaptiveStops = input.bool(false, "Adaptive structural stops", group = "Release / Risk")
float stopBufferAtr = input.float(0.20, "Stop buffer (ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = "Release / Risk")
float minimumStopAtr = input.float(0.60, "Minimum stop distance (ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = "Release / Risk")
float spreadBufferMultiplier = input.float(1.5, "Stop buffer spread multiplier", minval = 0.0, maxval = 5.0, step = 0.1, group = "Release / Risk")
f_b04_plan(c, entry, atr, signalBarIndex, liquidityPools) =>
    int targetPolicyMode = TPM_BASELINE_FIXED_R
    int desiredTargetRMilli = TARGET_R_MILLI
    bool hardFeasible = c.veto_mask == 0 and c.primary_veto_id == VETO_NONE and (c.direction == DIR_BULLISH or c.direction == DIR_BEARISH) and c.family >= MF_CONTINUATION and c.family <= MF_REVERSAL and not na(entry) and not na(atr) and atr > 0
    bool anchorValid = not na(c.thesis_anchor_ticks) and not na(entry) and (c.direction == DIR_BULLISH ? c.thesis_anchor_ticks < entry : c.thesis_anchor_ticks > entry)
    bool fallbackAvailable = not na(entry) and not na(atr) and atr > 0
    bool fallbackOverflow = fallbackAvailable and (c.direction == DIR_BULLISH ? entry < -9223372036854775808 + atr : entry > 9223372036854775807 - atr)
    int atrTicks = fallbackAvailable ? atr : na // Caller already supplies integer ticks.
    int adaptiveBufferTicks = adaptiveStops and not na(atrTicks) ? math.max(int(math.ceil(atrTicks * stopBufferAtr)), int(math.ceil(f_to_ticks(scalpSpreadPrice, syminfo.mintick) * spreadBufferMultiplier))): 0
    int minimumRiskTicks = adaptiveStops and not na(atrTicks) ? int(math.ceil(atrTicks * minimumStopAtr)) : 0
    int bufferedAnchor = anchorValid ? c.thesis_anchor_ticks - c.direction * adaptiveBufferTicks : na
    int anchorRisk = anchorValid ? (entry - bufferedAnchor) * c.direction : na
    int adaptiveSl = anchorValid and anchorRisk < minimumRiskTicks ? entry - c.direction * minimumRiskTicks : bufferedAnchor
    int stopSource = not anchorValid ? (fallbackAvailable ? SS_ATR_FALLBACK : SS_NONE) : not adaptiveStops ? SS_THESIS_ANCHOR : anchorRisk < minimumRiskTicks ? SS_MINIMUM_ATR_FLOOR : adaptiveBufferTicks > 0 ? SS_THESIS_BUFFER : SS_THESIS_ANCHOR
    int sl = adaptiveStops and anchorValid ? adaptiveSl : anchorValid ? c.thesis_anchor_ticks : fallbackAvailable and not fallbackOverflow ? entry - c.direction * atr : na
    bool riskGeometryValid = c.direction == DIR_BULLISH ? not na(entry) and not na(sl) and sl < entry : c.direction == DIR_BEARISH and not na(entry) and not na(sl) and entry < sl
    bool riskSubtractOverflow = riskGeometryValid and (c.direction == DIR_BULLISH ? sl < 0 and entry > 9223372036854775807 + sl : entry < 0 and sl > 9223372036854775807 + entry)
    int risk = riskGeometryValid and not riskSubtractOverflow ? (c.direction == DIR_BULLISH ? entry - sl : sl - entry) : na
    bool planProductValid = not na(risk) and risk > 0 and desiredTargetRMilli > 0 and risk <= int(math.floor(9223372036854775807 / desiredTargetRMilli))
    int targetDistance = planProductValid ? int(math.floor(risk * desiredTargetRMilli / RR_SCALE)) : na
    bool targetValid = planProductValid and (c.direction == DIR_BULLISH ? entry <= 9223372036854775807 - targetDistance : entry >= -9223372036854775808 + targetDistance)
    int desiredTp = targetValid ? entry + c.direction * targetDistance : na
    bool selectorStateValid = array.size(liquidityPools) <= 8 and not na(signalBarIndex)
    bool selectedPresent = false
    int selectedIdentity = na
    int selectedTicks = na
    int selectedSourceBar = na
    if selectorStateValid and targetValid and array.size(liquidityPools) > 0
        int requiredSide = c.direction == DIR_BULLISH ? DIR_BEARISH : DIR_BULLISH
        for index = 0 to array.size(liquidityPools) - 1
            Liquidity item = array.get(liquidityPools, index)
            bool inWindow = c.direction == DIR_BULLISH ? entry < item.level_ticks and item.level_ticks <= desiredTp : desiredTp <= item.level_ticks and item.level_ticks < entry
            bool eligible = not item.terminal and not item.swept and item.creation_bar_index < signalBarIndex and item.side == requiredSide and inWindow
            bool nearer = not selectedPresent or (c.direction == DIR_BULLISH ? item.level_ticks < selectedTicks : item.level_ticks > selectedTicks)
            bool tieWins = selectedPresent and item.level_ticks == selectedTicks and item.creation_sequence_id < selectedIdentity
            if eligible and (nearer or tieWins)
                selectedPresent := true
                selectedIdentity := item.creation_sequence_id
                selectedTicks := item.level_ticks
                selectedSourceBar := item.creation_bar_index
    int effectiveTp = selectedPresent ? selectedTicks : desiredTp
    bool geometryValid = c.direction == DIR_BULLISH ? not na(sl) and not na(entry) and not na(effectiveTp) and sl < entry and entry < effectiveTp : c.direction == DIR_BEARISH and not na(sl) and not na(entry) and not na(effectiveTp) and effectiveTp < entry and entry < sl
    int reward = geometryValid ? math.abs(effectiveTp - entry) : na
    bool rrValid = geometryValid and risk > 0 and reward > 0 and reward <= int(math.floor(9223372036854775807 / RR_SCALE))
    int rrMilli = rrValid ? int(math.floor(reward * RR_SCALE / risk)) : na
    bool entryReady = selectorStateValid and hardFeasible and rrValid and rrMilli >= HARD_RR_MIN_MILLI and (c.grade == GRADE_A or c.grade == GRADE_B)
    B04Plan.new(entryReady, hardFeasible, stopSource, entry, sl, risk, targetPolicyMode, desiredTargetRMilli, desiredTp, selectedPresent, selectedPresent ? MTT_CANONICAL_LIQUIDITY_POOL : MTT_NONE, selectedIdentity, selectedTicks, selectedSourceBar, selectedPresent ? reward : na, selectedPresent and rrValid, selectedPresent and rrValid ? rrMilli : na, effectiveTp, rrValid ? rrMilli : na)
f_c06_eligible(c, slot, entry, atr, signalBarIndex, liquidityPools) =>
    int expectedFamily = slot < 2 ? MF_CONTINUATION : slot < 4 ? MF_BREAKOUT : MF_REVERSAL
    int expectedDirection = slot % 2 == 0 ? DIR_BULLISH : DIR_BEARISH
    bool subtypeValid = expectedFamily == MF_CONTINUATION ? c.subtype == MST_CONT_PULLBACK or c.subtype == MST_CONT_RECLAIM : expectedFamily == MF_BREAKOUT ? c.subtype == MST_BREAK_STRUCTURE or c.subtype == MST_BREAK_RANGE : c.subtype == MST_REV_STRUCTURE or c.subtype == MST_REV_EXHAUSTION
    B04Plan plan = f_b04_plan(c, entry, atr, signalBarIndex, liquidityPools)
    c.slot == slot and c.family == expectedFamily and c.direction == expectedDirection and subtypeValid and c.state == CS_ELIGIBLE and plan.entry_ready and c.veto_mask == 0 and c.primary_veto_id == VETO_NONE and (c.grade == GRADE_A or c.grade == GRADE_B) and not na(c.source_bar_index) and c.source_bar_index >= 1 and c.setup_quality >= 0 and c.setup_quality <= 100 and c.entry_quality >= 0 and c.entry_quality <= 100 and c.total_quality >= 0 and c.total_quality <= 100
f_c06_wins(a, b) =>
    a.grade > b.grade or a.grade == b.grade and (a.total_quality > b.total_quality or a.total_quality == b.total_quality and (a.family < b.family or a.family == b.family and a.slot < b.slot))
f_c06_main_decision(candidate, plan, reason, commitBar, commitEpoch) =>
    MainDecision.new(true, 1, candidate.direction, candidate.family, candidate.subtype, candidate.slot, candidate.source_bar_index, candidate.grade, candidate.setup_quality, candidate.entry_quality, candidate.total_quality, candidate.veto_mask, candidate.grade_reason_mask, reason, commitBar, commitEpoch, plan.target_policy_mode, plan.desired_target_r_milli, plan.desired_tp_ticks, plan.selected_market_target_present, plan.selected_market_target_type, plan.selected_market_target_identity, plan.selected_market_target_ticks, plan.target_source_bar, plan.available_reward_ticks, plan.available_rr_valid, plan.available_rr_milli, plan.effective_tp_ticks, plan.effective_rr_milli, plan.stop_source, plan.entry_ticks, plan.sl_ticks, plan.risk_ticks)
f_c06_arbitrate(candidates, entry, atr, signalBarIndex, liquidityPools) =>
    int mask = 0
    int bull = -1
    int bear = -1
    // A complete six-slot cohort is required; observation charts have none.
    for slot = 0 to (array.size(candidates) == 6 ? 5 : na)
        MainCandidate c = array.get(candidates, slot)
        if f_c06_eligible(c, slot, entry, atr, signalBarIndex, liquidityPools)
            mask += slot == 0 ? 1 : slot == 1 ? 2 : slot == 2 ? 4 : slot == 3 ? 8 : slot == 4 ? 16 : 32
            int current = c.direction == DIR_BULLISH ? bull : bear
            if current == -1 or f_c06_wins(c, array.get(candidates, current))
                if c.direction == DIR_BULLISH
                    bull := slot
                else
                    bear := slot
    int winner = bull == -1 ? bear : bear == -1 ? bull : f_c06_wins(array.get(candidates, bull), array.get(candidates, bear)) ? bull : bear
    [mask, bull, bear, winner]
f_c05_regime_cell(regime, family) =>
    family == MF_CONTINUATION ? (regime == 6 ? 2 : (regime == 1 or regime == 2 or regime == 5 ? 1 : 0)) : family == MF_BREAKOUT ? (regime == 1 ? 2 : (regime == 2 or regime == 7 or regime == 8 ? 1 : 0)) : (regime == 3 or regime == 4 or regime == 6 or regime == 7 or regime == 8 ? 1 : 0)
f_c05_score(a, b, c, d, e, effect) =>
    math.max(0, math.min(100, int(math.floor((a + b + c + d + e + 50) / 100)) + effect))
f_c05_grade(setup, entry, total, veto) =>
    veto != 0 ? GRADE_REJECTED : setup >= GRADE_A_SETUP_MIN and entry >= GRADE_A_ENTRY_MIN and total >= GRADE_A_TOTAL_MIN ? GRADE_A : setup >= GRADE_B_SETUP_MIN and entry >= GRADE_B_ENTRY_MIN and total >= GRADE_B_TOTAL_MIN ? GRADE_B : setup >= 45 and entry >= 40 ? GRADE_C : GRADE_REJECTED
f_dow_alignment(primary, secondary, execution) =>
    primary == DOW_TREND_UNAVAILABLE or secondary == DOW_TREND_UNAVAILABLE or execution == DOW_TREND_UNAVAILABLE ? DOW_ALIGNMENT_UNAVAILABLE : primary == DOW_TREND_BEAR and secondary == DOW_TREND_BEAR and execution == DOW_TREND_BEAR ? DOW_ALIGNMENT_FULL_BEAR : primary == DOW_TREND_BULL and secondary == DOW_TREND_BULL and execution == DOW_TREND_BULL ? DOW_ALIGNMENT_FULL_BULL : primary == DOW_TREND_BEAR and secondary != DOW_TREND_BEAR and (execution == DOW_TREND_BEAR or execution == DOW_TREND_NEUTRAL) ? DOW_ALIGNMENT_BEAR_CORRECTIVE : primary == DOW_TREND_BULL and secondary != DOW_TREND_BULL and (execution == DOW_TREND_BULL or execution == DOW_TREND_NEUTRAL) ? DOW_ALIGNMENT_BULL_CORRECTIVE : (primary == DOW_TREND_BULL or secondary == DOW_TREND_BULL or execution == DOW_TREND_BULL) and (primary == DOW_TREND_BEAR or secondary == DOW_TREND_BEAR or execution == DOW_TREND_BEAR) ? DOW_ALIGNMENT_CONFLICTING : DOW_ALIGNMENT_NEUTRAL
f_dow_severity_effect(direction, primary, secondary, execution) =>
    bool unavailable = primary == DOW_TREND_UNAVAILABLE or secondary == DOW_TREND_UNAVAILABLE or execution == DOW_TREND_UNAVAILABLE
    int support = direction == DIR_BULLISH ? DOW_TREND_BULL : DOW_TREND_BEAR
    int opposite = direction == DIR_BULLISH ? DOW_TREND_BEAR : DOW_TREND_BULL
    bool lowerOpposes = secondary == opposite or execution == opposite
    int severity = direction == DIR_NEUTRAL or unavailable ? 0 : primary == opposite ? 3 : primary == DOW_TREND_NEUTRAL and lowerOpposes ? 2 : lowerOpposes ? 1 : 0
    int effect = direction == DIR_NEUTRAL or unavailable ? DOW_NEUTRAL : primary == opposite ? DOW_CONFLICT_STRONG : lowerOpposes ? DOW_CONFLICT : primary == support and secondary == support and execution == support ? DOW_SUPPORT_STRONG : primary == support or secondary == support or execution == support ? DOW_SUPPORT : DOW_NEUTRAL
    [severity, effect]
f_c08_rr_text(rr) =>
    int whole = int(math.floor(rr / 1000))
    int fraction = rr % 1000
    str.tostring(whole) + "." + (fraction < 10 ? "00" : fraction < 100 ? "0" : "") + str.tostring(fraction)
f_c08_price_text(ticks) =>
    str.tostring(ticks * syminfo.mintick, format.mintick)
