int WARMUP_BARS = 21
f_r9_timeframe_family_authorized(timeframeMinutes, family) =>
    timeframeMinutes == 1 ? family != MF_REVERSAL : timeframeMinutes == 3 ? true : timeframeMinutes == 5 ? family != MF_REVERSAL : timeframeMinutes == 15 ? family == MF_REVERSAL : false
f_r9_context_stability_authorized(timeframeMinutes, family, subtype, grade, regime) =>
    bool m3PressurePullback = timeframeMinutes == 3 and subtype == MST_CONT_PULLBACK and (regime == REGIME_RANGE_PRESSURE_UP or regime == REGIME_RANGE_PRESSURE_DOWN)
    bool m5LateTrendGradeA = timeframeMinutes == 5 and family == MF_CONTINUATION and grade == GRADE_A and (regime == REGIME_UPTREND or regime == REGIME_DOWNTREND)
    bool m15StructuralReversal = timeframeMinutes == 15 and subtype == MST_REV_STRUCTURE
    not (m3PressurePullback or m5LateTrendGradeA or m15StructuralReversal)
f_r9_cost_risk_authorized(timeframeMinutes, grossRiskTicks, spreadTicks) =>
    int maximumCostRiskMilli = timeframeMinutes == 1 ? SCALP_MAX_COST_RISK_M1_MILLI : timeframeMinutes == 3 ? SCALP_MAX_COST_RISK_M3_MILLI : timeframeMinutes == 5 ? SCALP_MAX_COST_RISK_M5_MILLI : timeframeMinutes == 15 ? SCALP_MAX_COST_RISK_M15_MILLI : 1000
    grossRiskTicks > 0 and spreadTicks * 1000 <= grossRiskTicks * maximumCostRiskMilli
f_r9_entry_context_authorized(timeframeMinutes, direction, family, subtype, grade, quality, regime, trendStrength, structureEvent, breakDirection) =>
    bool timeframeFamilyAuthorized = f_r9_timeframe_family_authorized(timeframeMinutes, family)
    bool contextStabilityAuthorized = f_r9_context_stability_authorized(timeframeMinutes, family, subtype, grade, regime)
    bool strictTrendAligned = direction == DIR_BULLISH ? regime == REGIME_UPTREND : regime == REGIME_DOWNTREND
    bool pressureAligned = direction == DIR_BULLISH ? regime == REGIME_RANGE_PRESSURE_UP : regime == REGIME_RANGE_PRESSURE_DOWN
    bool structureAligned = direction == DIR_BULLISH ? structureEvent == SE_BOS_BULLISH or structureEvent == SE_CHOCH_BULLISH : structureEvent == SE_BOS_BEARISH or structureEvent == SE_CHOCH_BEARISH
    bool breakRangeAligned = regime == REGIME_BREAKOUT_CANDIDATE and breakDirection == direction
    bool opposingStrongTrend = direction == DIR_BULLISH ? regime == REGIME_DOWNTREND and trendStrength >= DCA_MIN_TREND_STRENGTH : regime == REGIME_UPTREND and trendStrength >= DCA_MIN_TREND_STRENGTH
    int continuationMinimumStrength = subtype == MST_CONT_RECLAIM ? ENTRY_RECLAIM_MIN_STRENGTH : ENTRY_CONTINUATION_MIN_STRENGTH
    bool continuationAuthorized = family == MF_CONTINUATION and (strictTrendAligned or pressureAligned) and trendStrength >= continuationMinimumStrength
    bool breakoutEvidenceAligned = subtype == MST_BREAK_STRUCTURE ? structureAligned : subtype == MST_BREAK_RANGE ? breakRangeAligned : false
    bool breakoutAuthorized = family == MF_BREAKOUT and breakoutEvidenceAligned and trendStrength >= ENTRY_BREAKOUT_MIN_STRENGTH
    bool structuralReversal = family == MF_REVERSAL and subtype == MST_REV_STRUCTURE and structureAligned
    bool exhaustionReversal = family == MF_REVERSAL and subtype == MST_REV_EXHAUSTION
    bool reversalAuthorized = family == MF_REVERSAL and quality >= ENTRY_REVERSAL_MIN_QUALITY and (structuralReversal or exhaustionReversal) and (not opposingStrongTrend or structuralReversal)
    timeframeFamilyAuthorized and contextStabilityAuthorized and (continuationAuthorized or breakoutAuthorized or reversalAuthorized)
f_c06_context_winners(candidates, eligibleMask, timeframeMinutes, regime, trendStrength, structureEvent, breakDirection) =>
    int contextMask = 0
    int bull = -1
    int bear = -1
    for slot = 0 to 5
        int slotWeight = slot == 0 ? 1 : slot == 1 ? 2 : slot == 2 ? 4 : slot == 3 ? 8 : slot == 4 ? 16 : 32
        bool wasEligible = int(math.floor(eligibleMask / slotWeight)) % 2 == 1
        MainCandidate candidate = array.get(candidates, slot)
        bool contextAuthorized = wasEligible and f_r9_entry_context_authorized(timeframeMinutes, candidate.direction, candidate.family, candidate.subtype, candidate.grade, candidate.total_quality, regime, trendStrength, structureEvent, breakDirection)
        if contextAuthorized
            contextMask += slotWeight
            int current = candidate.direction == DIR_BULLISH ? bull : bear
            if current == -1 or f_c06_wins(candidate, array.get(candidates, current))
                if candidate.direction == DIR_BULLISH
                    bull := slot
                else
                    bear := slot
    int selected = bull == -1 ? bear : bear == -1 ? bull : f_c06_wins(array.get(candidates, bull), array.get(candidates, bear)) ? bull : bear
    [contextMask, bull, bear, selected]
