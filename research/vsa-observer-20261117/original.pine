                string smcFvgText = showZoneLabels ? (smcFvgItem.side == DIR_BULLISH ? "FVG ▲" : "FVG ▼") + (smcFvgItem.mitigated ? "  MITIGATED" : "  ACTIVE") + smcFvgWidthText : ""
                box smcFvgBox = box.new(left = smcFvgLeft, top = f_ticks_to_price(smcFvgItem.top_ticks, syminfo.mintick), right = time, bottom = f_ticks_to_price(smcFvgItem.bottom_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(smcFvgBaseColor, smcFvgItem.mitigated ? 65 : 8), border_width = smcFvgItem.mitigated ? 1 : 2, bgcolor = smcFvgColor, text = smcFvgText, text_color = color.new(color.white, smcFvgItem.mitigated ? 35 : 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
                array.push(smcFvgRenderBoxes, smcFvgBox)
    if showOrderBlocks and array.size(smcObs) > 0
