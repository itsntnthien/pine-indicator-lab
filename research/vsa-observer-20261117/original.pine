f_audit_number(float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")
// Queue immutable event payloads at their owning execution branch, before pending reuse.
// Only research logs consume this queue; it never controls signals or trade state.
f_audit_event(string eventName, int setupId, string fields) =>
    if (auditEnabled or researchTelemetry) and time >= auditStartTime and auditBarsWritten < auditMaximumBars
        string prefix = '{"schema":"XAU_STOP_AUDIT_V2","event":"' + eventName + '","time":' + str.tostring(time) + ',"bar":' + str.tostring(bar_index) + ',"setup_id":' + f_audit_number(setupId) + ',"historical":' + str.tostring(barstate.ishistory)
        array.push(auditEventQueue, prefix + fields + '}')
    0
f_audit_fill(int setupId, int direction, int entry, int stop, int target, int atr, int confirmEntry, bool deferred, bool dca) =>
    int risk = (entry - stop) * direction
    int spread = math.max(0, f_to_ticks(scalpSpreadPrice, syminfo.mintick))
    string fields = ',"direction":' + str.tostring(direction) + ',"entry_ticks":' + f_audit_number(entry) + ',"initial_sl_ticks":' + f_audit_number(stop) + ',"tp2_ticks":' + f_audit_number(target) + ',"signal_atr_ticks":' + f_audit_number(atr) + ',"risk_ticks":' + f_audit_number(risk)
    fields += ',"risk_atr":' + f_audit_number(not na(atr) and atr > 0 ? risk / float(atr) : na) + ',"spread_ticks":' + str.tostring(spread) + ',"spread_risk":' + f_audit_number(risk > 0 ? spread / float(risk) : na) + ',"chase_ticks":' + f_audit_number(math.max(0, (entry - confirmEntry) * direction))
    fields += ',"deferred":' + str.tostring(deferred) + ',"dca":' + str.tostring(dca) + ',"fill_atr_ticks":null,"fill_time_exact":null,"entry_bar_path_unknown":' + str.tostring(deferred)
    f_audit_event("FILL", setupId, fields)
