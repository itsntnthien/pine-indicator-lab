    else if not executeConfirmedSignalNextBar and r9CurrentEntryContextAuthorized and (not f_r9_same_reference_thesis(r9PositionActive, r9PositionDirection, r9PositionFamily, r9PositionSubtype, r9PositionThesisSlTicks, r9PositionTpTicks, r9PositionTargetPresent, r9PositionTargetType, r9PositionTargetIdentity, r9PositionRegime, currentMain.direction, currentMain.family, currentMain.subtype, currentMain.sl_ticks, currentMain.effective_tp_ticks, currentMain.selected_market_target_present, currentMain.selected_market_target_type, currentMain.selected_market_target_identity, committedRegime) or not na(r9PositionBaseScore) and currentMain.total_quality * 100 + currentMain.grade * 500 + math.min(3000, nz(currentMain.effective_rr_milli, 0)) >= r9PositionBaseScore + f_r9_campaign_upgrade_delta())
        r9EmitMainEvent := true
        auditFilledAtrTicks := scalpAtrTicks
        if r9PositionActive
            f_audit_event("CAMPAIGN_REPLACED", auditCampaignId, ',"reason":"IMMEDIATE_PRIMARY_REPLACEMENT_NOT_AN_EXIT"')
        auditCampaignId := scalpLastSetupId + 1
        f_audit_event("IMMEDIATE_MODE_UNSUPPORTED", auditCampaignId, ',"reason":"RESEARCH_REQUIRES_NEXT_BAR_MODE"')
        r9OpenedPrimaryCampaignEvent := true
        scalpLastState := SES_TRIGGERED
        scalpLastSetupId += 1
        scalpLastDirection := currentMain.direction
        scalpLastFamily := currentMain.family
        scalpLastSubtype := currentMain.subtype
        scalpLastGrade := currentMain.grade
        scalpLastQuality := currentMain.total_quality
        scalpLastEntryTicks := currentMain.entry_ticks
        scalpLastSlTicks := currentMain.sl_ticks
        scalpLastTpTicks := currentMain.effective_tp_ticks
        scalpLastRrMilli := currentMain.effective_rr_milli
        scalpLastWasDca := false
        r9PositionActive := true
        r9PositionDirection := currentMain.direction
        r9PositionFamily := currentMain.family
        r9PositionSubtype := currentMain.subtype
        r9PositionThesisSlTicks := currentMain.sl_ticks
        r9PositionTargetPresent := currentMain.selected_market_target_present
        r9PositionTargetType := currentMain.selected_market_target_type
        r9PositionTargetIdentity := currentMain.selected_market_target_identity
        r9PositionRegime := committedRegime
        r9PositionEntryTicks := currentMain.entry_ticks
        r9PositionSlTicks := currentMain.sl_ticks
        r9PositionTpTicks := currentMain.effective_tp_ticks
        r9PositionRiskTicks := math.abs(currentMain.entry_ticks - currentMain.sl_ticks)
        int r9ImmediateTp1MoveTicks = int(math.floor((r9PositionRiskTicks + scalpSpreadTicks) * SCALP_TP1_R_MILLI / 1000)) + scalpSpreadTicks
        int r9ImmediateTp1Candidate = currentMain.entry_ticks + currentMain.direction * r9ImmediateTp1MoveTicks
        bool r9ImmediateTp1InsideTarget = currentMain.direction == DIR_BULLISH ? r9ImmediateTp1Candidate < currentMain.effective_tp_ticks : r9ImmediateTp1Candidate > currentMain.effective_tp_ticks
        r9PositionTp1Ticks := enableScalpTwoStageExit and r9ImmediateTp1InsideTarget ? r9ImmediateTp1Candidate : na
        r9PositionTp1Hit := false
        r9PositionBaseScore := currentMain.total_quality * 100 + currentMain.grade * 500 + math.min(3000, nz(currentMain.effective_rr_milli, 0))
        r9PositionBestTicks := currentMain.entry_ticks
        r9PositionDcaUsed := false
        array.push(r9AcceptedSignalBars, bar_index)
        array.push(r9AcceptedSignalScores, r9PositionBaseScore)
        array.push(r9AcceptedSignalDirections, currentMain.direction)
    array.push(r9CommittedCloseTicks, r9CurrentTicks)
    if array.size(r9CommittedCloseTicks) > 240
        array.shift(r9CommittedCloseTicks)
bool mainBuyEvent = supportedTf and (scalpNextBarEntryActive and scalpNextBarEntryDirection == DIR_BULLISH or barstate.isconfirmed and (r9EmitMainEvent or r9EmitDcaEvent) and scalpLastDirection == DIR_BULLISH)
bool mainSellEvent = supportedTf and (scalpNextBarEntryActive and scalpNextBarEntryDirection == DIR_BEARISH or barstate.isconfirmed and (r9EmitMainEvent or r9EmitDcaEvent) and scalpLastDirection == DIR_BEARISH)
bool shadowBuyEvent = not barstate.isconfirmed and mainShadow.valid and mainShadow.direction == DIR_BULLISH
bool shadowSellEvent = not barstate.isconfirmed and mainShadow.valid and mainShadow.direction == DIR_BEARISH
bool r9AcceptedDisplayPulse = scalpNextBarEntryActive and barstate.isnew or scalpDeferredFillPulse or barstate.isconfirmed and (r9EmitMainEvent or r9EmitDcaEvent)
bool r9AcceptedDisplayIsDca = scalpNextBarEntryActive and (barstate.isnew or scalpDeferredFillPulse) ? scalpNextBarEntryIsDca : scalpLastWasDca
bool r9AcceptedPrimaryDisplayPulse = r9AcceptedDisplayPulse and not r9AcceptedDisplayIsDca
if r9AcceptedPrimaryDisplayPulse
    auditSignalAtrTicks := auditFilledAtrTicks
if r9AcceptedDisplayPulse
    r9SignalTooltipSequenceId += 1
if r9AcceptedPrimaryDisplayPulse
    r9DisplaySignalStatus := DSS_ACTIVE_PRIMARY
    r9DisplaySignalId := r9SignalTooltipSequenceId
    r9DisplaySignalDirection := scalpLastDirection
    r9DisplaySignalFamily := scalpLastFamily
    r9DisplaySignalSubtype := scalpLastSubtype
    r9DisplaySignalGrade := scalpLastGrade
    r9DisplaySignalQuality := scalpLastQuality
    r9DisplaySignalEntryTicks := scalpLastEntryTicks
    r9DisplaySignalInitialSlTicks := scalpLastSlTicks
    r9DisplaySignalTp2Ticks := scalpLastTpTicks
    r9DisplaySignalRrMilli := scalpLastRrMilli
    r9DisplaySignalWasDca := false
    r9DisplaySignalAmbiguousExit := false
    int r9DisplaySpreadTicks = math.max(0, f_to_ticks(scalpSpreadPrice, syminfo.mintick))
    int r9DisplayRiskTicks = not na(r9DisplaySignalEntryTicks) and not na(r9DisplaySignalInitialSlTicks) ? math.abs(r9DisplaySignalEntryTicks - r9DisplaySignalInitialSlTicks) : na
    int r9DisplayTp1MoveTicks = not na(r9DisplayRiskTicks) ? int(math.floor((r9DisplayRiskTicks + r9DisplaySpreadTicks) * SCALP_TP1_R_MILLI / 1000)) + r9DisplaySpreadTicks : na
    int r9DisplayTp1Candidate = not na(r9DisplayTp1MoveTicks) ? r9DisplaySignalEntryTicks + r9DisplaySignalDirection * r9DisplayTp1MoveTicks : na
    bool r9DisplayTp1InsideTarget = not na(r9DisplayTp1Candidate) and not na(r9DisplaySignalTp2Ticks) and (r9DisplaySignalDirection == DIR_BULLISH ? r9DisplayTp1Candidate < r9DisplaySignalTp2Ticks : r9DisplayTp1Candidate > r9DisplaySignalTp2Ticks)
    r9DisplaySignalTp1Ticks := enableScalpTwoStageExit and r9DisplayTp1InsideTarget ? r9DisplayTp1Candidate : na
if barstate.isconfirmed and scalpNextBarEntryActive and not scalpNextBarEntryIsDca and r9EntryBarOutcomeStatus != DSS_NONE
    r9DisplaySignalStatus := r9EntryBarOutcomeStatus
    r9DisplaySignalAmbiguousExit := r9EntryBarOutcomeAmbiguous
plotshape(showMainSignals and mainBuyEvent ? (scalpNextBarEntryWasDeferred ? f_ticks_to_price(scalpNextBarEntryTicks, syminfo.mintick) : low) : na, title = "C16C08 Main BUY", text = "BUY", style = shape.labelup, location = location.absolute, size = size.small, color = color.green, textcolor = color.white, display = display.all)
plotshape(showMainSignals and mainSellEvent ? (scalpNextBarEntryWasDeferred ? f_ticks_to_price(scalpNextBarEntryTicks, syminfo.mintick) : high) : na, title = "C16C08 Main SELL", text = "SELL", style = shape.labeldown, location = location.absolute, size = size.small, color = color.red, textcolor = color.white, display = display.all)
bool r9OpportunityCreationPulse = r9NextBarOpportunityActive and barstate.isnew
bool r9OpportunityInsideRetentionWindow = supportedTf and scalpSignalTooltipRetentionMs > 0 and time >= last_bar_time - scalpSignalTooltipRetentionMs
if showMainSignals and r9OpportunityCreationPulse and r9OpportunityInsideRetentionWindow
    r9OpportunitySequenceId += 1
    bool r9OpportunityBullish = r9NextBarOpportunityDirection == DIR_BULLISH
    string r9OpportunitySideText = r9OpportunityBullish ? "BUY" : "SELL"
    string r9OpportunityGradeText = r9NextBarOpportunityGrade == GRADE_A ? "A" : r9NextBarOpportunityGrade == GRADE_B ? "B" : "N/A"
    string r9OpportunityTooltip = "Re-entry opportunity #" + str.tostring(r9OpportunitySequenceId) + " - " + r9OpportunitySideText + " - " + timeframe.period + "\nType: ANALYTICAL STRUCTURAL RE-ENTRY\nFamily / subtype: " + str.tostring(r9NextBarOpportunityFamily) + "/" + str.tostring(r9NextBarOpportunitySubtype) + "\nGrade / quality: " + r9OpportunityGradeText + "/" + str.tostring(r9NextBarOpportunityQuality) + "\nEntry reference: " + f_c08_price_text(r9NextBarOpportunityEntryTicks) + "\nStructural SL: " + f_c08_price_text(r9NextBarOpportunitySlTicks) + "\nDynamic TP: " + f_c08_price_text(r9NextBarOpportunityTpTicks) + "\nNet RR: " + f_c08_rr_text(r9NextBarOpportunityRrMilli) + "\nStatus: WATCH - ACTIVE SAME-DIRECTION CAMPAIGN\nExecution: NO AUTOMATIC ADD-ON / NO MAIN ALERT"
    label r9OpportunityLabel = label.new(bar_index, r9OpportunityBullish ? low : high, r9OpportunitySideText, xloc = xloc.bar_index, yloc = yloc.price, style = r9OpportunityBullish ? label.style_label_up : label.style_label_down, color = color.new(r9OpportunityBullish ? color.green : color.red, 18), textcolor = color.white, size = size.small, tooltip = r9OpportunityTooltip)
    array.push(r9SignalTooltipLabels, r9OpportunityLabel)
    array.push(r9SignalTooltipTimes, time)
bool r9TooltipCreationPulse = scalpNextBarEntryActive and barstate.isnew or scalpDeferredFillPulse or barstate.isconfirmed and (r9EmitMainEvent or r9EmitDcaEvent)
int r9TooltipDirection = mainBuyEvent ? DIR_BULLISH : mainSellEvent ? DIR_BEARISH : DIR_NEUTRAL
bool r9TooltipFreshIdentity = r9TooltipDirection != DIR_NEUTRAL and (na(r9LastTooltipEventBar) or r9LastTooltipEventBar != bar_index or r9LastTooltipEventDirection != r9TooltipDirection)
bool r9TooltipInsideRetentionWindow = supportedTf and scalpSignalTooltipRetentionMs > 0 and time >= last_bar_time - scalpSignalTooltipRetentionMs
if showMainSignals and r9TooltipCreationPulse and r9TooltipFreshIdentity and r9TooltipInsideRetentionWindow
    bool r9TooltipIsNextBar = scalpNextBarEntryActive
    bool r9TooltipIsDca = r9TooltipIsNextBar ? scalpNextBarEntryIsDca : r9EmitDcaEvent or scalpLastWasDca
    int r9TooltipEntryTicks = r9TooltipIsNextBar ? scalpNextBarEntryTicks : scalpLastEntryTicks
    int r9TooltipSlTicks = r9TooltipIsNextBar ? scalpNextBarSlTicks : scalpLastSlTicks
    int r9TooltipTp2Ticks = r9TooltipIsNextBar ? scalpNextBarTpTicks : scalpLastTpTicks
    int r9TooltipRrMilli = r9TooltipIsNextBar ? scalpNextBarRrMilli : scalpLastRrMilli
    int r9TooltipSpreadTicks = math.max(0, f_to_ticks(scalpSpreadPrice, syminfo.mintick))
    int r9TooltipRiskTicks = not na(r9TooltipEntryTicks) and not na(r9TooltipSlTicks) ? math.abs(r9TooltipEntryTicks - r9TooltipSlTicks) : na
    int r9TooltipTp1MoveTicks = not na(r9TooltipRiskTicks) ? int(math.floor((r9TooltipRiskTicks + r9TooltipSpreadTicks) * SCALP_TP1_R_MILLI / 1000)) + r9TooltipSpreadTicks : na
    int r9TooltipTp1Ticks = not na(r9TooltipTp1MoveTicks) ? r9TooltipEntryTicks + r9TooltipDirection * r9TooltipTp1MoveTicks : na
    bool r9TooltipTp1InsideTarget = not na(r9TooltipTp1Ticks) and not na(r9TooltipTp2Ticks) and (r9TooltipDirection == DIR_BULLISH ? r9TooltipTp1Ticks < r9TooltipTp2Ticks : r9TooltipTp1Ticks > r9TooltipTp2Ticks)
    string r9TooltipKindText = r9TooltipIsDca ? "PROTECTED ADD-ON" : scalpNextBarEntryWasDeferred ? "ONE-BAR RR RETRACE" : "PRIMARY"
    string r9TooltipRrText = na(r9TooltipRrMilli) ? "N/A" : f_c08_rr_text(r9TooltipRrMilli)
    string r9TooltipTp1Text = enableScalpTwoStageExit and r9TooltipTp1InsideTarget ? f_c08_price_text(r9TooltipTp1Ticks) : "N/A"
    string r9TooltipText = "Signal #" + str.tostring(r9SignalTooltipSequenceId) + " - " + (r9TooltipDirection == DIR_BULLISH ? "BUY" : "SELL") + " - " + timeframe.period + "\nType: " + r9TooltipKindText + "\nEntry: " + f_c08_price_text(r9TooltipEntryTicks) + "\nInitial SL: " + f_c08_price_text(r9TooltipSlTicks) + "\nTP1: " + r9TooltipTp1Text + "\nTP2: " + f_c08_price_text(r9TooltipTp2Ticks) + "\nNet RR: " + r9TooltipRrText + "\nSpread allowance: " + str.tostring(scalpSpreadPrice, format.mintick) + "\nInitial status: " + (scalpNextBarEntryWasDeferred ? "LIMIT TOUCHED / ENTRY READY" : "ENTRY READY")
    float r9TooltipY = scalpNextBarEntryWasDeferred ? f_ticks_to_price(r9TooltipEntryTicks, syminfo.mintick) : r9TooltipDirection == DIR_BULLISH ? low : high
    string r9TooltipSignalText = r9TooltipDirection == DIR_BULLISH ? "BUY" : "SELL"
    label r9TooltipLabel = label.new(bar_index, r9TooltipY, r9TooltipSignalText, xloc = xloc.bar_index, yloc = yloc.price, style = r9TooltipDirection == DIR_BULLISH ? label.style_label_up : label.style_label_down, color = color.new(r9TooltipDirection == DIR_BULLISH ? color.green : color.red, 100), textcolor = color.new(color.white, 100), size = size.normal, tooltip = r9TooltipText)
    array.push(r9SignalTooltipLabels, r9TooltipLabel)
    array.push(r9SignalTooltipTimes, time)
    bool r9TooltipStartsCampaign = not r9TooltipIsDca and (r9OpenedPrimaryCampaignEvent or r9TooltipIsNextBar and (not r9PositionActive or r9PositionDirection != r9TooltipDirection))
    if r9TooltipStartsCampaign
        if not na(r9ActiveSignalTooltipLabel)
            label.set_tooltip(r9ActiveSignalTooltipLabel, r9ActiveSignalTooltipBase + "\nCurrent status: SUPERSEDED BY NEW PRIMARY")
        r9ActiveSignalTooltipLabel := r9TooltipLabel
        r9ActiveSignalTooltipBase := r9TooltipText
    r9LastTooltipEventBar := bar_index
    r9LastTooltipEventDirection := r9TooltipDirection
if barstate.isconfirmed and scalpNextBarEntryActive and not scalpNextBarEntryIsDca and r9EntryBarOutcomeStatus != DSS_NONE and not na(r9ActiveSignalTooltipLabel)
    if r9EntryBarOutcomeStatus == DSS_CLOSED_SL or r9EntryBarOutcomeStatus == DSS_CLOSED_TP2
        string r9EntryBarTerminalText = r9EntryBarOutcomeStatus == DSS_CLOSED_SL ? "CLOSED: STOP LOSS" : "CLOSED: TP2"
        r9EntryBarTerminalText += r9EntryBarOutcomeAmbiguous ? " (ENTRY BAR AMBIGUOUS; STOP-FIRST)" : ""
        label.set_tooltip(r9ActiveSignalTooltipLabel, r9ActiveSignalTooltipBase + "\nCurrent status: " + r9EntryBarTerminalText)
        r9ActiveSignalTooltipLabel := na
        r9ActiveSignalTooltipBase := ""
    else if r9EntryBarOutcomeStatus == DSS_TP1_PROTECTED
        label.set_tooltip(r9ActiveSignalTooltipLabel, r9ActiveSignalTooltipBase + "\nCurrent status: TP1 HIT / RUNNER PROTECTED\nCurrent SL: " + f_c08_price_text(r9PositionSlTicks))
if barstate.isnew and array.size(r9SignalTooltipLabels) > 0
    int r9TooltipCutoffTime = time - scalpSignalTooltipRetentionMs
    while array.size(r9SignalTooltipLabels) > 0 and array.get(r9SignalTooltipTimes, 0) < r9TooltipCutoffTime
        label r9ExpiredTooltipLabel = array.shift(r9SignalTooltipLabels)
        int r9ExpiredTooltipTime = array.shift(r9SignalTooltipTimes)
        if r9ExpiredTooltipLabel == r9ActiveSignalTooltipLabel
            array.push(r9SignalTooltipLabels, r9ExpiredTooltipLabel)
            array.push(r9SignalTooltipTimes, time)
        else
            label.delete(r9ExpiredTooltipLabel)
while array.size(r9SignalTooltipLabels) > SCALP_SIGNAL_TOOLTIP_CAPACITY
    label r9OldestTooltipLabel = array.shift(r9SignalTooltipLabels)
    int r9OldestTooltipTime = array.shift(r9SignalTooltipTimes)
    if r9OldestTooltipLabel == r9ActiveSignalTooltipLabel
        array.push(r9SignalTooltipLabels, r9OldestTooltipLabel)
        array.push(r9SignalTooltipTimes, r9OldestTooltipTime)
    else
        label.delete(r9OldestTooltipLabel)
alertcondition(enableMainAlerts and mainBuyEvent, "C16C08 Main BUY", "C16C08V1|event=MAIN|direction=BUY")
alertcondition(enableMainAlerts and mainSellEvent, "C16C08 Main SELL", "C16C08V1|event=MAIN|direction=SELL")
if enableCloudAlerts and cloudQualifiedEvent and cloudOutcomeEmit and cloudInteractionDirection == DIR_BULLISH
    alert("QUALIFIED CLOUD BULLISH", alert.freq_once_per_bar_close)
else if enableCloudAlerts and cloudQualifiedEvent and cloudOutcomeEmit and cloudInteractionDirection == DIR_BEARISH
    alert("QUALIFIED CLOUD BEARISH", alert.freq_once_per_bar_close)
else if enableRawCloudAlerts and rawBullishCloudEmit
    alert("RAW CLOUD BULLISH", alert.freq_once_per_bar_close)
else if enableRawCloudAlerts and rawBearishCloudEmit
    alert("RAW CLOUD BEARISH", alert.freq_once_per_bar_close)
f_smc_select_liquidity(array<Liquidity> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                Liquidity item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.swept) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemPrice = f_ticks_to_price(item.level_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.abs(itemPrice - price) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.swept ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_fvgs(array<FVG> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                FVG item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_obs(array<OrderBlock> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                OrderBlock item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
