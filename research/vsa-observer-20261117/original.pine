                string smcObWidthText = showZoneQuality and not na(smcRenderAtr) and smcRenderAtr > 0 ? " / " + str.tostring((smcObItem.top_ticks - smcObItem.bottom_ticks) * syminfo.mintick / smcRenderAtr, "#.##") + " ATR" : ""
                string smcObText = showZoneLabels ? (smcObItem.side == DIR_BULLISH ? "OB ▲" : "OB ▼") + (smcObItem.mitigated ? "  MITIGATED" : "  ACTIVE") + smcObWidthText : ""
                box smcObBox = box.new(left = smcObLeft, top = f_ticks_to_price(smcObItem.top_ticks, syminfo.mintick), right = time, bottom = f_ticks_to_price(smcObItem.bottom_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(smcObBaseColor, smcObItem.mitigated ? 68 : 10), border_width = smcObItem.mitigated ? 1 : 2, bgcolor = smcObColor, text = smcObText, text_color = color.new(color.white, smcObItem.mitigated ? 35 : 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
                array.push(smcObRenderBoxes, smcObBox)
    nextStructureLabel
bool smcRendererRefresh = barstate.islast and (na(smcLastRendererBar) or smcLastRendererBar != bar_index or barstate.isconfirmed)
if smcRendererRefresh
