int smcObDisplayLimit = input.int(3, "Visible order-block zones", minval = 1, maxval = 5, group = "Release / Market Structure")
bool enableMainAlerts = input.bool(true, "Enable Main Alerts", group = "Release / Alerts")
bool enableCloudAlerts = input.bool(true, "Enable Qualified Cloud Alerts", group = "Release / Alerts")
string vwMode = input.string("VSA + Wyckoff", "Scoring experiment", options = ["Baseline", "VSA", "Wyckoff", "VSA + Wyckoff"], group = "VSA / Wyckoff Research")
// Fixed first-trial rules, not optimized. Missing/zero volume is neutral, never low volume.
float vwVolumeMean = ta.sma(volume[1], 20)
float vwRangeMean = ta.sma(high[1] - low[1], 20)
float ema200 = ta.ema(close, ema200Length)
float rsi = ta.rsi(close, rsiLength)
float rsiSlope = not na(rsi[3]) ? rsi - rsi[3] : na
float inspectorAtr = ta.atr(14)
float vwValidVolumeWindow = ta.sma(not na(volume) and volume > 0 ? 1.0 : 0.0, 21)
bool vwValid = vwValidVolumeWindow == 1 and not na(vwVolumeMean) and vwVolumeMean > 0 and not na(vwRangeMean) and vwRangeMean > 0 and high > low
float vwRelativeVolume = vwValid ? volume / vwVolumeMean : na
float vwRelativeRange = vwValid ? (high - low) / vwRangeMean : na
float vwCloseLocation = vwValid ? (close - low) / (high - low) : na
bool vwHighVolume = vwValid and vwRelativeVolume >= 1.5
bool vwLowVolume = vwValid and vwRelativeVolume <= 0.7
bool vwNarrow = vwValid and vwRelativeRange <= 0.8
bool vwDemand = vwHighVolume and vwRelativeRange >= 1.2 and close > close[1] and vwCloseLocation >= 0.7
bool vwSupply = vwHighVolume and vwRelativeRange >= 1.2 and close < close[1] and vwCloseLocation <= 0.3
// ponytail: bar-pattern proxies, not proof of institutional absorption; validate on native feed.
bool vwAbsorbBuy = vwHighVolume and vwNarrow and vwCloseLocation >= 0.65
bool vwAbsorbSell = vwHighVolume and vwNarrow and vwCloseLocation <= 0.35
bool vwNoSupply = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close < close[1] and vwCloseLocation >= 0.5
bool vwNoDemand = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close > close[1] and vwCloseLocation <= 0.5
int vwDirection = (vwDemand or vwAbsorbBuy or vwNoSupply ? 1 : 0) - (vwSupply or vwAbsorbSell or vwNoDemand ? 1 : 0)
f_vw_adjustment(int direction, int family, int wyDirection, bool wyFresh) =>
    int vsa = vwMode == "VSA" or vwMode == "VSA + Wyckoff" ? (vwValid ? math.max(-10, math.min(10, 10 * direction * vwDirection - (family == MF_BREAKOUT and vwLowVolume ? 5 : 0))) : 0) : 0
    int wy = vwMode == "Wyckoff" or vwMode == "VSA + Wyckoff" ? (family == MF_CONTINUATION ? 0 : direction * wyDirection * (family == MF_REVERSAL and wyFresh ? 10 : 5)) : 0
    math.max(-15, math.min(15, vsa + wy))
f_ema_rsi_policy(direction, family, baseQuality, atrValue, emaValue, emaLagValue, rsiValue, rsiSlopeValue, emaPolicy, rsiPolicy) =>
    bool emaReady = not na(emaValue) and not na(emaLagValue) and not na(atrValue) and atrValue > 0
    float emaDistanceAtr = emaReady ? (close - emaValue) / atrValue : na
    float emaSlopeAtr = emaReady ? (emaValue - emaLagValue) / atrValue : na
    bool emaTooExtended = emaReady and math.abs(emaDistanceAtr) > 2.5
    bool emaFlat = emaReady and math.abs(emaSlopeAtr) < 0.05
    bool emaAligned = emaReady and not emaTooExtended and not emaFlat and (direction == DIR_BULLISH ? emaDistanceAtr >= 0.15 and emaSlopeAtr >= 0.05 : emaDistanceAtr <= -0.15 and emaSlopeAtr <= -0.05)
    bool emaOpposed = emaReady and not emaTooExtended and not emaFlat and (direction == DIR_BULLISH ? emaDistanceAtr <= -0.15 : emaDistanceAtr >= 0.15)
    bool emaEnabled = emaPolicy == "Soft" or emaPolicy == "Hard"
    int emaAdjustment = emaEnabled and family != MF_REVERSAL ? emaAligned ? 8 : emaOpposed ? -8 : 0 : 0
    bool rsiReady = not na(rsiValue) and not na(rsiSlopeValue)
    bool rsiBullMomentum = rsiReady and rsiValue >= 52 and rsiSlopeValue >= 0
    bool rsiBearMomentum = rsiReady and rsiValue <= 48 and rsiSlopeValue <= 0
    bool rsiBullReversal = rsiReady and rsiValue <= 30
    bool rsiBearReversal = rsiReady and rsiValue >= 70
    bool rsiEnabled = rsiPolicy == "Soft" or rsiPolicy == "Hard"
    int rsiAdjustment = rsiEnabled ? family == MF_REVERSAL ? (direction == DIR_BULLISH and rsiBullReversal or direction == DIR_BEARISH and rsiBearReversal ? 6 : 0) : direction == DIR_BULLISH ? rsiBullMomentum ? 6 : rsiBearMomentum ? -6 : 0 : rsiBearMomentum ? 6 : rsiBullMomentum ? -6 : 0 : 0
    int policyAdjustment = emaAdjustment + rsiAdjustment
    int policyQuality = math.max(0, math.min(100, baseQuality + policyAdjustment))
    bool hardConflict = (emaPolicy == "Hard" and family != MF_REVERSAL and emaOpposed) or (rsiPolicy == "Hard" and (direction == DIR_BULLISH ? rsiBearMomentum : rsiBullMomentum))
    int stateMask = (emaReady ? 1 : 0) + (emaAligned ? 2 : 0) + (emaOpposed ? 4 : 0) + (emaFlat ? 64 : 0) + (emaTooExtended ? 128 : 0) + (rsiReady ? 8 : 0) + (rsiBullMomentum ? 16 : 0) + (rsiBearMomentum ? 32 : 0)
    [emaAdjustment, rsiAdjustment, policyAdjustment, policyQuality, stateMask, emaDistanceAtr, emaSlopeAtr, hardConflict]
f_smc_inducement_value(int field, int trend, bool newLow, bool newHigh, int priorLowTicks, int priorHighTicks, int newLowTicks, int newHighTicks, int newLowTime, int newHighTime, int currentTicks, int currentTime, int currentSide) =>
    bool bullInducement = trend == DIR_BULLISH and newLow and not na(priorLowTicks) and not na(newLowTicks) and newLowTicks > priorLowTicks
    bool bearInducement = trend == DIR_BEARISH and newHigh and not na(priorHighTicks) and not na(newHighTicks) and newHighTicks < priorHighTicks
    field == 0 ? bullInducement ? newLowTicks : bearInducement ? newHighTicks : currentTicks : field == 1 ? bullInducement ? newLowTime : bearInducement ? newHighTime : currentTime : bullInducement or bearInducement ? (bullInducement ? DIR_BULLISH : DIR_BEARISH) : currentSide
f_observer_session(string timeframeText) =>
    bool london = not na(time(timeframeText, "0800-1700:23456", "Europe/London"))
    bool newYork = not na(time(timeframeText, "0800-1700:23456", "America/New_York"))
    london and newYork ? "OVERLAP" : london ? "LONDON" : newYork ? "NEW YORK" : "OUTSIDE"
