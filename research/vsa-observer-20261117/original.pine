    smcLastRendererBar := bar_index
color regimeColor = committedRegime == REGIME_UPTREND ? color.new(color.green, 90) : committedRegime == REGIME_DOWNTREND ? color.new(color.red, 90) : committedRegime == REGIME_TRANSITION ? color.new(color.gray, 88) : color.new(color.orange, 93)
var table inspectorTable = table.new(position.top_right, 2, 32, border_width = 1)
f_ar_base_effect(family, direction, context, freshEvent, eventSubtype) =>
    bool coherent = freshEvent == 0 and eventSubtype == 0 or freshEvent == 1 and (eventSubtype == 1 or eventSubtype == 2) or (freshEvent == 2 or freshEvent == 3) and eventSubtype == 0
    bool aa = context == (direction == 1 ? AR_CONTEXT_BULL_ACCEPT : AR_CONTEXT_BEAR_ACCEPT)
    bool ar = context == (direction == 1 ? AR_CONTEXT_BULL_REJECT : AR_CONTEXT_BEAR_REJECT)
    bool oppositeAcceptance = context == (direction == 1 ? AR_CONTEXT_BEAR_ACCEPT : AR_CONTEXT_BULL_ACCEPT)
    bool oppositeRejection = context == (direction == 1 ? AR_CONTEXT_BEAR_REJECT : AR_CONTEXT_BULL_REJECT)
    not coherent or context == AR_CONTEXT_UNAVAILABLE or context == AR_CONTEXT_NEUTRAL or family == MF_CONTINUATION ? AR_NEUTRAL : family == MF_BREAKOUT ? (aa and freshEvent == 1 ? AR_SUPPORT_STRONG : aa and freshEvent == 0 ? AR_SUPPORT : oppositeRejection and (freshEvent == 2 or freshEvent == 3) ? AR_CONFLICT_STRONG : AR_NEUTRAL) : ar and (freshEvent == 2 or freshEvent == 3) ? AR_SUPPORT_STRONG : oppositeAcceptance and (freshEvent == 0 or freshEvent == 1) ? AR_CONFLICT_STRONG : AR_NEUTRAL
var int acceptanceFsm = AR_IDLE
var int acceptRejectContext = AR_CONTEXT_UNAVAILABLE
var string acceptRejectReferenceId = "-1:0:-1:-1"
var int acceptRejectDirection = 0
var int acceptRejectLevelTicks = na
var int acceptRejectBreakSourceBar = -1
var int acceptRejectConfirmBar = -1
var bool pendingFailureEmitted = false
var bool excursionEmitted = false
var AcceptRejectFrame acceptRejectFrame = AcceptRejectFrame.new(-1, false, 1, "-1:0:-1:-1", 0, "-1:0:-1:-1:-1", 0, false, 0, false, 0, false, -1, -1, 0, 0)
if barstate.isconfirmed
    int acceptanceEvent = 0
    int rejectionEvent = 0
    int eventSourceBar = -1
    int eventConfirmBar = -1
    MainCandidate arCandidate = MainCandidate.new(-1, na, na, 0, 0, na, na, na, na, na, na, na, na, na, na, false, false, false, na, 0, 0, 0, 0, 0, 0, 0, -1, DIR_NEUTRAL, na, na, "-1:0:-1:-1", 0)
    for arSlot = 2 to (array.size(mainCandidates) >= 4 ? 3 : na)
        MainCandidate candidateReader = array.get(mainCandidates, arSlot)
        if candidateReader.family == MF_BREAKOUT and candidateReader.reference_id != "-1:0:-1:-1"
            arCandidate := candidateReader
    bool arValid = arCandidate.slot >= 0 and not na(arCandidate.reference_level_ticks) and (arCandidate.reference_direction == 1 or arCandidate.reference_direction == -1)
    if not useAcceptanceRejectionInSignals
        acceptanceFsm := AR_IDLE
        acceptRejectContext := AR_CONTEXT_NEUTRAL
    else if not arValid
        acceptanceFsm := acceptanceFsm == AR_PENDING or acceptanceFsm == AR_REJECTED ? AR_TERMINAL : acceptanceFsm
        acceptRejectContext := AR_CONTEXT_UNAVAILABLE
    else if arCandidate.reference_id != acceptRejectReferenceId and arCandidate.source_bar_index == bar_index and committedRegime >= 1 and committedRegime <= 6
        acceptRejectReferenceId := arCandidate.reference_id
        acceptRejectDirection := arCandidate.reference_direction
        acceptRejectLevelTicks := arCandidate.reference_level_ticks
        acceptRejectBreakSourceBar := bar_index
        acceptanceFsm := AR_PENDING
        pendingFailureEmitted := false
        excursionEmitted := false
        acceptRejectContext := AR_CONTEXT_NEUTRAL
    else
        int arOffset = bar_index - acceptRejectBreakSourceBar
        int arClose = f_to_ticks(close, syminfo.mintick)
        int arHigh = f_to_ticks(high, syminfo.mintick)
        int arLow = f_to_ticks(low, syminfo.mintick)
        if acceptanceFsm == AR_ACCEPTED
            bool loss = acceptRejectDirection == 1 ? arClose <= acceptRejectLevelTicks : arClose >= acceptRejectLevelTicks
            if loss
                acceptanceFsm := AR_FAILED
                rejectionEvent := AR_REJECT_FAILED_ACCEPTANCE
                eventSourceBar := acceptRejectConfirmBar
                eventConfirmBar := bar_index
                acceptRejectContext := acceptRejectDirection == 1 ? AR_CONTEXT_BULL_REJECT : AR_CONTEXT_BEAR_REJECT
        else if (acceptanceFsm == AR_PENDING or acceptanceFsm == AR_REJECTED) and arOffset >= 1 and arOffset <= 3
            bool strictBeyond = acceptRejectDirection == 1 ? arClose > acceptRejectLevelTicks : arClose < acceptRejectLevelTicks
            bool retestTouch = acceptRejectDirection == 1 ? arLow <= acceptRejectLevelTicks : arHigh >= acceptRejectLevelTicks
            if retestTouch and strictBeyond
                acceptanceEvent := AR_ACCEPT_RETEST
            else if arOffset == 1 and acceptanceFsm == AR_PENDING and strictBeyond
                acceptanceEvent := AR_ACCEPT_DIRECT
            else
                bool atOrInside = acceptRejectDirection == 1 ? arClose <= acceptRejectLevelTicks : arClose >= acceptRejectLevelTicks
                bool excursion = (acceptRejectDirection == 1 ? arHigh > acceptRejectLevelTicks : arLow < acceptRejectLevelTicks) and atOrInside
                if arOffset == 1 and acceptanceFsm == AR_PENDING and atOrInside and not pendingFailureEmitted
                    rejectionEvent := AR_REJECT_PENDING_FAILURE
                    pendingFailureEmitted := true
                else if excursion and not excursionEmitted
                    rejectionEvent := AR_REJECT_EXCURSION
                    excursionEmitted := true
                if rejectionEvent != AR_REJECT_NONE
                    acceptanceFsm := AR_REJECTED
                    acceptRejectContext := acceptRejectDirection == 1 ? AR_CONTEXT_BULL_REJECT : AR_CONTEXT_BEAR_REJECT
            if acceptanceEvent != AR_ACCEPT_NONE
                acceptanceFsm := AR_ACCEPTED
                acceptRejectConfirmBar := bar_index
                eventSourceBar := acceptRejectBreakSourceBar
                eventConfirmBar := bar_index
                acceptRejectContext := acceptRejectDirection == 1 ? AR_CONTEXT_BULL_ACCEPT : AR_CONTEXT_BEAR_ACCEPT
            else if rejectionEvent != AR_REJECT_NONE
                eventSourceBar := acceptRejectBreakSourceBar
                eventConfirmBar := bar_index
            if arOffset == 3 and acceptanceEvent == AR_ACCEPT_NONE
                acceptanceFsm := AR_TERMINAL
    int freshEvent = acceptanceEvent != 0 ? 1 : rejectionEvent == 3 ? 3 : rejectionEvent != 0 ? 2 : 0
    bool wyckoffOverlap = springFresh or upthrustFresh
    int effectSubtype = acceptanceEvent != 0 ? acceptanceEvent : 0
    int baseEffectBuy = f_ar_base_effect(MF_BREAKOUT, 1, acceptRejectContext, freshEvent, effectSubtype)
    int baseEffectSell = f_ar_base_effect(MF_BREAKOUT, -1, acceptRejectContext, freshEvent, effectSubtype)
    int finalEffectBuy = wyckoffOverlap ? AR_NEUTRAL : baseEffectBuy
    int finalEffectSell = wyckoffOverlap ? AR_NEUTRAL : baseEffectSell
    acceptRejectFrame := AcceptRejectFrame.new(acceptRejectContext, arValid and useAcceptanceRejectionInSignals, arValid ? 0 : 1, acceptRejectReferenceId, acceptRejectDirection, acceptRejectReferenceId + ":" + str.tostring(acceptRejectBreakSourceBar), acceptanceFsm, acceptanceEvent != 0, acceptanceEvent, rejectionEvent != 0, rejectionEvent, freshEvent != 0, eventSourceBar, eventConfirmBar, finalEffectBuy, finalEffectSell)
f_render_legacy_inspector() =>
    string dash = "—"
    bool r9AcceptedSignalDisplayAvailable = r9DisplaySignalId > 0
    bool scalpDisplayAvailable = not r9AcceptedSignalDisplayAvailable and scalpLastSetupId > 0
    string scalpDirectionText = scalpLastDirection == DIR_BULLISH ? "BUY" : scalpLastDirection == DIR_BEARISH ? "SELL" : dash
    string scalpStateText = scalpLastState == SES_WAIT_RETEST ? "WAIT " + scalpDirectionText : scalpLastState == SES_CONFIRMED_NEXT_BAR ? (scalpLastWasDca ? "CONFIRMED ADD-ON " : "CONFIRMED ") + scalpDirectionText : scalpLastState == SES_TRIGGERED ? (scalpLastWasDca ? "ADD-ON " : "") + scalpDirectionText + " READY" : scalpLastState == SES_EXPIRED ? "EXPIRED" : scalpLastState == SES_CANCELLED ? "CANCELLED" : "NONE"
    string r9DisplayDirectionText = r9DisplaySignalDirection == DIR_BULLISH ? "BUY" : r9DisplaySignalDirection == DIR_BEARISH ? "SELL" : dash
    string r9DisplayAmbiguousText = r9DisplaySignalAmbiguousExit ? " (AMBIGUOUS)" : ""
    string r9DisplayStatusText = r9DisplaySignalStatus == DSS_ACTIVE_PRIMARY ? "ACTIVE " + r9DisplayDirectionText : r9DisplaySignalStatus == DSS_TP1_PROTECTED ? "TP1 PROTECTED " + r9DisplayDirectionText : r9DisplaySignalStatus == DSS_CLOSED_SL ? "CLOSED SL" + r9DisplayAmbiguousText + " " + r9DisplayDirectionText : r9DisplaySignalStatus == DSS_CLOSED_BE ? "CLOSED BE" + r9DisplayAmbiguousText + " " + r9DisplayDirectionText : r9DisplaySignalStatus == DSS_CLOSED_TP2 ? "CLOSED TP2 " + r9DisplayDirectionText : "NONE"
    string scalpZoneSourceText = scalpSetup.zone_source == SEZ_FVG ? "FVG" : scalpSetup.zone_source == SEZ_ORDER_BLOCK ? "OB" : scalpSetup.zone_source == SEZ_BREAK_REFERENCE ? "BREAK RETEST" : scalpSetup.zone_source == SEZ_POLARITY_CLOUD ? "CLOUD" : scalpSetup.zone_source == SEZ_BASIS_FALLBACK ? "BASIS" : scalpSetup.zone_source == SEZ_LIQUIDITY_SWEEP ? "LIQ SWEEP" : dash
    string mainText = r9AcceptedSignalDisplayAvailable ? r9DisplayStatusText + " #" + str.tostring(r9DisplaySignalId) : scalpDisplayAvailable ? scalpStateText + " #" + str.tostring(scalpLastSetupId) : currentC07Inspector.main_valid ? (currentC07Inspector.direction == DIR_BULLISH ? "BUY" : "SELL") : "NONE"
    if not supportedTf
        mainText := smcObservationMode ? "OBSERVATION " + timeframe.period + " / SIGNALS OFF" : "UNSUPPORTED CHART"
    string typeText = r9AcceptedSignalDisplayAvailable ? str.tostring(r9DisplaySignalFamily) + "/" + str.tostring(r9DisplaySignalSubtype) + (r9DisplaySignalWasDca ? " ADD-ON" : "") : scalpDisplayAvailable ? str.tostring(scalpLastFamily) + "/" + str.tostring(scalpLastSubtype) + "" : currentC07Inspector.main_valid ? str.tostring(currentC07Inspector.family) + "/" + str.tostring(currentC07Inspector.subtype) : dash
    string gradeText = r9AcceptedSignalDisplayAvailable ? (r9DisplaySignalGrade == GRADE_A ? "A/" : "B/") + str.tostring(r9DisplaySignalQuality) : scalpDisplayAvailable ? (scalpLastGrade == GRADE_A ? "A/" : "B/") + str.tostring(scalpLastQuality) : currentC07Inspector.main_valid ? (currentC07Inspector.grade == GRADE_A ? "A/" : "B/") + str.tostring(currentC07Inspector.total_quality) : dash
    string htfText = officialBias == BIAS_BULLISH ? "BULL" : officialBias == BIAS_BEARISH ? "BEAR" : officialBias == BIAS_CONFLICT ? "CONFLICT" : "NEUTRAL"
    string regimeHtfText = str.tostring(committedRegime) + " / " + htfText + " / " + macroContextText
    string cloudText = currentC07Inspector.cloud_relation == CR_NOT_APPLICABLE ? "N/A" : currentC07Inspector.cloud_relation == CR_NO_TEST ? "NO TEST" : currentC07Inspector.cloud_relation == CR_ALIGNED ? "ALIGNED" : "OPPOSED"
    string scalpCancelText = scalpSetup.cancel_reason == SCR_EXPIRED ? "EXPIRED" : scalpSetup.cancel_reason == SCR_INVALIDATED ? "INVALIDATED" : scalpSetup.cancel_reason == SCR_TARGET_REACHED ? "TARGET PASSED" : scalpSetup.cancel_reason == SCR_CONTEXT_CHANGED ? "CONTEXT" : scalpSetup.cancel_reason == SCR_RR_TOO_LOW ? "RR LOW" : scalpSetup.cancel_reason == SCR_CHASING ? "NO CHASE" : scalpSetup.cancel_reason == SCR_DENSITY ? "DENSITY" : scalpSetup.cancel_reason == SCR_ACTIVE_CAMPAIGN ? "CAMPAIGN ACTIVE" : scalpSetup.cancel_reason == SCR_SUPERSEDED ? "BETTER THESIS" : dash
    int displayedRiskTicks = r9AcceptedSignalDisplayAvailable and not na(r9DisplaySignalEntryTicks) and not na(r9DisplaySignalInitialSlTicks) ? math.abs(r9DisplaySignalEntryTicks - r9DisplaySignalInitialSlTicks) : na
    string displayedRiskAtrText = not na(auditSignalAtrTicks) and auditSignalAtrTicks > 0 and not na(displayedRiskTicks) ? " / " + str.tostring(displayedRiskTicks / float(auditSignalAtrTicks), "#.##") + " SIGNAL ATR" : " / SIGNAL ATR N/A"
    string r9DisplayRiskText = r9DisplaySignalStatus == DSS_TP1_PROTECTED ? "TP1 50% / RUNNER PROTECTED" : r9DisplaySignalStatus == DSS_CLOSED_SL ? "CLOSED: STOP LOSS" + (r9DisplaySignalAmbiguousExit ? " / STOP-FIRST" : "") : r9DisplaySignalStatus == DSS_CLOSED_BE ? "CLOSED: PROTECTED STOP / BE" + (r9DisplaySignalAmbiguousExit ? " / STOP-FIRST" : "") : r9DisplaySignalStatus == DSS_CLOSED_TP2 ? "CLOSED: TP2" : "ACTIVE / NET RR VALID" + displayedRiskAtrText
    string riskText = r9AcceptedSignalDisplayAvailable ? r9DisplayRiskText : scalpLastState == SES_WAIT_RETEST ? "WAIT RETEST" : scalpLastWasDca and (scalpLastState == SES_CONFIRMED_NEXT_BAR or scalpLastState == SES_TRIGGERED) ? "ADD-ON RISK " + str.tostring(DCA_ADD_ON_RISK_SHARE_MILLI / 10.0) + "%" : scalpLastState == SES_CONFIRMED_NEXT_BAR ? "NEXT BAR READY" : scalpLastState == SES_TRIGGERED and r9PositionActive and r9PositionTp1Hit ? "TP1 50% / RUNNER PROTECTED" : scalpLastState == SES_TRIGGERED ? "NET RR VALID" : scalpLastState == SES_CANCELLED or scalpLastState == SES_EXPIRED ? scalpCancelText : currentC07Inspector.risk_valid ? "VALID" : "INVALID(" + str.tostring(currentC07Inspector.risk_reason) + ")"
    string entrySlText = r9AcceptedSignalDisplayAvailable ? f_c08_price_text(r9DisplaySignalEntryTicks) + " / " + f_c08_price_text(r9DisplaySignalInitialSlTicks) : scalpLastState == SES_WAIT_RETEST ? f_c08_price_text(scalpSetup.ideal_entry_ticks) + " / " + f_c08_price_text(scalpSetup.invalidation_ticks) : scalpLastState == SES_CONFIRMED_NEXT_BAR or scalpLastState == SES_TRIGGERED ? f_c08_price_text(scalpLastEntryTicks) + " / " + f_c08_price_text(scalpLastSlTicks) : currentC07Inspector.risk_valid ? f_c08_price_text(currentC07Inspector.entry_ticks) + " / " + f_c08_price_text(currentC07Inspector.sl_ticks) : dash
    string r9DisplayTpRrText = not na(r9DisplaySignalTp1Ticks) ? "TP1 " + f_c08_price_text(r9DisplaySignalTp1Ticks) + " → TP2 " + f_c08_price_text(r9DisplaySignalTp2Ticks) + " / " + f_c08_rr_text(r9DisplaySignalRrMilli) : "TP2 " + f_c08_price_text(r9DisplaySignalTp2Ticks) + " / " + f_c08_rr_text(r9DisplaySignalRrMilli)
    string tpRrText = r9AcceptedSignalDisplayAvailable ? r9DisplayTpRrText : scalpLastState == SES_WAIT_RETEST ? f_c08_price_text(scalpSetup.target_ticks) + " / PENDING" : scalpLastState == SES_TRIGGERED and r9PositionActive and not na(r9PositionTp1Ticks) ? "TP1 " + f_c08_price_text(r9PositionTp1Ticks) + " → TP2 " + f_c08_price_text(r9PositionTpTicks) : scalpLastState == SES_CONFIRMED_NEXT_BAR or scalpLastState == SES_TRIGGERED ? f_c08_price_text(scalpLastTpTicks) + " / " + f_c08_rr_text(scalpLastRrMilli) : currentC07Inspector.risk_valid ? f_c08_price_text(currentC07Inspector.tp_ticks) + " / " + f_c08_rr_text(currentC07Inspector.rr_milli) : dash
    string stopSourceText = currentC07Inspector.stop_source == SS_THESIS_ANCHOR ? "THESIS ANCHOR" : currentC07Inspector.stop_source == SS_THESIS_BUFFER ? "THESIS + BUFFER" : currentC07Inspector.stop_source == SS_MINIMUM_ATR_FLOOR ? "MIN ATR FLOOR" : currentC07Inspector.stop_source == SS_ATR_FALLBACK ? "ATR FALLBACK" : dash
    string sourceText = currentC07Inspector.main_valid ? str.tostring(currentC07Inspector.source_bar_index) + "/" + str.tostring(currentC07Inspector.commit_bar_index) + " / STOP " + stopSourceText : dash
    string cloudSignalText = cloudQualifiedEvent ? (cloudInteractionDirection == DIR_BULLISH ? "QUALIFIED BUY" : "QUALIFIED SELL") : cloudRejectedEvent ? "REJECTED" : "NONE"
    string cloudSetupText = cloudInteractionSetup == CLOUD_SETUP_CONTINUATION ? "CONTINUATION" : cloudInteractionSetup == CLOUD_SETUP_RANGE_REJECTION ? "RANGE_REJECTION" : cloudInteractionSetup == CLOUD_SETUP_BREAKOUT ? "BREAKOUT" : dash
    string polarityText = cloudMicroBias == CLOUD_MICRO_BULLISH ? "BULLISH_MICRO_BIAS" : cloudMicroBias == CLOUD_MICRO_BEARISH ? "BEARISH_MICRO_BIAS" : "NEUTRAL_OR_CHOPPY"
    string familyText = cloudInteractionFamily == CLOUD_FAMILY_POLARITY ? "POLARITY" : cloudInteractionFamily == CLOUD_FAMILY_UPPER ? "UPPER_CONTEXT" : cloudInteractionFamily == CLOUD_FAMILY_LOWER ? "LOWER_CONTEXT" : dash
    float inspectorEmaDistanceAtr = not na(ema200) and not na(inspectorAtr) and inspectorAtr > 0 ? (close - ema200) / inspectorAtr : na
    float inspectorEmaSlopeAtr = not na(ema200) and not na(ema200[ema200SlopeLookback]) and not na(inspectorAtr) and inspectorAtr > 0 ? (ema200 - ema200[ema200SlopeLookback]) / inspectorAtr : na
    string ema200StateText = na(ema200) or na(inspectorEmaDistanceAtr) or na(inspectorEmaSlopeAtr) ? "UNAVAILABLE" : math.abs(inspectorEmaDistanceAtr) > 2.5 ? "TOO EXTENDED" : math.abs(inspectorEmaSlopeAtr) < 0.05 ? "FLAT" : close >= ema200 and inspectorEmaSlopeAtr >= 0.05 ? "ABOVE_ALIGNED" : close < ema200 and inspectorEmaSlopeAtr <= -0.05 ? "BELOW_ALIGNED" : close >= ema200 ? "ABOVE" : "BELOW"
    string rsiStateText = na(rsi) or na(rsiSlope) ? "UNAVAILABLE" : rsi >= 70 ? "BULL EXHAUSTION CANDIDATE" : rsi <= 30 ? "BEAR EXHAUSTION CANDIDATE" : rsi >= 52 and rsiSlope >= 0 ? "BULL MOMENTUM" : rsi <= 48 and rsiSlope <= 0 ? "BEAR MOMENTUM" : "NEUTRAL"
    string policyText = ema200FilterPolicy + " / " + rsiFilterPolicy
    int inspectorSlot = currentC07Inspector.main_valid and currentC07Inspector.source_slot >= 0 and currentC07Inspector.source_slot < array.size(policyQualityBySlot) ? currentC07Inspector.source_slot : -1
    int inspectorPolicyQuality = inspectorSlot >= 0 ? array.get(policyQualityBySlot, inspectorSlot) : na
    int inspectorPolicyAdjustment = inspectorSlot >= 0 ? nz(array.get(ema200AdjustmentBySlot, inspectorSlot), 0) + nz(array.get(rsiAdjustmentBySlot, inspectorSlot), 0) : na
    string observerSession = f_observer_session(timeframe.period)
    string observerInducement = showInducement and not na(smcLatestInducementTicks) ? (smcLatestInducementSide == DIR_BULLISH ? "BULL IDM" : "BEAR IDM") + " / " + f_c08_price_text(smcLatestInducementTicks) : "N/A"
    table.cell(inspectorTable, 0, 0, "Main")
    table.cell(inspectorTable, 1, 0, mainText)
    table.cell(inspectorTable, 0, 1, "Type")
    table.cell(inspectorTable, 1, 1, typeText)
    table.cell(inspectorTable, 0, 2, "Grade / Q")
    table.cell(inspectorTable, 1, 2, gradeText)
    table.cell(inspectorTable, 0, 3, "Regime / HTF")
    table.cell(inspectorTable, 1, 3, regimeHtfText)
    table.cell(inspectorTable, 0, 4, "Cloud")
    table.cell(inspectorTable, 1, 4, cloudText)
    table.cell(inspectorTable, 0, 5, "Risk")
    table.cell(inspectorTable, 1, 5, riskText)
    table.cell(inspectorTable, 0, 6, "Entry / SL")
    table.cell(inspectorTable, 1, 6, entrySlText)
    table.cell(inspectorTable, 0, 7, "TP / RR")
    table.cell(inspectorTable, 1, 7, tpRrText)
    if showInspectorDiagnostics
        table.cell(inspectorTable, 0, 8, "Source")
        table.cell(inspectorTable, 1, 8, sourceText)
        table.cell(inspectorTable, 0, 9, "Cloud Signal")
        table.cell(inspectorTable, 1, 9, cloudSignalText)
        table.cell(inspectorTable, 0, 10, "Setup")
        table.cell(inspectorTable, 1, 10, cloudSetupText)
        table.cell(inspectorTable, 0, 11, "Score")
        table.cell(inspectorTable, 1, 11, str.tostring(cloudSignalScore))
        table.cell(inspectorTable, 0, 12, "Polarity")
        table.cell(inspectorTable, 1, 12, polarityText)
        table.cell(inspectorTable, 0, 13, "Cloud Family")
        table.cell(inspectorTable, 1, 13, familyText)
        table.cell(inspectorTable, 0, 14, "Interaction State")
        table.cell(inspectorTable, 1, 14, str.tostring(cloudInteractionState) + "/" + str.tostring(cloudInteractionEpoch))
        table.cell(inspectorTable, 0, 15, "Reject Reason")
        table.cell(inspectorTable, 1, 15, showCloudRejectReason ? cloudRejectReason : dash)
        table.cell(inspectorTable, 0, 16, "Trend Strength Score")
        table.cell(inspectorTable, 1, 16, str.tostring(trendStrengthScore))
        table.cell(inspectorTable, 0, 17, "Trend Strength Normalized")
        table.cell(inspectorTable, 1, 17, str.tostring(trendStrengthNorm))
        table.cell(inspectorTable, 0, 18, "Polarity Target Half Width")
        table.cell(inspectorTable, 1, 18, str.tostring(polarityTargetHalfWidth))
        table.cell(inspectorTable, 0, 19, "Polarity Target Width Ratio")
        table.cell(inspectorTable, 1, 19, str.tostring(polarityHalfWidthRatio))
        table.cell(inspectorTable, 0, 20, "Polarity Display Half Width")
        table.cell(inspectorTable, 1, 20, str.tostring(activeDisplayHalfWidth))
        table.cell(inspectorTable, 0, 21, "Polarity Display Width Ratio")
        table.cell(inspectorTable, 1, 21, str.tostring(polarityDisplayWidthRatio))
        table.cell(inspectorTable, 0, 22, "Polarity Target Valid")
        table.cell(inspectorTable, 1, 22, str.tostring(polarityTargetValid))
        table.cell(inspectorTable, 0, 23, "Polarity Display Valid")
        table.cell(inspectorTable, 1, 23, str.tostring(polarityDisplayValid))
        table.cell(inspectorTable, 0, 24, "Polarity Hidden Reason")
        table.cell(inspectorTable, 1, 24, polarityHiddenReason)
        table.cell(inspectorTable, 0, 25, "EMA200")
        table.cell(inspectorTable, 1, 25, ema200StateText + " / " + (na(ema200) ? dash : str.tostring(ema200, format.mintick)) + " / " + (na(inspectorEmaDistanceAtr) ? "N/A" : str.tostring(inspectorEmaDistanceAtr, "#.##") + " ATR"))
        table.cell(inspectorTable, 0, 26, "RSI")
        table.cell(inspectorTable, 1, 26, na(rsi) ? dash : str.tostring(rsi, "#.##") + " / " + rsiStateText)
        table.cell(inspectorTable, 0, 27, "Filter policy")
        table.cell(inspectorTable, 1, 27, policyText)
        table.cell(inspectorTable, 0, 28, "Policy mode")
        table.cell(inspectorTable, 1, 28, ema200FilterPolicy == "Soft" or rsiFilterPolicy == "Soft" ? "SOFT DEFAULT" : "LEGACY/OBSERVE")
        table.cell(inspectorTable, 0, 29, "Policy quality / adj")
        table.cell(inspectorTable, 1, 29, na(inspectorPolicyQuality) ? dash : str.tostring(inspectorPolicyQuality) + " / " + str.tostring(inspectorPolicyAdjustment))
        table.cell(inspectorTable, 0, 30, "EMA slope / RSI slope")
        table.cell(inspectorTable, 1, 30, (na(inspectorEmaSlopeAtr) ? "N/A" : str.tostring(inspectorEmaSlopeAtr, "#.##") + " ATR") + " / " + (na(rsiSlope) ? "N/A" : str.tostring(rsiSlope, "#.##")) + " / " + observerInducement)
        table.cell(inspectorTable, 0, 31, "TF / Session")
        table.cell(inspectorTable, 1, 31, (supportedTf ? "TRADE" : smcObservationMode ? "OBSERVE" : "UNSUPPORTED") + " / " + observerSession)
    else
        table.clear(inspectorTable, 0, 8, 1, 31)
if barstate.islast
    if showInspector
        f_render_legacy_inspector()
    else
        table.clear(inspectorTable, 0, 0, 1, 31)

// Observation only. These bar-close records are not an exact intrabar fill ledger.
// Source SHA and configuration must be bound by the external collection manifest.
if (auditEnabled or researchTelemetry) and barstate.isconfirmed and time >= auditStartTime and auditBarsWritten < auditMaximumBars
    if auditBarsWritten == 0
        log.info('{"schema":"XAU_STOP_AUDIT_V2","event":"CONTEXT","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","tick_size":' + f_audit_number(syminfo.mintick) + ',"exchange_timezone":"' + syminfo.timezone + '","scoring_mode":"' + vwMode + '","ema200_policy":"' + ema200FilterPolicy + '","ema200_length":' + str.tostring(ema200Length) + ',"rsi_policy":"' + rsiFilterPolicy + '","rsi_length":' + str.tostring(rsiLength) + ',"adaptive_stops":' + str.tostring(adaptiveStops) + ',"two_stage":' + str.tostring(enableScalpTwoStageExit) + ',"dca_enabled":' + str.tostring(enableTrendDca) + ',"next_bar":' + str.tostring(executeConfirmedSignalNextBar) + ',"minimum_rr":' + str.tostring(scalpMinimumRr) + ',"supported_tf":' + str.tostring(supportedTf) + '}')
    for auditEventIndex = 0 to (array.size(auditEventQueue) == 0 ? na : array.size(auditEventQueue) - 1)
        log.info(array.get(auditEventQueue, auditEventIndex))
    array.clear(auditEventQueue)
    bool auditLondon = not na(time(timeframe.period, "0800-1700:23456", "Europe/London"))
    bool auditNewYork = not na(time(timeframe.period, "0800-1700:23456", "America/New_York"))
    string auditSession = auditLondon and auditNewYork ? "overlap" : auditLondon ? "london" : auditNewYork ? "new_york" : "outside"
    string auditPrefix = '{"schema":"XAU_STOP_AUDIT_V1","time":' + str.tostring(time) + ',"bar":' + str.tostring(bar_index)
    log.info(auditPrefix + ',"event":"BAR","session":"' + auditSession + '","open":' + f_audit_number(open) + ',"high":' + f_audit_number(high) + ',"low":' + f_audit_number(low) + ',"close":' + f_audit_number(close) + ',"atr":' + f_audit_number(c16c02Snapshot.atr) + ',"display_id":' + str.tostring(r9DisplaySignalId) + ',"display_status":' + str.tostring(r9DisplaySignalStatus) + ',"ambiguous":' + str.tostring(r9DisplaySignalAmbiguousExit) + ',"signal_atr_ticks":' + f_audit_number(auditSignalAtrTicks) + ',"entry_ticks":' + f_audit_number(r9DisplaySignalEntryTicks) + ',"initial_sl_ticks":' + f_audit_number(r9DisplaySignalInitialSlTicks) + ',"tp2_ticks":' + f_audit_number(r9DisplaySignalTp2Ticks) + '}')
    for auditSlot = 0 to (array.size(mainCandidates) == 0 ? na : array.size(mainCandidates) - 1)
        MainCandidate auditCandidate = array.get(mainCandidates, auditSlot)
        log.info(auditPrefix + ',"event":"CANDIDATE_SNAPSHOT","slot":' + str.tostring(auditSlot) + ',"source_bar":' + f_audit_number(auditCandidate.source_bar_index) + ',"family":' + f_audit_number(auditCandidate.family) + ',"subtype":' + f_audit_number(auditCandidate.subtype) + ',"direction":' + str.tostring(auditCandidate.direction) + ',"state":' + str.tostring(auditCandidate.state) + ',"anchor_ticks":' + f_audit_number(auditCandidate.thesis_anchor_ticks) + ',"quality":' + str.tostring(auditCandidate.total_quality) + ',"policy_quality":' + f_audit_number(array.get(policyQualityBySlot, auditSlot)) + ',"ema200_adjustment":' + f_audit_number(array.get(ema200AdjustmentBySlot, auditSlot)) + ',"rsi_adjustment":' + f_audit_number(array.get(rsiAdjustmentBySlot, auditSlot)) + ',"policy_state_mask":' + f_audit_number(array.get(policyStateMaskBySlot, auditSlot)) + ',"ema200":' + f_audit_number(ema200) + ',"ema200_distance_atr":' + f_audit_number(array.get(ema200DistanceAtrBySlot, auditSlot)) + ',"ema200_slope_atr":' + f_audit_number(array.get(ema200SlopeAtrBySlot, auditSlot)) + ',"rsi":' + f_audit_number(rsi) + ',"rsi_slope":' + f_audit_number(array.get(rsiSlopeBySlot, auditSlot)) + ',"veto":' + str.tostring(auditCandidate.veto_mask) + '}')
    auditBarsWritten += 1
