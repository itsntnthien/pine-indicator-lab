                line smcLiquidityLine = line.new(smcLiquidityLeft, f_ticks_to_price(smcLiquidityItem.level_ticks, syminfo.mintick), time, f_ticks_to_price(smcLiquidityItem.level_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(smcLiquidityColor, smcLiquidityItem.swept ? 62 : 5), style = smcLiquidityItem.swept ? line.style_dotted : line.style_solid, width = smcLiquidityItem.swept ? 1 : 2)
                array.push(smcLiquidityRenderLines, smcLiquidityLine)
    if showFvg and array.size(smcFvgs) > 0
