            string smcStructureText = smcLatestStructure.event_type == SE_BOS_BULLISH ? "BOS UP" : smcLatestStructure.event_type == SE_BOS_BEARISH ? "BOS DOWN" : smcLatestStructure.event_type == SE_CHOCH_BULLISH ? "CHoCH UP" : "CHoCH DOWN"
            nextStructureLabel := label.new(smcLatestStructure.time, f_ticks_to_price(smcLatestStructure.price_ticks, syminfo.mintick), smcStructureText, xloc = xloc.bar_time, yloc = yloc.price, style = smcStructureBullish ? label.style_label_up : label.style_label_down, color = color.new(smcStructureBullish ? color.rgb(0, 145, 125) : color.rgb(210, 55, 70), 8), textcolor = color.white, size = size.small, tooltip = "Confirmed market-structure event\n" + smcStructureText + "\nLevel: " + f_c08_price_text(smcLatestStructure.price_ticks))
        if showInducement and not na(inducementTicks) and not na(inducementTime)
            bool inducementBullish = inducementSide == DIR_BULLISH
            line smcInducementLine = line.new(inducementTime, f_ticks_to_price(inducementTicks, syminfo.mintick), time, f_ticks_to_price(inducementTicks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(inducementBullish ? color.rgb(0, 145, 125) : color.rgb(210, 55, 70), 20), style = line.style_dotted, width = 1)
            array.push(smcStructureRenderLines, smcInducementLine)
    if showLiquidity and array.size(smcLiquidity) > 0
