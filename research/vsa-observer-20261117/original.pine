f_r9_protected_primary_reentry(bool sameDirection, bool sameThesis, int timeframeMinutes, int direction, int family, int subtype, int regime, int trendStrength, int atrTicks, int primaryEntryTicks, int primaryStopTicks, int bestFavorableTicks, int candidateEntryTicks, int candidateStopTicks, int primaryScore, int candidateScore, int candidateRrMilli, int minimumRrMilli) =>
    int primaryRiskTicks = sameDirection and not na(primaryEntryTicks) and not na(primaryStopTicks) ? (primaryEntryTicks - primaryStopTicks) * direction : na
    int favorableTicks = sameDirection and not na(bestFavorableTicks) and not na(primaryEntryTicks) ? (bestFavorableTicks - primaryEntryTicks) * direction : na
    int openProfitTicks = sameDirection and not na(candidateEntryTicks) and not na(primaryEntryTicks) ? (candidateEntryTicks - primaryEntryTicks) * direction : na
    int pullbackTicks = sameDirection and not na(bestFavorableTicks) and not na(candidateEntryTicks) ? (bestFavorableTicks - candidateEntryTicks) * direction : na
    bool resetGeometryValid = not na(primaryRiskTicks) and primaryRiskTicks > 0 and not na(favorableTicks) and not na(openProfitTicks) and not na(pullbackTicks)
    bool protected = resetGeometryValid and favorableTicks * 1000 >= primaryRiskTicks * PRIMARY_REENTRY_ACTIVATION_R_MILLI and openProfitTicks * 1000 >= primaryRiskTicks * PRIMARY_REENTRY_MIN_OPEN_PROFIT_R_MILLI
    bool pullbackReset = resetGeometryValid and pullbackTicks * 1000 >= primaryRiskTicks * PRIMARY_REENTRY_MIN_PULLBACK_R_MILLI
    bool stopNotWider = sameDirection and not na(candidateStopTicks) and not na(primaryStopTicks) and (direction == DIR_BULLISH ? candidateStopTicks >= primaryStopTicks : candidateStopTicks <= primaryStopTicks)
    bool strictTrend = direction == DIR_BULLISH ? regime == REGIME_UPTREND : regime == REGIME_DOWNTREND
    bool scoreNotWeaker = not na(primaryScore) and not na(candidateScore) and candidateScore >= primaryScore
    int stopAdvanceTicks = sameDirection and not na(candidateStopTicks) and not na(primaryStopTicks) ? (candidateStopTicks - primaryStopTicks) * direction : na
    bool materialStopAdvance = not na(atrTicks) and atrTicks > 0 and not na(stopAdvanceTicks) and stopAdvanceTicks * 1000 >= atrTicks * PRIMARY_REENTRY_MIN_STOP_ADVANCE_ATR_MILLI
    bool materialStructuralPullback = resetGeometryValid and not na(atrTicks) and atrTicks > 0 and pullbackTicks * 1000 >= atrTicks * PRIMARY_REENTRY_MIN_STRUCTURAL_PULLBACK_ATR_MILLI
    bool scoreWithinResetTolerance = not na(primaryScore) and not na(candidateScore) and candidateScore >= primaryScore - PRIMARY_REENTRY_MAX_SCORE_DROP
    bool rrValid = not na(candidateRrMilli) and candidateRrMilli >= minimumRrMilli
    bool protectedPullbackReset = family == MF_CONTINUATION and subtype == MST_CONT_PULLBACK and strictTrend and trendStrength >= PRIMARY_REENTRY_MIN_TREND_STRENGTH and protected and pullbackReset and stopNotWider and scoreNotWeaker
    bool structuralContinuationReset = family == MF_CONTINUATION and subtype == MST_CONT_PULLBACK and strictTrend and trendStrength >= 80 and stopNotWider and materialStopAdvance and materialStructuralPullback and scoreWithinResetTolerance
    bool structuralBreakoutReset = family == MF_BREAKOUT and subtype == MST_BREAK_STRUCTURE and trendStrength >= ENTRY_BREAKOUT_MIN_STRENGTH and stopNotWider and materialStopAdvance and scoreWithinResetTolerance
    (timeframeMinutes == 5 or timeframeMinutes == 15) and sameDirection and not sameThesis and rrValid and (protectedPullbackReset or structuralContinuationReset or structuralBreakoutReset)
f_r9_independent_campaign_opportunity(bool campaignActive, bool sameThesis, int timeframeMinutes, int campaignDirection, int direction, int family, int subtype, int regime, int trendStrength, int atrTicks, int primaryStopTicks, int bestFavorableTicks, int candidateEntryTicks, int candidateStopTicks, int primaryScore, int candidateScore, int candidateQuality, int candidateRrMilli, int minimumRrMilli) =>
    bool supported = timeframeMinutes == 1 or timeframeMinutes == 3 or timeframeMinutes == 5 or timeframeMinutes == 15
    bool sameDirection = campaignActive and campaignDirection == direction and (direction == DIR_BULLISH or direction == DIR_BEARISH)
    bool numeric = not na(atrTicks) and atrTicks > 0 and not na(primaryStopTicks) and not na(bestFavorableTicks) and not na(candidateEntryTicks) and not na(candidateStopTicks) and not na(primaryScore) and not na(candidateScore) and not na(candidateRrMilli)
    int candidateRiskTicks = numeric ? (candidateEntryTicks - candidateStopTicks) * direction : na
    int stopAdvanceTicks = numeric ? (candidateStopTicks - primaryStopTicks) * direction : na
    int pullbackTicks = numeric ? (bestFavorableTicks - candidateEntryTicks) * direction : na
    bool stopNotWider = numeric and stopAdvanceTicks >= 0
    bool materialStopAdvance = stopNotWider and stopAdvanceTicks * 1000 >= atrTicks * OPPORTUNITY_MIN_STOP_ADVANCE_ATR_MILLI
    bool materialPullback = numeric and pullbackTicks >= 0 and pullbackTicks * 1000 >= atrTicks * OPPORTUNITY_MIN_PULLBACK_ATR_MILLI
    bool scoreTolerant = numeric and candidateScore >= primaryScore - OPPORTUNITY_MAX_SCORE_DROP
    bool rrValid = numeric and candidateRrMilli >= minimumRrMilli
    bool strictTrend = direction == DIR_BULLISH ? regime == REGIME_UPTREND : regime == REGIME_DOWNTREND
    bool pressureAligned = direction == DIR_BULLISH ? regime == REGIME_RANGE_PRESSURE_UP : regime == REGIME_RANGE_PRESSURE_DOWN
    int continuationMinimumStrength = subtype == MST_CONT_RECLAIM ? ENTRY_RECLAIM_MIN_STRENGTH : ENTRY_CONTINUATION_MIN_STRENGTH
    bool researchBackedContinuation = (timeframeMinutes == 3 or timeframeMinutes == 5) and family == MF_CONTINUATION and candidateQuality == 100 and (strictTrend or pressureAligned) and trendStrength >= continuationMinimumStrength
    bool researchLocationReset = researchBackedContinuation and (not sameThesis or pullbackTicks >= 0 and pullbackTicks * 1000 >= atrTicks * 250)
    bool continuationOpportunity = family == MF_CONTINUATION and subtype == MST_CONT_PULLBACK and strictTrend and trendStrength >= OPPORTUNITY_MIN_TREND_STRENGTH and materialPullback
    bool breakoutOpportunity = family == MF_BREAKOUT and subtype == MST_BREAK_STRUCTURE and trendStrength >= ENTRY_BREAKOUT_MIN_STRENGTH
    bool strictStructuralOpportunity = not sameThesis and materialStopAdvance and scoreTolerant and (continuationOpportunity or breakoutOpportunity)
    supported and sameDirection and candidateRiskTicks > 0 and rrValid and (researchLocationReset or strictStructuralOpportunity)
f_r9_same_reference_thesis(bool campaignActive, int campaignDirection, int campaignFamily, int campaignSubtype, int campaignInvalidationTicks, int campaignTargetTicks, bool campaignTargetPresent, int campaignTargetType, int campaignTargetIdentity, int campaignRegime, int candidateDirection, int candidateFamily, int candidateSubtype, int candidateInvalidationTicks, int candidateTargetTicks, bool candidateTargetPresent, int candidateTargetType, int candidateTargetIdentity, int candidateRegime) =>
    bool sameIntent = campaignDirection == candidateDirection and campaignFamily == candidateFamily and campaignSubtype == candidateSubtype
    bool sameInvalidation = not na(campaignInvalidationTicks) and campaignInvalidationTicks == candidateInvalidationTicks
    bool targetIdentitiesAvailable = campaignTargetPresent and candidateTargetPresent and not na(campaignTargetIdentity) and not na(candidateTargetIdentity)
    bool sameTarget = targetIdentitiesAvailable ? campaignTargetType == candidateTargetType and campaignTargetIdentity == candidateTargetIdentity : not na(campaignTargetTicks) and campaignTargetTicks == candidateTargetTicks
    campaignActive and sameIntent and sameInvalidation and sameTarget and campaignRegime == candidateRegime
