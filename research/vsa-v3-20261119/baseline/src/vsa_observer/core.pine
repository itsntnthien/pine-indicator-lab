var int wyckoffLeaning = WYCKOFF_LEANING_UNAVAILABLE
var bool wyckoffValid = false
var int wyckoffReason = WYCKOFF_REASON_WARMUP
var int wyckoffLeaningSourceBar = -1
var bool springEvent = false
var bool springFresh = false
var int springSourceBar = -1
var int springConfirmBar = -1
var string springReferenceId = "-1:0:-1:-1"
var bool upthrustEvent = false
var bool upthrustFresh = false
var int upthrustSourceBar = -1
var int upthrustConfirmBar = -1
var string upthrustReferenceId = "-1:0:-1:-1"
var int wyckoffEffectBuy = WYCKOFF_NEUTRAL
var int wyckoffEffectSell = WYCKOFF_NEUTRAL
float priorHigh20 = array.size(committedHighs) > 0 ? array.max(committedHighs) : high
float priorLow20 = array.size(committedLows) > 0 ? array.min(committedLows) : low
float[] rangeHighsArray = array.copy(committedHighs)
array.push(rangeHighsArray, high)
if (array.size(rangeHighsArray) > FEATURE_RANGE_LENGTH)
    array.shift(rangeHighsArray)
float rangeHigh20 = array.size(rangeHighsArray) > 0 ? array.max(rangeHighsArray) : high
float[] rangeLowsArray = array.copy(committedLows)
array.push(rangeLowsArray, low)
if (array.size(rangeLowsArray) > FEATURE_RANGE_LENGTH)
    array.shift(rangeLowsArray)
float rangeLow20 = array.size(rangeLowsArray) > 0 ? array.min(rangeLowsArray) : low
var int committedRegime = REGIME_RANGE_FORMING
var int committedRegimeAge = 0
var int committedBreakDirection = DIRECTION_NONE
var bool retainedBreakProvenanceValid = false
var int retainedBreakReferenceKind = -1
var int retainedBreakReferenceSourceBar = na
var int retainedBreakReferenceLevelTicks = na
var string retainedBreakReferenceId = "-1:0:-1:-1"
// Current HTF is accepted only at/after its native close; the offset request supplies the prior confirmed bar during realtime.
f_native_htf(string tf) =>
    [co, ch, cl, cc, cv, ct, ce] = request.security(ticker.standard(syminfo.tickerid), tf, [open, high, low, close, volume, time, time_close], lookahead = barmerge.lookahead_off)
    [po, ph, pl, pc, pv, pt, pe] = request.security(ticker.standard(syminfo.tickerid), tf, [open[1], high[1], low[1], close[1], volume[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
    bool useCurrent = not na(ce) and ce <= time_close and (na(pe) or ce >= pe)
    [useCurrent ? co : po, useCurrent ? ch : ph, useCurrent ? cl : pl, useCurrent ? cc : pc, useCurrent ? cv : pv, useCurrent ? ct : pt, useCurrent ? ce : pe]
string confTf = confirmationTfMinutes == 1440 ? "D" : str.tostring(math.max(confirmationTfMinutes, 1))
string anchorTf = anchorTfMinutes == 10080 ? "W" : anchorTfMinutes == 1440 ? "D" : str.tostring(math.max(anchorTfMinutes, 1))
[nConfO, nConfH, nConfL, nConfC, nConfV, nConfStart, nConfEnd] = f_native_htf(confTf)
[nAnchorO, nAnchorH, nAnchorL, nAnchorC, nAnchorV, nAnchorStart, nAnchorEnd] = f_native_htf(anchorTf)
var int confLastCommittedStart = na
var int confLastCommittedEnd = na
var float confCommittedO = na
var float confCommittedH = na
var float confCommittedL = na
var float confCommittedC = na
var float confCommittedV = na
var bool confCommittedValid = false
var int anchorLastCommittedStart = na
var int anchorLastCommittedEnd = na
var float anchorCommittedO = na
var float anchorCommittedH = na
var float anchorCommittedL = na
var float anchorCommittedC = na
var float anchorCommittedV = na
var bool anchorCommittedValid = false
var int officialBias = BIAS_NEUTRAL
var int pendingBias = BIAS_NEUTRAL
var int pendingBiasCount = 0
var int dowPrimaryTrend = DOW_TREND_UNAVAILABLE
var int dowSecondaryTrend = DOW_TREND_UNAVAILABLE
var int dowExecutionTrend = DOW_TREND_UNAVAILABLE
var int dowAlignmentState = DOW_ALIGNMENT_UNAVAILABLE
var bool dowValid = false
var int dowReason = DOW_REASON_WARMUP
var int dowPrimarySourceBar = -1
var int dowSecondarySourceBar = -1
var int dowExecutionSourceBar = -1
var int dowCountertrendSeverityBuy = 0
var int dowCountertrendSeveritySell = 0
var int dowContextEffectBuy = DOW_NEUTRAL
var int dowContextEffectSell = DOW_NEUTRAL
bool confirmationBucketCommitted = false
bool anchorBucketCommitted = false
bool committedStateUpdated = false
if barstate.isconfirmed
    committedStateUpdated := supportedTf
    int smcPriorSwingHighTicks = c16c02SwingHighTicks
    int smcPriorSwingLowTicks = c16c02SwingLowTicks
    bool smcPriorSwingHighConsumed = smcSwingHighConsumed
    bool smcPriorSwingLowConsumed = smcSwingLowConsumed
    if smcCalculationTf
        committedEmaFast := shadowEmaFast
        committedEmaSlow := shadowEmaSlow
        committedAtr := math.max(shadowAtr, 0.000000000001)
        committedPreviousClose := close
        committedFeatureBars += 1
        array.push(committedHighs, high)
        array.push(committedLows, low)
        if array.size(committedHighs) > FEATURE_RANGE_LENGTH
            array.shift(committedHighs)
        if array.size(committedLows) > FEATURE_RANGE_LENGTH
            array.shift(committedLows)
        if not na(high[SWING_LEFT_BARS + SWING_RIGHT_BARS])
            int pivotHighTicks = f_to_ticks(high[SWING_RIGHT_BARS], syminfo.mintick)
            int pivotLowTicks = f_to_ticks(low[SWING_RIGHT_BARS], syminfo.mintick)
            bool pivotHighValid = not na(pivotHighTicks)
            bool pivotLowValid = not na(pivotLowTicks)
            for offset = 1 to SWING_LEFT_BARS
                int leftHighTicks = f_to_ticks(high[SWING_RIGHT_BARS + offset], syminfo.mintick)
                int leftLowTicks = f_to_ticks(low[SWING_RIGHT_BARS + offset], syminfo.mintick)
                pivotHighValid := pivotHighValid and pivotHighTicks >= leftHighTicks
                pivotLowValid := pivotLowValid and pivotLowTicks <= leftLowTicks
            for offset = 0 to SWING_RIGHT_BARS - 1
                int rightHighTicks = f_to_ticks(high[offset], syminfo.mintick)
                int rightLowTicks = f_to_ticks(low[offset], syminfo.mintick)
                pivotHighValid := pivotHighValid and pivotHighTicks > rightHighTicks
                pivotLowValid := pivotLowValid and pivotLowTicks < rightLowTicks
            if pivotHighValid
                c16c02SwingHighTicks := pivotHighTicks
                c16c02SwingHighSourceTime := time[SWING_RIGHT_BARS]
                c16c02SwingHighConfirmationTime := time
            if pivotLowValid
                c16c02SwingLowTicks := pivotLowTicks
                c16c02SwingLowSourceTime := time[SWING_RIGHT_BARS]
                c16c02SwingLowConfirmationTime := time
        array.push(c16c02CommittedCloses, close)
        if array.size(c16c02CommittedCloses) > BOLLINGER_LENGTH
            array.shift(c16c02CommittedCloses)
    if supportedTf
        confCommittedValid := not na(nConfEnd) and nConfEnd <= time_close and not na(nConfO) and not na(nConfC)
        anchorCommittedValid := not na(nAnchorEnd) and nAnchorEnd <= time_close and not na(nAnchorO) and not na(nAnchorC)
        if confCommittedValid
            confirmationBucketCommitted := na(confLastCommittedStart) or nConfStart != confLastCommittedStart
            confLastCommittedStart := nConfStart
            confLastCommittedEnd := nConfEnd
            confCommittedO := nConfO
            confCommittedH := nConfH
            confCommittedL := nConfL
            confCommittedC := nConfC
            confCommittedV := nConfV
        if anchorCommittedValid
            anchorBucketCommitted := na(anchorLastCommittedStart) or nAnchorStart != anchorLastCommittedStart
            anchorLastCommittedStart := nAnchorStart
            anchorLastCommittedEnd := nAnchorEnd
            anchorCommittedO := nAnchorO
            anchorCommittedH := nAnchorH
            anchorCommittedL := nAnchorL
            anchorCommittedC := nAnchorC
            anchorCommittedV := nAnchorV
    int evaluatedOfficialBias = officialBias
    if supportedTf and confirmationBucketCommitted and confCommittedValid
        float confirmationComponent = f_obs_candle_direction(confCommittedO, confCommittedC)
        float confirmationCapped = math.max(-BIAS_COMPONENT_CAP, math.min(BIAS_COMPONENT_CAP, confirmationComponent * BIAS_FAMILY_WEIGHT))
        float anchorCapped = anchorCommittedValid ? math.max(-BIAS_COMPONENT_CAP, math.min(BIAS_COMPONENT_CAP, f_obs_candle_direction(anchorCommittedO, anchorCommittedC) * BIAS_FAMILY_WEIGHT)) : 0.0
        float biasScore = confirmationCapped + anchorCapped
        int targetBias = biasScore > BIAS_HYSTERESIS ? BIAS_BULLISH : biasScore < -BIAS_HYSTERESIS ? BIAS_BEARISH : BIAS_NEUTRAL
        if targetBias != pendingBias
            pendingBias := targetBias
            pendingBiasCount := 1
        else
            pendingBiasCount += 1
        if targetBias != officialBias and pendingBiasCount >= 2
            evaluatedOfficialBias := targetBias
    if supportedTf
        committedRegimeAge += 1
        float normalizedSeparation = (committedEmaFast - committedEmaSlow) / committedAtr
        float trendExit = REGIME_SEPARATION - REGIME_HYSTERESIS
        int requestedRegime = committedRegime
        if committedRegime == REGIME_RANGE_FORMING
            if committedRegimeAge >= REGIME_FORMING_BARS
                requestedRegime := REGIME_RANGE_ACTIVE
