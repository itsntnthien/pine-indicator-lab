int FEATURE_RANGE_LENGTH = 20
int WARMUP_BARS = math.max(21, 3 * ema200Length)

// Fixed first-trial rules, not optimized. Missing/zero volume is neutral, never low volume.
float vwVolumeMean = ta.sma(volume[1], 20)
float vwRangeMean = ta.sma(high[1] - low[1], 20)
float ema200 = ta.ema(close, ema200Length)
float inspectorAtr = ta.atr(14)
float vwValidVolumeWindow = ta.sma(not na(volume) and volume > 0 ? 1.0 : 0.0, 21)
bool vwValid = vwValidVolumeWindow == 1 and not na(vwVolumeMean) and vwVolumeMean > 0 and not na(vwRangeMean) and vwRangeMean > 0 and high > low
float vwRelativeVolume = vwValid ? volume / vwVolumeMean : na
float vwRelativeRange = vwValid ? (high - low) / vwRangeMean : na
float vwCloseLocation = vwValid ? (close - low) / (high - low) : na
bool vwHighVolume = vwValid and vwRelativeVolume >= 1.5
bool vwLowVolume = vwValid and vwRelativeVolume <= 0.7
bool vwNarrow = vwValid and vwRelativeRange <= 0.8
bool vwDemand = vwHighVolume and vwRelativeRange >= 1.2 and close > close[1] and vwCloseLocation >= 0.7
bool vwSupply = vwHighVolume and vwRelativeRange >= 1.2 and close < close[1] and vwCloseLocation <= 0.3
// ponytail: bar-pattern proxies, not proof of institutional absorption; validate on native feed.
bool vwAbsorbBuy = vwHighVolume and vwNarrow and vwCloseLocation >= 0.65
bool vwAbsorbSell = vwHighVolume and vwNarrow and vwCloseLocation <= 0.35
bool vwNoSupply = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close < close[1] and vwCloseLocation >= 0.5
bool vwNoDemand = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close > close[1] and vwCloseLocation <= 0.5
int vwDirection = (vwDemand or vwAbsorbBuy or vwNoSupply ? 1 : 0) - (vwSupply or vwAbsorbSell or vwNoDemand ? 1 : 0)

f_smc_inducement_value(int field, int trend, bool newLow, bool newHigh, int priorLowTicks, int priorHighTicks, int newLowTicks, int newHighTicks, int newLowTime, int newHighTime, int currentTicks, int currentTime, int currentSide) =>
    bool bullInducement = trend == DIR_BULLISH and newLow and not na(priorLowTicks) and not na(newLowTicks) and newLowTicks > priorLowTicks
    bool bearInducement = trend == DIR_BEARISH and newHigh and not na(priorHighTicks) and not na(newHighTicks) and newHighTicks < priorHighTicks
    field == 0 ? bullInducement ? newLowTicks : bearInducement ? newHighTicks : currentTicks : field == 1 ? bullInducement ? newLowTime : bearInducement ? newHighTime : currentTime : bullInducement or bearInducement ? (bullInducement ? DIR_BULLISH : DIR_BEARISH) : currentSide
f_observer_session(string timeframeText) =>
    bool london = not na(time(timeframeText, "0800-1700:23456", "Europe/London"))
    bool newYork = not na(time(timeframeText, "0800-1700:23456", "America/New_York"))
    london and newYork ? "OVERLAP" : london ? "LONDON" : newYork ? "NEW YORK" : "OUTSIDE"
bool showUpperCloud = showCloudContext

bool supportedTf = chart.is_standard and timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 3 or timeframe.multiplier == 5 or timeframe.multiplier == 15 or timeframe.multiplier == 30 or timeframe.multiplier == 60 or timeframe.multiplier == 240)
// Observation uses confirmed native candles; signal support remains M1/M3/M5/M15.
bool smcObservationTf = chart.is_standard and (timeframe.isseconds or timeframe.isminutes or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
bool smcCalculationTf = supportedTf or smcObservationTf
bool smcObservationMode = not supportedTf and smcObservationTf
int chartTfMinutes = supportedTf ? timeframe.multiplier : 0

int confirmationTfMinutes = chartTfMinutes == 1 ? 5 : chartTfMinutes == 3 ? 15 : chartTfMinutes == 5 ? 15 : chartTfMinutes == 15 or chartTfMinutes == 30 ? 60 : chartTfMinutes == 60 ? 240 : chartTfMinutes == 240 ? 1440 : 0
int anchorTfMinutes = chartTfMinutes == 1 ? 15 : chartTfMinutes == 3 ? 60 : chartTfMinutes == 5 ? 60 : chartTfMinutes == 15 or chartTfMinutes == 30 ? 240 : chartTfMinutes == 60 ? 1440 : chartTfMinutes == 240 ? 10080 : 0
int chartTfMs = chartTfMinutes * 60000
int confirmationTfMs = confirmationTfMinutes * 60000
int anchorTfMs = anchorTfMinutes * 60000
int confirmationExpectedBars = supportedTf ? int(confirmationTfMinutes / chartTfMinutes) : 0
int anchorExpectedBars = supportedTf ? int(anchorTfMinutes / chartTfMinutes) : 0
var float committedEmaFast = na
var float committedEmaSlow = na
var float committedAtr = na
var float committedPreviousClose = na
var int committedFeatureBars = 0
float fastAlpha = 2.0 / 9.0
float slowAlpha = 2.0 / 22.0
float atrAlpha = 1.0 / 14.0
float currentTrueRange = na(committedPreviousClose) ? high - low : math.max(high - low, math.max(math.abs(high - committedPreviousClose), math.abs(low - committedPreviousClose)))
float shadowEmaFast = na(committedEmaFast) ? close : committedEmaFast + fastAlpha * (close - committedEmaFast)
float shadowEmaSlow = na(committedEmaSlow) ? close : committedEmaSlow + slowAlpha * (close - committedEmaSlow)
float shadowAtr = na(committedAtr) ? currentTrueRange : committedAtr + atrAlpha * (currentTrueRange - committedAtr)
var float[] committedHighs = array.new_float(0)
var float[] committedLows = array.new_float(0)
var float[] c16c02CommittedCloses = array.new_float(0)
