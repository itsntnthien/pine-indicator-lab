//@version=6
indicator("VSA Observer v2 • Cấu trúc & bối cảnh", "VSA OBS v2", overlay = true, behind_chart = false, max_labels_count = 150, max_lines_count = 20, max_boxes_count = 20, max_bars_back = 600)
// Observation derivative of the user's XAU-VSA attachment, 2026-11-17.
bool showInspector = input.bool(true, "Bảng quan sát", group = "Hiển thị")
string panelPosition = input.string("Dưới trái", "Vị trí bảng", options = ["Trên phải", "Dưới phải", "Dưới trái"], group = "Hiển thị")
string panelFont = input.string("Vừa", "Cỡ chữ bảng", options = ["Nhỏ", "Vừa"], group = "Hiển thị")
bool showEma = input.bool(true, "EMA tham chiếu", group = "Hiển thị")
bool showCloudContext = input.bool(false, "Dải EMA 8/21 ± 0.5 ATR của lõi gốc", group = "Hiển thị")
bool showVsaEvents = input.bool(true, "Nhãn mẫu VSA / quét thanh khoản", group = "Hiển thị")
bool showVsaDetails = input.bool(false, "Thêm nhãn VSA (mặc định chỉ quét)", group = "Hiển thị")
bool colorVsaBars = input.bool(false, "Tô nến có mẫu VSA", group = "Hiển thị")
int eventLimit = input.int(8, "Số nhãn sự kiện tối đa", minval = 4, maxval = 120, group = "Hiển thị")
int ema200Length = input.int(200, "Chu kỳ EMA", minval = 50, maxval = 500, group = "Tham chiếu")
bool showMarketStructure = input.bool(true, "Swing / BOS / CHoCH", group = "Vùng và cấu trúc")
bool showLiquidity = input.bool(true, "Pool thanh khoản", group = "Vùng và cấu trúc")
bool showFvg = input.bool(true, "FVG", group = "Vùng và cấu trúc")
bool showOrderBlocks = input.bool(true, "Order block", group = "Vùng và cấu trúc")
bool showInducement = input.bool(false, "Pivot hồi IDM (heuristic)", group = "Vùng và cấu trúc")
bool showZoneQuality = input.bool(false, "Độ rộng vùng / ATR", group = "Vùng và cấu trúc")
bool showZoneLabels = input.bool(true, "Tên vùng", group = "Vùng và cấu trúc")
bool showOnlyActiveZones = input.bool(true, "Chỉ hiện vùng chưa chạm / pool chưa quét", group = "Vùng và cấu trúc")
int smcLiquidityDisplayLimit = input.int(4, "Số pool hiển thị", minval = 1, maxval = 8, group = "Vùng và cấu trúc")
int smcFvgDisplayLimit = input.int(3, "Số FVG hiển thị", minval = 1, maxval = 5, group = "Vùng và cấu trúc")
int smcObDisplayLimit = input.int(3, "Số OB hiển thị", minval = 1, maxval = 5, group = "Vùng và cấu trúc")
bool enableContextAlerts = input.bool(false, "Cảnh báo sự kiện khi đóng nến", group = "Thông báo")
// The classifier preserves the original mutually-exclusive bar-pattern thresholds.
f_obs_vsa(bool valid, float rv, float rr, float loc, float delta, bool belowBoth) =>
    not valid ? 99 : rv >= 1.5 and rr >= 1.2 and delta > 0 and loc >= 0.7 ? 1 : rv >= 1.5 and rr >= 1.2 and delta < 0 and loc <= 0.3 ? -1 : rv >= 1.5 and rr <= 0.8 and loc >= 0.65 ? 2 : rv >= 1.5 and rr <= 0.8 and loc <= 0.35 ? -2 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta < 0 and loc >= 0.5 ? 3 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta > 0 and loc <= 0.5 ? -3 : 0
f_obs_expired(int age, int ttl) =>
    age > ttl
f_obs_candle_direction(float o, float c) =>
    math.sign(c - o)
f_obs_label_above(int sweep, int vsa) =>
    sweep != 0 ? sweep == -1 or sweep == 2 : vsa < 0
