var array<Zone> h1Zones = array.new<Zone>()
var array<Zone> h4Zones = array.new<Zone>()

f_addZone(array<Zone> zones, string tf, string kind, int side, float lo, float hi, int anchor, int available, int born) =>
    if not na(lo) and not na(hi) and lo <= hi and side != 0
        string id = syminfo.tickerid + ":" + tf + ":" + kind + ":" + str.tostring(side) + ":" + str.tostring(anchor) + ":" + str.tostring(available)
        array.push(zones, Zone.new(id, kind, side, lo, hi, anchor, available, born))
        if kind == "BSL" or kind == "SSL" or kind == "SR"
            int count = 0
            for z in zones
                if z.kind == kind and z.side == side
                    count += 1
            int i = 0
            while count > 3 and i < array.size(zones)
                Zone old = array.get(zones, i)
                if old.kind == kind and old.side == side
                    array.remove(zones, i)
                    count -= 1
                else
                    i += 1
    0

f_ingest(array<Zone> zones, string tf, int stamp, int available, int index, float c, float atr, float ph, float pl, int anchor, int obDir, float obLo, float obHi, int fvgDir, float fvgLo, float fvgHi, int sdDir, float sdLo, float sdHi) =>
    int i = array.size(zones) - 1
    while i >= 0
        Zone z = array.get(zones, i)
        bool invalid = z.side == 1 ? c < z.lo : c > z.hi
        if invalid or index - z.bornIndex >= MAX_AGE
            array.remove(zones, i)
        i -= 1
    if not na(atr) and atr > 0
        if not na(ph)
            f_addZone(zones, tf, "BSL", -1, ph, ph, anchor, available, index)
            f_addZone(zones, tf, "SR", -1, ph - SR_ATR * atr, ph + SR_ATR * atr, anchor, available, index)
        if not na(pl)
            f_addZone(zones, tf, "SSL", 1, pl, pl, anchor, available, index)
            f_addZone(zones, tf, "SR", 1, pl - SR_ATR * atr, pl + SR_ATR * atr, anchor, available, index)
        f_addZone(zones, tf, "OB", obDir, obLo, obHi, stamp, available, index)
        f_addZone(zones, tf, "FVG", fvgDir, fvgLo, fvgHi, stamp, available, index)
        f_addZone(zones, tf, "SD", sdDir, sdLo, sdHi, stamp, available, index)
    0

bool newH1 = not na(h1Time) and (na(h1Time[1]) or h1Time != h1Time[1])
bool newH4 = not na(h4Time) and (na(h4Time[1]) or h4Time != h4Time[1])
if h1Request == "60" and newH1
    f_ingest(h1Zones, "60", h1Time, h1CloseTime, h1Index, h1Close, h1Atr, h1Ph, h1Pl, h1Anchor, h1ObDir, h1ObLo, h1ObHi, h1FvgDir, h1FvgLo, h1FvgHi, h1SdDir, h1SdLo, h1SdHi)
if h4Request == "240" and newH4
    f_ingest(h4Zones, "240", h4Time, h4CloseTime, h4Index, h4Close, h4Atr, h4Ph, h4Pl, h4Anchor, h4ObDir, h4ObLo, h4ObHi, h4FvgDir, h4FvgLo, h4FvgHi, h4SdDir, h4SdLo, h4SdHi)
array<Zone> activeZones = activeTf == "60" ? h1Zones : h4Zones

f_contact(Zone z) =>
    high >= z.lo and low <= z.hi

f_sweepOrTouch(Zone z) =>
    bool liquidity = z.kind == "BSL" or z.kind == "SSL"
    f_contact(z) and (not liquidity or (z.side == 1 ? low <= z.lo - tick : high >= z.hi + tick))

f_reclaimed(Zone z) =>
    bool liquidity = z.kind == "BSL" or z.kind == "SSL"
    z.side == 1 ? (liquidity ? close >= z.hi + tick : close > z.hi) : (liquidity ? close <= z.lo - tick : close < z.lo)

f_target(array<Zone> zones, int side, float entry) =>
    float target = na
    for z in zones
        // Used entry zones still represent structure until invalidated/expired.
        if z.side == -side and z.available <= time
            float candidate = side == 1 ? z.lo : z.hi
            if side * (candidate - entry) >= tick
                if na(target) or side * (candidate - target) < 0
                    target := candidate
    target
