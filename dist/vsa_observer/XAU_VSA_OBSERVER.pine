var int wyckoffLeaning = WYCKOFF_LEANING_UNAVAILABLE
var bool wyckoffValid = false
var int wyckoffReason = WYCKOFF_REASON_WARMUP
var int wyckoffLeaningSourceBar = -1
var bool springEvent = false
var bool springFresh = false
var int springSourceBar = -1
var int springConfirmBar = -1
var string springReferenceId = "-1:0:-1:-1"
var bool upthrustEvent = false
var bool upthrustFresh = false
var int upthrustSourceBar = -1
var int upthrustConfirmBar = -1
var string upthrustReferenceId = "-1:0:-1:-1"
var int wyckoffEffectBuy = WYCKOFF_NEUTRAL
var int wyckoffEffectSell = WYCKOFF_NEUTRAL
float priorHigh20 = array.size(committedHighs) > 0 ? array.max(committedHighs) : high
float priorLow20 = array.size(committedLows) > 0 ? array.min(committedLows) : low
float[] rangeHighsArray = array.copy(committedHighs)
array.push(rangeHighsArray, high)
if (array.size(rangeHighsArray) > FEATURE_RANGE_LENGTH)
    array.shift(rangeHighsArray)
float rangeHigh20 = array.size(rangeHighsArray) > 0 ? array.max(rangeHighsArray) : high
float[] rangeLowsArray = array.copy(committedLows)
array.push(rangeLowsArray, low)
if (array.size(rangeLowsArray) > FEATURE_RANGE_LENGTH)
    array.shift(rangeLowsArray)
float rangeLow20 = array.size(rangeLowsArray) > 0 ? array.min(rangeLowsArray) : low
var int committedRegime = REGIME_RANGE_FORMING
var int committedRegimeAge = 0
var int committedBreakDirection = DIRECTION_NONE
var bool retainedBreakProvenanceValid = false
var int retainedBreakReferenceKind = -1
var int retainedBreakReferenceSourceBar = na
var int retainedBreakReferenceLevelTicks = na
var string retainedBreakReferenceId = "-1:0:-1:-1"
// Current HTF is accepted only at/after its native close; the offset request supplies the prior confirmed bar during realtime.
f_native_htf(string tf) =>
    [co, ch, cl, cc, cv, ct, ce] = request.security(ticker.standard(syminfo.tickerid), tf, [open, high, low, close, volume, time, time_close], lookahead = barmerge.lookahead_off)
    [po, ph, pl, pc, pv, pt, pe] = request.security(ticker.standard(syminfo.tickerid), tf, [open[1], high[1], low[1], close[1], volume[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
    bool useCurrent = not na(ce) and ce <= time_close and (na(pe) or ce >= pe)
    [useCurrent ? co : po, useCurrent ? ch : ph, useCurrent ? cl : pl, useCurrent ? cc : pc, useCurrent ? cv : pv, useCurrent ? ct : pt, useCurrent ? ce : pe]
string confTf = confirmationTfMinutes == 1440 ? "D" : str.tostring(math.max(confirmationTfMinutes, 1))
string anchorTf = anchorTfMinutes == 10080 ? "W" : anchorTfMinutes == 1440 ? "D" : str.tostring(math.max(anchorTfMinutes, 1))
[nConfO, nConfH, nConfL, nConfC, nConfV, nConfStart, nConfEnd] = f_native_htf(confTf)
[nAnchorO, nAnchorH, nAnchorL, nAnchorC, nAnchorV, nAnchorStart, nAnchorEnd] = f_native_htf(anchorTf)
var int confLastCommittedStart = na
var int confLastCommittedEnd = na
