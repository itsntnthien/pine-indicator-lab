int eventLimit = input.int(8, "Số nhãn sự kiện tối đa", minval = 4, maxval = 120, group = "Hiển thị")
int ema200Length = input.int(200, "Chu kỳ EMA", minval = 50, maxval = 500, group = "Tham chiếu")
bool showMarketStructure = input.bool(true, "Swing / BOS / CHoCH", group = "Vùng và cấu trúc")
bool showLiquidity = input.bool(true, "Pool thanh khoản", group = "Vùng và cấu trúc")
bool showFvg = input.bool(true, "FVG", group = "Vùng và cấu trúc")
bool showOrderBlocks = input.bool(true, "Order block", group = "Vùng và cấu trúc")
bool showInducement = input.bool(false, "Pivot hồi IDM (heuristic)", group = "Vùng và cấu trúc")
bool showZoneQuality = input.bool(false, "Độ rộng vùng / ATR", group = "Vùng và cấu trúc")
bool showZoneLabels = input.bool(true, "Tên vùng", group = "Vùng và cấu trúc")
