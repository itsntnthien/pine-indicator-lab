var int c16c02SwingLowConfirmationTime = na
var C16C02Snapshot c16c02Snapshot = C16C02Snapshot.new(false, na, na, na, na, na, na, na, false, na, na, na, na, na, na, na, confirmationTfMinutes, na, anchorTfMinutes, na)
