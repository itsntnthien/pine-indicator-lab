var bool anchorCommittedValid = false
var int officialBias = BIAS_NEUTRAL
var int pendingBias = BIAS_NEUTRAL
var int pendingBiasCount = 0
var int dowPrimaryTrend = DOW_TREND_UNAVAILABLE
var int dowSecondaryTrend = DOW_TREND_UNAVAILABLE
var int dowExecutionTrend = DOW_TREND_UNAVAILABLE
var int dowAlignmentState = DOW_ALIGNMENT_UNAVAILABLE
var bool dowValid = false
var int dowReason = DOW_REASON_WARMUP
var int dowPrimarySourceBar = -1
var int dowSecondarySourceBar = -1
var int dowExecutionSourceBar = -1
var int dowCountertrendSeverityBuy = 0
var int dowCountertrendSeveritySell = 0
var int dowContextEffectBuy = DOW_NEUTRAL
var int dowContextEffectSell = DOW_NEUTRAL
bool confirmationBucketCommitted = false
bool anchorBucketCommitted = false
bool committedStateUpdated = false
if barstate.isconfirmed
    committedStateUpdated := supportedTf
    int smcPriorSwingHighTicks = c16c02SwingHighTicks
    int smcPriorSwingLowTicks = c16c02SwingLowTicks
    bool smcPriorSwingHighConsumed = smcSwingHighConsumed
    bool smcPriorSwingLowConsumed = smcSwingLowConsumed
    if smcCalculationTf
        committedEmaFast := shadowEmaFast
        committedEmaSlow := shadowEmaSlow
        committedAtr := math.max(shadowAtr, 0.000000000001)
        committedPreviousClose := close
        committedFeatureBars += 1
        array.push(committedHighs, high)
        array.push(committedLows, low)
