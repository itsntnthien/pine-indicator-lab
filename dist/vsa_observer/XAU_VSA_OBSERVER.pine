int smcFvgDisplayLimit = input.int(3, "Số FVG hiển thị", minval = 1, maxval = 5, group = "Vùng và cấu trúc")
int smcObDisplayLimit = input.int(3, "Số OB hiển thị", minval = 1, maxval = 5, group = "Vùng và cấu trúc")
bool enableContextAlerts = input.bool(false, "Cảnh báo sự kiện khi đóng nến", group = "Thông báo")
// The classifier preserves the original mutually-exclusive bar-pattern thresholds.
f_obs_vsa(bool valid, float rv, float rr, float loc, float delta, bool belowBoth) =>
    not valid ? 99 : rv >= 1.5 and rr >= 1.2 and delta > 0 and loc >= 0.7 ? 1 : rv >= 1.5 and rr >= 1.2 and delta < 0 and loc <= 0.3 ? -1 : rv >= 1.5 and rr <= 0.8 and loc >= 0.65 ? 2 : rv >= 1.5 and rr <= 0.8 and loc <= 0.35 ? -2 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta < 0 and loc >= 0.5 ? 3 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta > 0 and loc <= 0.5 ? -3 : 0
f_obs_expired(int age, int ttl) =>
    age > ttl
f_obs_candle_direction(float o, float c) =>
    math.sign(c - o)
f_obs_label_above(int sweep, int vsa) =>
    sweep != 0 ? sweep == -1 or sweep == 2 : vsa < 0

