                        else if item.side == DIR_BEARISH
                            latestUpthrustConfirmBar := math.max(latestUpthrustConfirmBar, item.sweep_confirmation_bar)
            bool wyckoffRegimeEligible = committedRegime >= REGIME_RANGE_FORMING and committedRegime <= REGIME_TRANSITION
            int nextWyckoffLeaning = not wyckoffRegimeEligible ? WYCKOFF_LEANING_NEUTRAL : latestSpringConfirmBar > latestUpthrustConfirmBar ? WYCKOFF_LEANING_ACCUMULATION : latestUpthrustConfirmBar > latestSpringConfirmBar ? WYCKOFF_LEANING_DISTRIBUTION : WYCKOFF_LEANING_NEUTRAL
            if nextWyckoffLeaning != wyckoffLeaning
                wyckoffLeaningSourceBar := smcCanonicalBarIndex
            wyckoffLeaning := nextWyckoffLeaning
            springEvent := wyckoffRegimeEligible and springSweepCreationId != -1
            springFresh := springEvent
            springSourceBar := springEvent ? smcCanonicalBarIndex : -1
            springConfirmBar := springEvent ? smcCanonicalBarIndex : -1
            springReferenceId := springEvent ? "1:-1:" + str.tostring(springSweepCreationId) + ":" + str.tostring(springSweepCreationBar) : "-1:0:-1:-1"
            upthrustEvent := wyckoffRegimeEligible and upthrustSweepCreationId != -1
            upthrustFresh := upthrustEvent
            upthrustSourceBar := upthrustEvent ? smcCanonicalBarIndex : -1
            upthrustConfirmBar := upthrustEvent ? smcCanonicalBarIndex : -1
            upthrustReferenceId := upthrustEvent ? "1:1:" + str.tostring(upthrustSweepCreationId) + ":" + str.tostring(upthrustSweepCreationBar) : "-1:0:-1:-1"
            bool wyckoffDualFresh = springFresh and upthrustFresh
            int vwLatestSweep = math.max(latestSpringConfirmBar, latestUpthrustConfirmBar)
            bool vwWyRecent = wyckoffRegimeEligible and vwLatestSweep >= 0 and smcCanonicalBarIndex - vwLatestSweep <= 10
            int vwWyDirection = wyckoffDualFresh or not vwWyRecent ? 0 : latestSpringConfirmBar > latestUpthrustConfirmBar ? DIR_BULLISH : latestUpthrustConfirmBar > latestSpringConfirmBar ? DIR_BEARISH : DIR_NEUTRAL
            wyckoffEffectBuy := wyckoffDualFresh ? WYCKOFF_NEUTRAL : springFresh or wyckoffLeaning == WYCKOFF_LEANING_ACCUMULATION ? WYCKOFF_SUPPORT : upthrustFresh or wyckoffLeaning == WYCKOFF_LEANING_DISTRIBUTION ? WYCKOFF_CONFLICT : WYCKOFF_NEUTRAL
            wyckoffEffectSell := wyckoffDualFresh ? WYCKOFF_NEUTRAL : upthrustFresh or wyckoffLeaning == WYCKOFF_LEANING_DISTRIBUTION ? WYCKOFF_SUPPORT : springFresh or wyckoffLeaning == WYCKOFF_LEANING_ACCUMULATION ? WYCKOFF_CONFLICT : WYCKOFF_NEUTRAL
            wyckoffValid := true
            wyckoffReason := wyckoffRegimeEligible ? WYCKOFF_REASON_NONE : WYCKOFF_REASON_REGIME_INELIGIBLE
    officialBias := evaluatedOfficialBias

// Fixed observation contract: reversal after a sweep, valid through age 10 inclusive.
int SETUP_MAX_AGE = 10
type SweepRecord
    int bar = na
    int stamp = na
    float level = na
    float extreme = na
    bool invalid = false

method update(SweepRecord this, int side, float level, float extreme, int bar, int stamp, float candleClose) =>
    if not na(level)
        this.bar := bar
        this.stamp := stamp
        this.level := level
        this.extreme := extreme
        this.invalid := false
    else if not na(this.bar)
        this.invalid := this.invalid or (side == 1 ? candleClose < this.extreme : candleClose > this.extreme)

method age(SweepRecord this, int bar) =>
    na(this.bar) ? -1 : bar - this.bar

f_setup_structure(int side, int trend, int eventType, int eventTime, int sweepTime) =>
    not na(sweepTime) and not na(eventTime) and eventTime >= sweepTime and trend == side and math.sign(eventType) == side

// Additive flags keep every blocking reason available to the dashboard and audit.
f_setup_mask(int age, bool invalid, bool oppositeRecent, bool structure, bool htf, bool vsa, bool extended, bool dataReady) =>
    (dataReady ? 0 : 1) + (age < 0 ? 2 : 0) + (age > SETUP_MAX_AGE ? 4 : 0) + (invalid ? 8 : 0) + (oppositeRecent ? 16 : 0) + (structure ? 0 : 32) + (htf ? 0 : 64) + (vsa ? 0 : 128) + (extended ? 256 : 0)
f_setup_has(int mask, int flag) =>
    int(math.floor(mask / flag)) % 2 == 1
// Stage is independent of the optional evidence; invalidation remains latched.
f_setup_phase(int mask) =>
    f_setup_has(mask, 8) ? 5 : f_setup_has(mask, 4) ? 6 : f_setup_has(mask, 2) ? 0 : f_setup_has(mask, 16) ? 4 : f_setup_has(mask, 32) ? 1 : mask == 0 ? 3 : 2
f_setup_phase_text(int phase) =>
    phase == 5 ? "Đã vô hiệu" : phase == 6 ? "Quét đã hết hạn" : phase == 4 ? "Quét hai phía · chờ" : phase == 3 ? "Điều kiện hội tụ" : phase == 2 ? "Cấu trúc xác nhận" : phase == 1 ? "Đã quét · chờ cấu trúc" : "Chưa ghi nhận quét"
f_setup_zone(int side, float price, float atr) =>
    float bestDistance = na
    int bestId = na
    string kind = ""
    bool touched = false
    for z in smcFvgs
        if not z.terminal and z.side == side
            float distance = math.max(z.bottom_ticks * syminfo.mintick - price, math.max(price - z.top_ticks * syminfo.mintick, 0.0))
            if na(bestDistance) or distance < bestDistance or (distance == bestDistance and z.creation_sequence_id > bestId)
                bestDistance := distance
                bestId := z.creation_sequence_id
                kind := "FVG"
                touched := z.mitigated
    for z in smcObs
        if not z.terminal and z.side == side
            float distance = math.max(z.bottom_ticks * syminfo.mintick - price, math.max(price - z.top_ticks * syminfo.mintick, 0.0))
            if na(bestDistance) or distance < bestDistance or (distance == bestDistance and z.creation_sequence_id > bestId)
                bestDistance := distance
                bestId := z.creation_sequence_id
                kind := "OB"
                touched := z.mitigated
    int location = na(bestDistance) or na(atr) or atr <= 0 ? 0 : bestDistance == 0 ? 1 : bestDistance <= 0.5 * atr ? 2 : 3
    string description = location == 0 ? "Chưa có vùng" : (location == 1 ? "Trong " : location == 2 ? "Gần " : "Xa ") + kind + (touched ? " · đã chạm" : " · chưa chạm")
    [description, location, bestId, bestDistance]
f_setup_status(int mask) =>
    f_setup_has(mask, 8) ? "VÔ HIỆU" : f_setup_has(mask, 4) ? "HẾT HẠN" : f_setup_has(mask, 1) ? "THIẾU DỮ LIỆU" : f_setup_has(mask, 2) ? "CHƯA CÓ QUÉT" : f_setup_has(mask, 16) ? "HAI PHÍA / CHỜ" : mask == 0 ? "ĐỦ TIÊU CHÍ" : "CHỜ XÁC NHẬN"
f_setup_reason(int mask) =>
    f_setup_has(mask, 8) ? "Đóng vượt cực trị quét\nChờ một lần quét mới" : f_setup_has(mask, 4) ? "Quét đã quá 10 nến\nChờ một lần quét mới" : f_setup_has(mask, 1) ? "Thiếu volume / ATR\nChưa đánh giá đủ" : f_setup_has(mask, 2) ? "Chưa có quét được xác nhận" : f_setup_has(mask, 16) ? "Hai phía cùng có quét gần\nBối cảnh chưa rõ" : f_setup_has(mask, 32) ? "Chờ BOS/CHoCH thuận\nsau lần quét" : f_setup_has(mask, 64) ? "Chờ hai nến HTF\ncùng thuận hướng" : f_setup_has(mask, 128) ? "Chờ mẫu VSA thuận\ntrên nến đã đóng" : f_setup_has(mask, 256) ? "Giá xa EMA > 2.5 ATR\nTránh đánh giá khi đuổi giá" : "Quét + cấu trúc xác nhận\nHTF và VSA cùng thuận"
f_setup_reasons(int mask) =>
    string reasons = ""
    reasons += f_setup_has(mask, 1) ? "• Thiếu dữ liệu volume / ATR / warmup\n" : ""
    reasons += f_setup_has(mask, 2) ? "• Chưa ghi nhận quét ở phía này\n" : ""
    reasons += f_setup_has(mask, 4) ? "• Quét quá 10 nến\n" : ""
    reasons += f_setup_has(mask, 8) ? "• Đã có nến đóng vượt cực trị quét\n" : ""
    reasons += f_setup_has(mask, 16) ? "• Phía đối diện cũng có quét còn hiệu lực\n" : ""
    reasons += f_setup_has(mask, 32) ? "• Chưa có BOS/CHoCH thuận sau quét\n" : ""
    reasons += f_setup_has(mask, 64) ? "• Hai thân nến HTF chưa cùng thuận / thiếu HTF\n" : ""
    reasons += f_setup_has(mask, 128) ? "• VSA nến chốt chưa ủng hộ\n" : ""
    reasons += f_setup_has(mask, 256) ? "• Khoảng cách EMA vượt 2.5 ATR\n" : ""
    mask == 0 ? "Tất cả tiêu chí quan sát đạt. Chưa đánh giá spread, fill hoặc lợi nhuận." : reasons

f_smc_select_liquidity(array<Liquidity> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                Liquidity item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.swept) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemPrice = f_ticks_to_price(item.level_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.abs(itemPrice - price) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.swept ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_fvgs(array<FVG> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                FVG item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_obs(array<OrderBlock> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                OrderBlock item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_render_smc_objects(array<line> smcStructureRenderLines, array<line> smcLiquidityRenderLines, array<box> smcFvgRenderBoxes, array<box> smcObRenderBoxes, label priorStructureLabel, C16C02Snapshot c16c02Snapshot, StructuralEvent smcLatestStructure, array<Liquidity> smcLiquidity, array<FVG> smcFvgs, array<OrderBlock> smcObs, int smcCanonicalBarIndex, int inducementTicks, int inducementTime, int inducementSide, float smcRenderPrice, float smcRenderAtr, int liquidityLimit, int fvgLimit, int obLimit, bool showMarketStructure, bool showLiquidity, bool showFvg, bool showOrderBlocks, bool showInducement, bool showZoneQuality, bool showZoneLabels, bool showOnlyActiveZones) =>
    array<int> selectedLiquidity = f_smc_select_liquidity(smcLiquidity, smcRenderPrice, smcRenderAtr, showLiquidity ? liquidityLimit : 0, showOnlyActiveZones)
    array<int> selectedFvgs = f_smc_select_fvgs(smcFvgs, smcRenderPrice, smcRenderAtr, showFvg ? fvgLimit : 0, showOnlyActiveZones)
    array<int> selectedObs = f_smc_select_obs(smcObs, smcRenderPrice, smcRenderAtr, showOrderBlocks ? obLimit : 0, showOnlyActiveZones)
    while array.size(smcStructureRenderLines) > 0
        line.delete(array.pop(smcStructureRenderLines))
    while array.size(smcLiquidityRenderLines) > 0
        line.delete(array.pop(smcLiquidityRenderLines))
    while array.size(smcFvgRenderBoxes) > 0
        box.delete(array.pop(smcFvgRenderBoxes))
    while array.size(smcObRenderBoxes) > 0
        box.delete(array.pop(smcObRenderBoxes))
    label nextStructureLabel = priorStructureLabel
    if not na(nextStructureLabel)
        label.delete(nextStructureLabel)
        nextStructureLabel := na
    if showMarketStructure
        if not na(c16c02Snapshot.swing_high_ticks) and not na(c16c02Snapshot.swing_high_source_time)
            line smcSwingHighLine = line.new(c16c02Snapshot.swing_high_confirmation_time, f_ticks_to_price(c16c02Snapshot.swing_high_ticks, syminfo.mintick), time, f_ticks_to_price(c16c02Snapshot.swing_high_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(color.rgb(210, 55, 70), 18), style = line.style_dashed, width = 2)
            array.push(smcStructureRenderLines, smcSwingHighLine)
        if not na(c16c02Snapshot.swing_low_ticks) and not na(c16c02Snapshot.swing_low_source_time)
            line smcSwingLowLine = line.new(c16c02Snapshot.swing_low_confirmation_time, f_ticks_to_price(c16c02Snapshot.swing_low_ticks, syminfo.mintick), time, f_ticks_to_price(c16c02Snapshot.swing_low_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(color.rgb(0, 145, 125), 18), style = line.style_dashed, width = 2)
            array.push(smcStructureRenderLines, smcSwingLowLine)
        if smcLatestStructure.event_type != SE_NONE and not na(smcLatestStructure.price_ticks) and not na(smcLatestStructure.time)
            bool smcStructureBullish = smcLatestStructure.event_type == SE_BOS_BULLISH or smcLatestStructure.event_type == SE_CHOCH_BULLISH
            string smcStructureText = smcLatestStructure.event_type == SE_BOS_BULLISH ? "BOS ↑" : smcLatestStructure.event_type == SE_BOS_BEARISH ? "BOS ↓" : smcLatestStructure.event_type == SE_CHOCH_BULLISH ? "CHoCH ↑" : "CHoCH ↓"
            nextStructureLabel := label.new(smcLatestStructure.time, f_ticks_to_price(smcLatestStructure.price_ticks, syminfo.mintick) + (smcStructureBullish ? -1 : 1) * nz(smcRenderAtr) * 0.35, smcStructureText, xloc = xloc.bar_time, yloc = yloc.price, style = smcStructureBullish ? label.style_label_up : label.style_label_down, color = color.new(smcStructureBullish ? color.rgb(0, 145, 125) : color.rgb(210, 55, 70), 8), textcolor = color.white, size = size.tiny, tooltip = "Confirmed market-structure event\n" + smcStructureText + "\nLevel: " + f_c08_price_text(smcLatestStructure.price_ticks))
        if showInducement and not na(inducementTicks) and not na(inducementTime)
            bool inducementBullish = inducementSide == DIR_BULLISH
            line smcInducementLine = line.new(inducementTime, f_ticks_to_price(inducementTicks, syminfo.mintick), time, f_ticks_to_price(inducementTicks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(inducementBullish ? color.rgb(0, 145, 125) : color.rgb(210, 55, 70), 20), style = line.style_dotted, width = 1)
            array.push(smcStructureRenderLines, smcInducementLine)
    if showLiquidity and array.size(smcLiquidity) > 0
        for smcRenderIndex = 0 to array.size(smcLiquidity) - 1
            Liquidity smcLiquidityItem = array.get(smcLiquidity, smcRenderIndex)
            if array.includes(selectedLiquidity, smcLiquidityItem.creation_sequence_id)
                int smcLiquidityLeft = smcLiquidityItem.creation_time
                bool smcLiquidityHighSide = smcLiquidityItem.side == DIR_BEARISH
                color smcLiquidityColor = smcLiquidityHighSide ? color.rgb(225, 65, 75) : color.rgb(0, 165, 145)
                line smcLiquidityLine = line.new(smcLiquidityLeft, f_ticks_to_price(smcLiquidityItem.level_ticks, syminfo.mintick), time, f_ticks_to_price(smcLiquidityItem.level_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, color = color.new(smcLiquidityColor, smcLiquidityItem.swept ? 62 : 5), style = smcLiquidityItem.swept ? line.style_dotted : line.style_solid, width = 1)
                array.push(smcLiquidityRenderLines, smcLiquidityLine)
    if showFvg and array.size(smcFvgs) > 0
        for smcRenderIndex = 0 to array.size(smcFvgs) - 1
            FVG smcFvgItem = array.get(smcFvgs, smcRenderIndex)
            if array.includes(selectedFvgs, smcFvgItem.creation_sequence_id)
                int smcFvgLeft = smcFvgItem.creation_time
                color smcFvgBaseColor = smcFvgItem.side == DIR_BULLISH ? color.rgb(0, 160, 190) : color.rgb(230, 135, 20)
                color smcFvgColor = color.new(smcFvgBaseColor, smcFvgItem.mitigated ? 95 : 89)
                string smcFvgWidthText = showZoneQuality and not na(smcRenderAtr) and smcRenderAtr > 0 ? " / " + str.tostring((smcFvgItem.top_ticks - smcFvgItem.bottom_ticks) * syminfo.mintick / smcRenderAtr, "#.##") + " ATR" : ""
                string smcFvgText = showZoneLabels ? (smcFvgItem.side == DIR_BULLISH ? "FVG ▲" : "FVG ▼") + (smcFvgItem.mitigated ? " · chạm" : "") + smcFvgWidthText : ""
                box smcFvgBox = box.new(left = smcFvgLeft, top = f_ticks_to_price(smcFvgItem.top_ticks, syminfo.mintick), right = time, bottom = f_ticks_to_price(smcFvgItem.bottom_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(smcFvgBaseColor, smcFvgItem.mitigated ? 65 : 8), border_width = 1, bgcolor = smcFvgColor, text = smcFvgText, text_color = color.new(chart.fg_color, smcFvgItem.mitigated ? 35 : 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
                array.push(smcFvgRenderBoxes, smcFvgBox)
    if showOrderBlocks and array.size(smcObs) > 0
        for smcRenderIndex = 0 to array.size(smcObs) - 1
            OrderBlock smcObItem = array.get(smcObs, smcRenderIndex)
            if array.includes(selectedObs, smcObItem.creation_sequence_id)
                int smcObLeft = smcObItem.creation_time
                color smcObBaseColor = smcObItem.side == DIR_BULLISH ? color.rgb(35, 125, 210) : color.rgb(185, 70, 155)
                color smcObColor = color.new(smcObBaseColor, smcObItem.mitigated ? 95 : 90)
                string smcObWidthText = showZoneQuality and not na(smcRenderAtr) and smcRenderAtr > 0 ? " / " + str.tostring((smcObItem.top_ticks - smcObItem.bottom_ticks) * syminfo.mintick / smcRenderAtr, "#.##") + " ATR" : ""
                string smcObText = showZoneLabels ? (smcObItem.side == DIR_BULLISH ? "OB ▲" : "OB ▼") + (smcObItem.mitigated ? " · chạm" : "") + smcObWidthText : ""
                box smcObBox = box.new(left = smcObLeft, top = f_ticks_to_price(smcObItem.top_ticks, syminfo.mintick), right = time, bottom = f_ticks_to_price(smcObItem.bottom_ticks, syminfo.mintick), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(smcObBaseColor, smcObItem.mitigated ? 68 : 10), border_width = 1, bgcolor = smcObColor, text = smcObText, text_color = color.new(chart.fg_color, smcObItem.mitigated ? 35 : 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
                array.push(smcObRenderBoxes, smcObBox)
    nextStructureLabel
bool smcRendererRefresh = barstate.islast
if smcRendererRefresh
    bool smcShowObservation = false
    smcStructureRenderLabel := f_render_smc_objects(smcStructureRenderLines, smcLiquidityRenderLines, smcFvgRenderBoxes, smcObRenderBoxes, smcStructureRenderLabel, c16c02Snapshot, smcLatestStructure, smcLiquidity, smcFvgs, smcObs, smcCanonicalBarIndex, smcLatestInducementTicks, smcLatestInducementTime, smcLatestInducementSide, committedPreviousClose, committedAtr, smcLiquidityDisplayLimit, smcFvgDisplayLimit, smcObDisplayLimit, showMarketStructure or smcShowObservation, showLiquidity or smcShowObservation, showFvg or smcShowObservation, showOrderBlocks or smcShowObservation, showInducement, showZoneQuality, showZoneLabels, showOnlyActiveZones)
    smcLastRendererBar := bar_index

// All observations below describe the last CLOSED standard candle.
var int obsTime = na
var int obsVsa = 99
var float obsRv = na
var float obsRr = na
var float obsLocation = na
var float obsEma = na
var float obsDistance = na
var float obsAtr = na
var float obsClose = na
var int obsSweep = 0
var int obsLastEventTime = na
var string obsLastEvent = "Chưa có sự kiện"
var string obsSession = "N/A"
var SweepRecord obsLowSweep = SweepRecord.new()
var SweepRecord obsHighSweep = SweepRecord.new()
var int obsLongMask = 1
var int obsShortMask = 1
var bool obsLongStructure = false
var bool obsShortStructure = false
var bool obsContextReady = false
var string obsLongZone = "Chưa có vùng"
var string obsShortZone = "Chưa có vùng"
var int obsLongZoneCode = 0
var int obsShortZoneCode = 0
var int obsLongZoneId = na
var int obsShortZoneId = na
var int obsConfDirection = 0
var int obsAnchorDirection = 0
var int obsLastLabelBar = -100
var int obsLastLabelCode = 99
string obsCurrentSession = f_observer_session(timeframe.period)
var array<label> obsLabels = array.new<label>()
int obsRawVsa = f_obs_vsa(vwValid, vwRelativeVolume, vwRelativeRange, vwCloseLocation, close - close[1], volume < volume[1] and volume < volume[2])
f_obs_vsa_text(int code) =>
    code == 99 ? "N/A: thiếu volume / warmup / biên nến" : code == 1 ? "Volume cao • nến rộng, đóng cao" : code == -1 ? "Volume cao • nến rộng, đóng thấp" : code == 2 ? "Nỗ lực lớn, biên hẹp • đóng cao" : code == -2 ? "Nỗ lực lớn, biên hẹp • đóng thấp" : code == 3 ? "No Supply? • mẫu volume thấp" : code == -3 ? "No Demand? • mẫu volume thấp" : "Không có mẫu VSA nổi bật"
f_obs_dir(int direction) =>
    direction > 0 ? "TĂNG" : direction < 0 ? "GIẢM" : "CHƯA RÕ"
f_obs_num(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##")
f_obs_price(float value) =>
    na(value) ? "N/A" : str.tostring(value, format.mintick)
bool obsClosed = barstate.isconfirmed and smcCalculationTf
if obsClosed
    obsTime := time_close
    obsSession := obsCurrentSession
    obsVsa := obsRawVsa
    obsRv := vwRelativeVolume
    obsRr := vwRelativeRange
    obsLocation := vwCloseLocation
    obsEma := ema200
    obsAtr := inspectorAtr
    obsClose := close
    obsDistance := not na(inspectorAtr) and inspectorAtr > 0 ? (close - ema200) / inspectorAtr : na
    obsLowSweep.update(1, smcSweptLowLevel, low, smcCanonicalBarIndex, time, close)
    obsHighSweep.update(-1, smcSweptHighLevel, high, smcCanonicalBarIndex, time, close)
    int lowAge = obsLowSweep.age(smcCanonicalBarIndex)
    int highAge = obsHighSweep.age(smcCanonicalBarIndex)
    bool lowRecent = lowAge >= 0 and lowAge <= SETUP_MAX_AGE and not obsLowSweep.invalid
    bool highRecent = highAge >= 0 and highAge <= SETUP_MAX_AGE and not obsHighSweep.invalid
    obsSweep := not na(smcSweptLowLevel) and not na(smcSweptHighLevel) ? 2 : not na(smcSweptLowLevel) ? 1 : not na(smcSweptHighLevel) ? -1 : 0
    obsLongStructure := f_setup_structure(1, smcTrend, smcLatestStructure.event_type, smcLatestStructure.time, obsLowSweep.stamp)
    obsShortStructure := f_setup_structure(-1, smcTrend, smcLatestStructure.event_type, smcLatestStructure.time, obsHighSweep.stamp)
    obsContextReady := supportedTf and confCommittedValid and anchorCommittedValid
    obsConfDirection := obsContextReady ? int(f_obs_candle_direction(confCommittedO, confCommittedC)) : 0
    obsAnchorDirection := obsContextReady ? int(f_obs_candle_direction(anchorCommittedO, anchorCommittedC)) : 0
    bool dataReady = vwValid and not na(inspectorAtr) and inspectorAtr > 0 and committedFeatureBars >= WARMUP_BARS
    bool extended = not na(obsDistance) and math.abs(obsDistance) > 2.5
    obsLongMask := f_setup_mask(lowAge, obsLowSweep.invalid, lowRecent and highRecent, obsLongStructure, obsContextReady and obsConfDirection == 1 and obsAnchorDirection == 1, obsVsa != 99 and obsVsa > 0, extended, dataReady)
    obsShortMask := f_setup_mask(highAge, obsHighSweep.invalid, lowRecent and highRecent, obsShortStructure, obsContextReady and obsConfDirection == -1 and obsAnchorDirection == -1, obsVsa != 99 and obsVsa < 0, extended, dataReady)
    [longZone, longZoneCode, longZoneId, longZoneDistance] = f_setup_zone(1, close, inspectorAtr)
    [shortZone, shortZoneCode, shortZoneId, shortZoneDistance] = f_setup_zone(-1, close, inspectorAtr)
    obsLongZone := longZone
    obsShortZone := shortZone
    obsLongZoneCode := longZoneCode
    obsShortZoneCode := shortZoneCode
    obsLongZoneId := longZoneId
    obsShortZoneId := shortZoneId
    string eventText = obsSweep == 2 ? "Quét hai phía" : obsSweep == 1 ? "Quét đáy • lấy lại mức" : obsSweep == -1 ? "Quét đỉnh • lấy lại mức" : ""
    if obsVsa != 0 and obsVsa != 99
        eventText += (eventText == "" ? "" : "\n") + f_obs_vsa_text(obsVsa)
    if eventText != ""
        obsLastEvent := eventText
        obsLastEventTime := time_close
        if showVsaEvents and (obsSweep != 0 or (showVsaDetails and (obsVsa != obsLastLabelCode or smcCanonicalBarIndex - obsLastLabelBar >= 3)))
            bool above = f_obs_label_above(obsSweep, obsVsa)
            color eventColor = obsSweep == 2 ? color.orange : above ? color.rgb(176, 73, 103) : color.rgb(0, 122, 125)
            float labelGap = math.max(nz(inspectorAtr, high - low) * 0.18, syminfo.mintick * 3)
            label mark = label.new(time, above ? high + labelGap : low - labelGap, obsSweep != 0 ? (obsSweep == 2 ? "Quét hai phía" : obsSweep == 1 ? "Quét đáy" : "Quét đỉnh") : (math.abs(obsVsa) == 1 ? "V↑ R↑" : math.abs(obsVsa) == 2 ? "V↑ R↓" : "V↓ R↓"), xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up, color = color.new(eventColor, 20), textcolor = color.white, size = size.tiny, tooltip = eventText + "\nChốt: " + str.format_time(time_close, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " VN\nRV: " + f_obs_num(obsRv) + " • Range: " + f_obs_num(obsRr) + "\nMẫu OHLC/volume; không xác nhận dòng tiền tổ chức.")
            array.push(obsLabels, mark)
            obsLastLabelBar := smcCanonicalBarIndex
            obsLastLabelCode := obsVsa
    while array.size(obsLabels) > eventLimit
        label.delete(array.shift(obsLabels))

color obsCandleColor = obsClosed and colorVsaBars and obsVsa != 0 and obsVsa != 99 ? (obsVsa > 0 ? color.aqua : color.fuchsia) : na
barcolor(obsCandleColor, title = "Mẫu VSA đã đóng")
plot(showEma and smcCalculationTf ? obsEma : na, "EMA đã đóng", color = color.new(color.blue, 20), linewidth = 2)
float obsCloudCenter = (committedEmaFast + committedEmaSlow) / 2
bool obsCloudValid = showCloudContext and smcCalculationTf and committedFeatureBars >= WARMUP_BARS
obsCloudUpper = plot(obsCloudValid ? obsCloudCenter + committedAtr * 0.5 : na, "Dải EMA trên", color = color.new(color.gray, 70), style = plot.style_linebr)
obsCloudLower = plot(obsCloudValid ? obsCloudCenter - committedAtr * 0.5 : na, "Dải EMA dưới", color = color.new(color.gray, 70), style = plot.style_linebr)
fill(obsCloudUpper, obsCloudLower, color = color.new(color.gray, 93), title = "Dải tham chiếu")

color obsGood = color.rgb(58, 210, 174)
color obsWait = color.rgb(245, 197, 105)
color obsMuted = color.rgb(187, 197, 210)
string obsFont = panelFont == "Vừa" ? size.normal : size.small
int obsRowShift = panelPosition == "Trên phải" ? 1 : 0
var table obsPanel = table.new(panelPosition == "Trên phải" ? position.top_right : panelPosition == "Dưới phải" ? position.bottom_right : position.bottom_left, 2, 7, frame_width = 0, border_width = 0)
f_obs_cell(int col, int row, string content, color tone = color.white, string hint = "") =>
    table.cell(obsPanel, col, row + obsRowShift, content, text_color = tone, bgcolor = row == 0 ? color.rgb(27, 43, 57) : color.rgb(22, 32, 44), text_size = row == 5 ? size.small : obsFont, text_halign = text.align_left, tooltip = hint)
f_obs_brief(int mask, int side) =>
    int stage = f_setup_phase(mask)
    string pending = f_setup_has(mask, 1) ? "thiếu dữ liệu" : f_setup_has(mask, 64) ? "chờ HTF" : f_setup_has(mask, 128) ? "chờ VSA" : "xa EMA"
    not supportedTf ? "Khung chưa hỗ trợ" : stage == 2 ? "Cấu trúc ✓ · " + pending : f_setup_phase_text(stage)
f_obs_sweep_row(int row, string title, SweepRecord sweep) =>
    int age = sweep.age(smcCanonicalBarIndex)
    bool fresh = age >= 0 and age <= SETUP_MAX_AGE and not sweep.invalid
    string description = age < 0 ? "Chưa thấy" : sweep.invalid ? "Có · đã mất hiệu lực" : age > SETUP_MAX_AGE ? "Có · đã quá lâu" : age == 0 ? "Vừa quét xong" : "Đã quét · " + str.tostring(age) + " nến trước"
    f_obs_cell(0, row, title, obsMuted)
    f_obs_cell(1, row, description, fresh ? obsGood : obsMuted, age < 0 ? "Chưa ghi nhận trong lịch sử đã nạp." : "Mức đã quét: " + f_obs_price(sweep.level) + "\nTuổi: " + str.tostring(age) + " nến. Có hiệu lực tối đa 10 nến nếu chưa bị phá.\nQuét nghĩa là giá vượt mức rồi đóng nến lấy lại mức đó.")
f_obs_direction_row(int row, int side, int mask, SweepRecord sweep) =>
    string invalidation = na(sweep.extreme) ? "Chưa có mức vô hiệu." : "Mất hiệu lực nếu nến đóng " + (side == 1 ? "dưới " : "trên ") + f_obs_price(sweep.extreme) + "."
    string htfInfo = not supportedTf ? "Khung chưa hỗ trợ setup" : not obsContextReady ? "Thiếu nến HTF đã đóng" : "Thân nến " + confTf + ": " + f_obs_dir(obsConfDirection) + " · " + anchorTf + ": " + f_obs_dir(obsAnchorDirection) + "\nHTF chốt: " + str.format_time(confLastCommittedEnd, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " / " + str.format_time(anchorLastCommittedEnd, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " VN"
    string details = f_setup_phase_text(f_setup_phase(mask)) + "\n" + htfInfo + "\n" + (side == 1 ? obsLongZone : obsShortZone) + "\n" + f_setup_status(mask) + "\n" + f_setup_reasons(mask) + "\n" + invalidation + "\n\nVolume / TB: " + f_obs_num(obsRv) + " lần · Biên / TB: " + f_obs_num(obsRr) + " lần\n" + f_obs_vsa_text(obsVsa) + "\nEMA: " + f_obs_price(obsEma) + " · Cách: " + f_obs_num(obsDistance) + " ATR\nĐủ điều kiện quan sát không phải lệnh vào."
    f_obs_cell(0, row, side == 1 ? "Hồi lên" : "Hồi xuống", obsMuted)
    f_obs_cell(1, row, f_obs_brief(mask, side), mask == 0 ? obsGood : f_setup_has(mask, 8) or f_setup_has(mask, 4) ? obsMuted : obsWait, details)
if barstate.islast
    table.clear(obsPanel, 0, 0, 1, 6)
    if showInspector
        f_obs_cell(0, 0, syminfo.ticker + " · QUAN SÁT", obsGood, syminfo.tickerid + " · " + timeframe.period + "\nMọi đánh giá dùng nến đã đóng.")
        if not smcCalculationTf
            f_obs_cell(0, 1, "Cần dùng nến giá tiêu chuẩn", obsWait)
            table.merge_cells(obsPanel, 0, 1 + obsRowShift, 1, 1 + obsRowShift)
        else if na(obsTime)
            f_obs_cell(0, 1, "Đang chờ đủ dữ liệu", obsWait)
            table.merge_cells(obsPanel, 0, 1 + obsRowShift, 1, 1 + obsRowShift)
        else
            f_obs_sweep_row(1, "Quét đáy", obsLowSweep)
            f_obs_sweep_row(2, "Quét đỉnh", obsHighSweep)
            f_obs_direction_row(3, 1, obsLongMask, obsLowSweep)
            f_obs_direction_row(4, -1, obsShortMask, obsHighSweep)
        f_obs_cell(0, 5, (na(obsTime) ? "Chưa có nến chốt" : "Chốt " + str.format_time(obsTime, "HH:mm", "Asia/Ho_Chi_Minh") + " VN") + (committedFeatureBars < WARMUP_BARS ? " · Đang nạp nền" : " · Rê ô xem lý do"), obsMuted)
        for mergedRow in array.from(0, 5)
            table.merge_cells(obsPanel, 0, mergedRow + obsRowShift, 1, mergedRow + obsRowShift)
        int paddingRow = obsRowShift == 1 ? 0 : 6
        table.cell(obsPanel, 0, paddingRow, "", height = obsRowShift == 1 ? 8 : 5, bgcolor = color.new(color.black, 100))
        table.merge_cells(obsPanel, 0, paddingRow, 1, paddingRow)

bool obsStructureEvent = obsClosed and smcLatestStructure.time == time
alertcondition(enableContextAlerts and obsClosed and obsVsa != 0 and obsVsa != 99, "Mẫu VSA đã đóng", "Mẫu VSA mới trên {{ticker}} {{interval}}; quan sát bối cảnh.")
alertcondition(enableContextAlerts and obsClosed and obsSweep != 0, "Quét thanh khoản đã đóng", "Giá vượt và lấy lại một pool trên {{ticker}} {{interval}}.")
alertcondition(enableContextAlerts and obsStructureEvent, "Thay đổi cấu trúc đã đóng", "BOS/CHoCH được xác nhận trên {{ticker}} {{interval}}.")
plot(obsVsa, "Audit VSA code", display = display.data_window)
plot(obsRv, "RV nến đã đóng", display = display.data_window)
plot(obsRr, "Range ratio nến đã đóng", display = display.data_window)

plot(obsLongMask, "Setup hồi lên: lý do chặn", display = display.data_window)
plot(obsShortMask, "Setup hồi xuống: lý do chặn", display = display.data_window)

plot(f_setup_phase(obsLongMask), "V2 phase long", display = display.data_window)
plot(f_setup_phase(obsShortMask), "V2 phase short", display = display.data_window)
plot(obsLongZoneCode, "V2 zone long", display = display.data_window)
plot(obsShortZoneCode, "V2 zone short", display = display.data_window)
plot(confLastCommittedEnd, "V2 HTF conf end", display = display.data_window)
plot(anchorLastCommittedEnd, "V2 HTF anchor end", display = display.data_window)
