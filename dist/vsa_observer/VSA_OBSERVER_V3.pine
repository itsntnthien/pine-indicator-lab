// Changes: Vietnamese observer context, closed-bar engine, bounded drawing slots.
// Sources, pinned hashes and adapted sections: docs/VSA_OBSERVER_LUX_UI_SOURCES.json
indicator("VSA Observer v3 RC • Cấu trúc & bối cảnh", "VSA OBS v3", overlay = true, behind_chart = false, max_labels_count = 250, max_lines_count = 500, max_boxes_count = 300, max_bars_back = 600)
// Observation derivative of the user's XAU-VSA attachment, 2026-11-17.
string obsMode = input.string("Present", "Mode", options = ["Present", "Historical"], group = "Smart Money Concepts", tooltip = "Present: cấu trúc gần nhất mỗi hướng. Historical: lịch sử đến giới hạn hiển thị. Chỉ thay cách vẽ, không thay dữ liệu tính toán.", display = display.none)
string obsStyle = input.string("Colored", "Style", options = ["Colored", "Monochrome"], group = "Smart Money Concepts", display = display.none)
bool showMarketStructure = input.bool(true, "Swing / BOS / CHoCH", group = "Market Structure", inline = "structure", display = display.none)
int obsStructureLimit = input.int(12, "Lịch sử", minval = 2, maxval = 40, group = "Market Structure", inline = "structure", display = display.none)
color obsBullInput = input.color(#089981, "Bullish", group = "Market Structure", inline = "structureColor", display = display.none)
color obsBearInput = input.color(#f23645, "Bearish", group = "Market Structure", inline = "structureColor", display = display.none)
string chartFont = input.string("Nhỏ", "Label Size", options = ["Rất nhỏ", "Nhỏ", "Vừa"], group = "Market Structure", display = display.none)
bool showInducement = input.bool(false, "Pivot hồi IDM (heuristic)", group = "Market Structure", display = display.none)
bool showLiquidity = input.bool(true, "Pool thanh khoản", group = "Liquidity", inline = "liquidity", display = display.none)
int smcLiquidityDisplayLimit = input.int(2, "Số mức", minval = 1, maxval = 8, group = "Liquidity", inline = "liquidity", display = display.none)
bool showVsaEvents = input.bool(true, "Quét thanh khoản", group = "Liquidity", inline = "sweeps", display = display.none)
int eventLimit = input.int(4, "Số nhãn", minval = 2, maxval = 120, group = "Liquidity", inline = "sweeps", display = display.none)
bool showOrderBlocks = input.bool(true, "Order block", group = "Order Blocks", inline = "ob", display = display.none)
int smcObDisplayLimit = input.int(2, "Số vùng", minval = 1, maxval = 5, group = "Order Blocks", inline = "ob", display = display.none)
color obsObBull = input.color(color.new(#3179f5, 80), "Bullish", group = "Order Blocks", inline = "obColor", display = display.none)
color obsObBear = input.color(color.new(#f77c80, 80), "Bearish", group = "Order Blocks", inline = "obColor", display = display.none)
bool showFvg = input.bool(true, "FVG", group = "Fair Value Gaps", inline = "fvg", display = display.none)
int smcFvgDisplayLimit = input.int(2, "Số vùng", minval = 1, maxval = 5, group = "Fair Value Gaps", inline = "fvg", display = display.none)
color obsFvgBull = input.color(color.new(#00e676, 85), "Bullish", group = "Fair Value Gaps", inline = "fvgColor", display = display.none)
color obsFvgBear = input.color(color.new(#ff5252, 85), "Bearish", group = "Fair Value Gaps", inline = "fvgColor", display = display.none)
bool obsExtendZones = input.bool(true, "Extend vùng sang phải", group = "Zone Style", display = display.none)
bool obsShowMid = input.bool(true, "Đường giữa vùng 50%", group = "Zone Style", tooltip = "Trung điểm hình học của OB/FVG, không phải mức vào lệnh.", display = display.none)
bool showZoneLabels = input.bool(true, "Tên vùng / mức", group = "Zone Style", display = display.none)
bool showZoneQuality = input.bool(false, "Độ rộng vùng / ATR", group = "Zone Style", display = display.none)
bool showOnlyActiveZones = input.bool(true, "Chỉ hiện vùng chưa chạm / pool chưa quét", group = "Zone Style", display = display.none)
bool showInspector = input.bool(true, "Show Dashboard", group = "Dashboard", display = display.none)
string panelPosition = input.string("Giữa trái", "Location", options = ["Giữa trái", "Trên phải", "Dưới phải", "Dưới trái"], group = "Dashboard", tooltip = "Giữa trái tránh nhãn giá ở mép phải và tên symbol ở phía trên khi cửa sổ hẹp.", display = display.none)
string panelFont = input.string("Nhỏ", "Size", options = ["Rất nhỏ", "Nhỏ", "Vừa"], group = "Dashboard", display = display.none)
bool showEma = input.bool(false, "EMA tham chiếu", group = "VSA / Reference", inline = "ema", display = display.none)
int ema200Length = input.int(200, "Chu kỳ", minval = 50, maxval = 500, group = "VSA / Reference", inline = "ema", display = display.none)
bool showCloudContext = input.bool(false, "Dải EMA 8/21 ± 0.5 ATR của lõi gốc", group = "VSA / Reference", display = display.none)
bool showVsaDetails = input.bool(false, "Thêm nhãn VSA", group = "VSA / Reference", display = display.none)
bool colorVsaBars = input.bool(false, "Tô nến có mẫu VSA", group = "VSA / Reference", display = display.none)
bool enableContextAlerts = input.bool(false, "Cảnh báo sự kiện khi đóng nến", group = "Alerts", display = display.none)
string obsChartSize = chartFont == "Vừa" ? size.normal : chartFont == "Nhỏ" ? size.small : size.tiny
bool obsDark = color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color) < 384
color obsUp = obsStyle == "Monochrome" ? #b2b5be : obsBullInput
color obsDown = obsStyle == "Monochrome" ? #5d606b : obsBearInput
color obsAttention = obsDark ? #ffb74d : #b26a00
// The classifier preserves the original mutually-exclusive bar-pattern thresholds.
f_obs_vsa(bool valid, float rv, float rr, float loc, float delta, bool belowBoth) =>
    not valid ? 99 : rv >= 1.5 and rr >= 1.2 and delta > 0 and loc >= 0.7 ? 1 : rv >= 1.5 and rr >= 1.2 and delta < 0 and loc <= 0.3 ? -1 : rv >= 1.5 and rr <= 0.8 and loc >= 0.65 ? 2 : rv >= 1.5 and rr <= 0.8 and loc <= 0.35 ? -2 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta < 0 and loc >= 0.5 ? 3 : rv <= 0.7 and rr <= 0.8 and belowBoth and delta > 0 and loc <= 0.5 ? -3 : 0
f_obs_expired(int age, int ttl) =>
    age > ttl
f_obs_candle_direction(float o, float c) =>
    math.sign(c - o)
f_obs_label_above(int sweep, int vsa) =>
    sweep != 0 ? sweep == -1 or sweep == 2 : vsa < 0

// Confirmed price engine; derivative of the user supplied XAU-VSA core.
int DIR_BEARISH = -1
int DIR_NEUTRAL = 0
int DIR_BULLISH = 1
int SE_CHOCH_BEARISH = -2
int SE_BOS_BEARISH = -1
int SE_NONE = 0
int SE_BOS_BULLISH = 1
int SE_CHOCH_BULLISH = 2
// Max births per bar times the inclusive lifetime; never a display limit.
int LIQUIDITY_CAPACITY = 1002
int FVG_CAPACITY = 251
int OB_CAPACITY = 251
int SWING_LEFT_BARS = 5
int SWING_RIGHT_BARS = 5
int WARMUP_BARS = math.max(21, 3 * ema200Length)
f_to_ticks(price, min_tick) =>
    if na(price) or na(min_tick) or min_tick <= 0
        int(na)
    else
        int(math.round(price / min_tick)) // Pine's round is half-away-from-zero
f_ticks_to_price(ticks, min_tick) =>
    if na(ticks) or na(min_tick)
        float(na)
    else
        ticks * min_tick

type Liquidity
    int side
    int creation_sequence_id
    int creation_bar_index
    int creation_time
    int level_ticks
    bool swept
    bool terminal
    int sweep_confirmation_bar
    int sweep_anchor_ticks
    int source_time = na
    string end_reason = ""

f_c08_price_text(ticks) =>
    str.tostring(ticks * syminfo.mintick, format.mintick)
type StructuralEvent
    int event_type
    int price_ticks
    int time
    float label_price = na
type FVG
    int side
    int creation_sequence_id
    int creation_bar_index
    int creation_time
    int top_ticks
    int bottom_ticks
    bool mitigated
    bool filled
    bool terminal
    int source_time = na
    int first_touch_bar = na
    string end_reason = ""
type OrderBlock
    int side
    int creation_sequence_id
    int creation_bar_index
    int creation_time
    int top_ticks
    int bottom_ticks
    bool mitigated
    bool terminal
    int source_time = na
    int first_touch_bar = na
    string end_reason = ""

// Fixed first-trial rules, not optimized. Missing/zero volume is neutral, never low volume.
float vwVolumeMean = ta.sma(volume[1], 20)
float vwRangeMean = ta.sma(high[1] - low[1], 20)
float ema200 = ta.ema(close, ema200Length)
float inspectorAtr = ta.atr(14)
float vwValidVolumeWindow = ta.sma(not na(volume) and volume > 0 ? 1.0 : 0.0, 21)
bool vwValid = vwValidVolumeWindow == 1 and not na(vwVolumeMean) and vwVolumeMean > 0 and not na(vwRangeMean) and vwRangeMean > 0 and high > low
float vwRelativeVolume = vwValid ? volume / vwVolumeMean : na
float vwRelativeRange = vwValid ? (high - low) / vwRangeMean : na
float vwCloseLocation = vwValid ? (close - low) / (high - low) : na
bool vwHighVolume = vwValid and vwRelativeVolume >= 1.5
bool vwLowVolume = vwValid and vwRelativeVolume <= 0.7
bool vwNarrow = vwValid and vwRelativeRange <= 0.8
bool vwDemand = vwHighVolume and vwRelativeRange >= 1.2 and close > close[1] and vwCloseLocation >= 0.7
bool vwSupply = vwHighVolume and vwRelativeRange >= 1.2 and close < close[1] and vwCloseLocation <= 0.3
// ponytail: bar-pattern proxies, not proof of institutional absorption; validate on native feed.
bool vwAbsorbBuy = vwHighVolume and vwNarrow and vwCloseLocation >= 0.65
bool vwAbsorbSell = vwHighVolume and vwNarrow and vwCloseLocation <= 0.35
bool vwNoSupply = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close < close[1] and vwCloseLocation >= 0.5
bool vwNoDemand = vwLowVolume and vwNarrow and volume < volume[1] and volume < volume[2] and close > close[1] and vwCloseLocation <= 0.5
int vwDirection = (vwDemand or vwAbsorbBuy or vwNoSupply ? 1 : 0) - (vwSupply or vwAbsorbSell or vwNoDemand ? 1 : 0)

f_smc_inducement_value(int field, int trend, bool newLow, bool newHigh, int priorLowTicks, int priorHighTicks, int newLowTicks, int newHighTicks, int newLowTime, int newHighTime, int currentTicks, int currentTime, int currentSide) =>
    bool bullInducement = trend == DIR_BULLISH and newLow and not na(priorLowTicks) and not na(newLowTicks) and newLowTicks > priorLowTicks
    bool bearInducement = trend == DIR_BEARISH and newHigh and not na(priorHighTicks) and not na(newHighTicks) and newHighTicks < priorHighTicks
    field == 0 ? bullInducement ? newLowTicks : bearInducement ? newHighTicks : currentTicks : field == 1 ? bullInducement ? newLowTime : bearInducement ? newHighTime : currentTime : bullInducement or bearInducement ? (bullInducement ? DIR_BULLISH : DIR_BEARISH) : currentSide
f_observer_session(string timeframeText) =>
    bool london = not na(time(timeframeText, "0800-1700:23456", "Europe/London"))
    bool newYork = not na(time(timeframeText, "0800-1700:23456", "America/New_York"))
    london and newYork ? "OVERLAP" : london ? "LONDON" : newYork ? "NEW YORK" : "OUTSIDE"
bool showUpperCloud = showCloudContext

bool supportedTf = chart.is_standard and timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 3 or timeframe.multiplier == 5 or timeframe.multiplier == 15 or timeframe.multiplier == 30 or timeframe.multiplier == 60 or timeframe.multiplier == 240)
// Unsupported standard intervals retain price observations, without setup confluence.
bool smcObservationTf = chart.is_standard and (timeframe.isseconds or timeframe.isminutes or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
bool smcCalculationTf = supportedTf or smcObservationTf
bool smcObservationMode = not supportedTf and smcObservationTf
int chartTfMinutes = supportedTf ? timeframe.multiplier : 0

int confirmationTfMinutes = chartTfMinutes == 1 ? 5 : chartTfMinutes == 3 ? 15 : chartTfMinutes == 5 ? 15 : chartTfMinutes == 15 or chartTfMinutes == 30 ? 60 : chartTfMinutes == 60 ? 240 : chartTfMinutes == 240 ? 1440 : 0
int anchorTfMinutes = chartTfMinutes == 1 ? 15 : chartTfMinutes == 3 ? 60 : chartTfMinutes == 5 ? 60 : chartTfMinutes == 15 or chartTfMinutes == 30 ? 240 : chartTfMinutes == 60 ? 1440 : chartTfMinutes == 240 ? 10080 : 0
int chartTfMs = chartTfMinutes * 60000
int confirmationTfMs = confirmationTfMinutes * 60000
int anchorTfMs = anchorTfMinutes * 60000
int confirmationExpectedBars = supportedTf ? int(confirmationTfMinutes / chartTfMinutes) : 0
int anchorExpectedBars = supportedTf ? int(anchorTfMinutes / chartTfMinutes) : 0
var float committedEmaFast = na
var float committedEmaSlow = na
var float committedAtr = na
var float committedPreviousClose = na
var int committedFeatureBars = 0
float fastAlpha = 2.0 / 9.0
float slowAlpha = 2.0 / 22.0
float atrAlpha = 1.0 / 14.0
float currentTrueRange = na(committedPreviousClose) ? high - low : math.max(high - low, math.max(math.abs(high - committedPreviousClose), math.abs(low - committedPreviousClose)))
float shadowEmaFast = na(committedEmaFast) ? close : committedEmaFast + fastAlpha * (close - committedEmaFast)
float shadowEmaSlow = na(committedEmaSlow) ? close : committedEmaSlow + slowAlpha * (close - committedEmaSlow)
float shadowAtr = na(committedAtr) ? currentTrueRange : committedAtr + atrAlpha * (currentTrueRange - committedAtr)
var int c16c02SwingHighTicks = na
var int c16c02SwingHighSourceTime = na
var int c16c02SwingHighConfirmationTime = na
var int c16c02SwingLowTicks = na
var int c16c02SwingLowSourceTime = na
var int c16c02SwingLowConfirmationTime = na
int SMC_LIQUIDITY_TOLERANCE_TICKS = 1
int SMC_LIQUIDITY_MAX_AGE_BARS = 500
int SMC_FVG_MIN_GAP_TICKS = 1
int SMC_FVG_MAX_AGE_BARS = 250
int SMC_OB_LOOKBACK_BARS = 20
int SMC_OB_MAX_AGE_BARS = 250
var int smcCanonicalBarIndex = 0
// Capture sweeps before terminal pools are removed.
var float smcSweptLowLevel = na
var float smcSweptHighLevel = na
var int smcCreationSequenceId = 0
var int smcTrend = DIR_NEUTRAL
var bool smcSwingHighConsumed = false
var bool smcSwingLowConsumed = false
var StructuralEvent smcLatestStructure = StructuralEvent.new(SE_NONE, na, na)
var Liquidity[] smcLiquidity = array.new<Liquidity>(0)
var FVG[] smcFvgs = array.new<FVG>(0)
var OrderBlock[] smcObs = array.new<OrderBlock>(0)
var int smcLatestInducementTicks = na
var int smcLatestInducementTime = na
var int smcLatestInducementSide = DIR_NEUTRAL

var array<StructuralEvent> smcStructureHistory = array.new<StructuralEvent>()
var int smcGapCount = 0
// Current HTF is accepted only at/after its native close; the offset request supplies the prior confirmed bar during realtime.
f_native_htf(string tf) =>
    [co, ch, cl, cc, cv, ct, ce] = request.security(ticker.standard(syminfo.tickerid), tf, [open, high, low, close, volume, time, time_close], lookahead = barmerge.lookahead_off)
    [po, ph, pl, pc, pv, pt, pe] = request.security(ticker.standard(syminfo.tickerid), tf, [open[1], high[1], low[1], close[1], volume[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
    bool useCurrent = not na(ce) and ce <= time_close and (na(pe) or ce >= pe)
    [useCurrent ? co : po, useCurrent ? ch : ph, useCurrent ? cl : pl, useCurrent ? cc : pc, useCurrent ? cv : pv, useCurrent ? ct : pt, useCurrent ? ce : pe]
string confTf = not supportedTf ? timeframe.period : confirmationTfMinutes == 1440 ? "D" : str.tostring(math.max(confirmationTfMinutes, timeframe.isminutes ? timeframe.multiplier : 1))
string anchorTf = not supportedTf ? timeframe.period : anchorTfMinutes == 10080 ? "W" : anchorTfMinutes == 1440 ? "D" : str.tostring(math.max(anchorTfMinutes, timeframe.isminutes ? timeframe.multiplier : 1))
[nConfO, nConfH, nConfL, nConfC, nConfV, nConfStart, nConfEnd] = f_native_htf(confTf)
[nAnchorO, nAnchorH, nAnchorL, nAnchorC, nAnchorV, nAnchorStart, nAnchorEnd] = f_native_htf(anchorTf)
var int confLastCommittedStart = na
var int confLastCommittedEnd = na
var float confCommittedO = na
var float confCommittedH = na
var float confCommittedL = na
var float confCommittedC = na
var float confCommittedV = na
var bool confCommittedValid = false
var int anchorLastCommittedStart = na
var int anchorLastCommittedEnd = na
var float anchorCommittedO = na
var float anchorCommittedH = na
var float anchorCommittedL = na
var float anchorCommittedC = na
var float anchorCommittedV = na
var bool anchorCommittedValid = false
bool confirmationBucketCommitted = false
bool anchorBucketCommitted = false
if barstate.isconfirmed
    int smcPriorSwingHighTicks = c16c02SwingHighTicks
    int smcPriorSwingLowTicks = c16c02SwingLowTicks
    bool smcPriorSwingHighConsumed = smcSwingHighConsumed
    bool smcPriorSwingLowConsumed = smcSwingLowConsumed
    if smcCalculationTf
        committedEmaFast := shadowEmaFast
        committedEmaSlow := shadowEmaSlow
        committedAtr := math.max(shadowAtr, 0.000000000001)
        committedPreviousClose := close
        committedFeatureBars += 1
        if not na(high[SWING_LEFT_BARS + SWING_RIGHT_BARS])
            int pivotHighTicks = f_to_ticks(high[SWING_RIGHT_BARS], syminfo.mintick)
            int pivotLowTicks = f_to_ticks(low[SWING_RIGHT_BARS], syminfo.mintick)
            bool pivotHighValid = not na(pivotHighTicks)
            bool pivotLowValid = not na(pivotLowTicks)
            for offset = 1 to SWING_LEFT_BARS
                int leftHighTicks = f_to_ticks(high[SWING_RIGHT_BARS + offset], syminfo.mintick)
                int leftLowTicks = f_to_ticks(low[SWING_RIGHT_BARS + offset], syminfo.mintick)
                pivotHighValid := pivotHighValid and pivotHighTicks >= leftHighTicks
                pivotLowValid := pivotLowValid and pivotLowTicks <= leftLowTicks
            for offset = 0 to SWING_RIGHT_BARS - 1
                int rightHighTicks = f_to_ticks(high[offset], syminfo.mintick)
                int rightLowTicks = f_to_ticks(low[offset], syminfo.mintick)
                pivotHighValid := pivotHighValid and pivotHighTicks > rightHighTicks
                pivotLowValid := pivotLowValid and pivotLowTicks < rightLowTicks
            if pivotHighValid
                c16c02SwingHighTicks := pivotHighTicks
                c16c02SwingHighSourceTime := time[SWING_RIGHT_BARS]
                c16c02SwingHighConfirmationTime := time
            if pivotLowValid
                c16c02SwingLowTicks := pivotLowTicks
                c16c02SwingLowSourceTime := time[SWING_RIGHT_BARS]
                c16c02SwingLowConfirmationTime := time
    if supportedTf
        confCommittedValid := not na(nConfEnd) and nConfEnd <= time_close and not na(nConfO) and not na(nConfC)
        anchorCommittedValid := not na(nAnchorEnd) and nAnchorEnd <= time_close and not na(nAnchorO) and not na(nAnchorC)
        if confCommittedValid
            confirmationBucketCommitted := na(confLastCommittedStart) or nConfStart != confLastCommittedStart
            confLastCommittedStart := nConfStart
            confLastCommittedEnd := nConfEnd
            confCommittedO := nConfO
            confCommittedH := nConfH
            confCommittedL := nConfL
            confCommittedC := nConfC
            confCommittedV := nConfV
        if anchorCommittedValid
            anchorBucketCommitted := na(anchorLastCommittedStart) or nAnchorStart != anchorLastCommittedStart
            anchorLastCommittedStart := nAnchorStart
            anchorLastCommittedEnd := nAnchorEnd
            anchorCommittedO := nAnchorO
            anchorCommittedH := nAnchorH
            anchorCommittedL := nAnchorL
            anchorCommittedC := nAnchorC
            anchorCommittedV := nAnchorV
    if smcCalculationTf
        smcCanonicalBarIndex += 1
        smcSweptLowLevel := na
        smcSweptHighLevel := na
        int smcOpenTicks = f_to_ticks(open, syminfo.mintick)
        int smcHighTicks = f_to_ticks(high, syminfo.mintick)
        int smcLowTicks = f_to_ticks(low, syminfo.mintick)
        int smcCloseTicks = f_to_ticks(close, syminfo.mintick)
        if array.size(smcLiquidity) > 0
            for index = array.size(smcLiquidity) - 1 to 0
                Liquidity item = array.get(smcLiquidity, index)
                if not item.terminal and f_obs_expired(smcCanonicalBarIndex - item.creation_bar_index, SMC_LIQUIDITY_MAX_AGE_BARS)
                    item.terminal := true
                    item.end_reason := "EXPIRED"
                    array.set(smcLiquidity, index, item)
                if item.terminal
                    array.remove(smcLiquidity, index)
        if array.size(smcFvgs) > 0
            for index = array.size(smcFvgs) - 1 to 0
                FVG item = array.get(smcFvgs, index)
                if not item.terminal and f_obs_expired(smcCanonicalBarIndex - item.creation_bar_index, SMC_FVG_MAX_AGE_BARS)
                    item.terminal := true
                    item.end_reason := "EXPIRED"
                    array.set(smcFvgs, index, item)
                if item.terminal
                    array.remove(smcFvgs, index)
        if array.size(smcObs) > 0
            for index = array.size(smcObs) - 1 to 0
                OrderBlock item = array.get(smcObs, index)
                if not item.terminal and f_obs_expired(smcCanonicalBarIndex - item.creation_bar_index, SMC_OB_MAX_AGE_BARS)
                    item.terminal := true
                    item.end_reason := "EXPIRED"
                    array.set(smcObs, index, item)
                if item.terminal
                    array.remove(smcObs, index)
        if array.size(smcLiquidity) > 0
            for index = 0 to array.size(smcLiquidity) - 1
                Liquidity item = array.get(smcLiquidity, index)
                bool isHighPool = item.side == DIR_BEARISH
                if (isHighPool and smcCloseTicks > item.level_ticks) or (not isHighPool and smcCloseTicks < item.level_ticks)
                    item.terminal := true
                    item.end_reason := "CLOSE_BREACH"
                else if not item.swept and ((isHighPool and smcHighTicks > item.level_ticks and smcCloseTicks <= item.level_ticks) or (not isHighPool and smcLowTicks < item.level_ticks and smcCloseTicks >= item.level_ticks))
                    item.swept := true
                    item.sweep_confirmation_bar := smcCanonicalBarIndex
                    item.sweep_anchor_ticks := item.level_ticks
                    float sweptLevel = f_ticks_to_price(item.level_ticks, syminfo.mintick)
                    if isHighPool
                        smcSweptHighLevel := na(smcSweptHighLevel) ? sweptLevel : math.max(smcSweptHighLevel, sweptLevel)
                    else
                        smcSweptLowLevel := na(smcSweptLowLevel) ? sweptLevel : math.min(smcSweptLowLevel, sweptLevel)
                array.set(smcLiquidity, index, item)
        if array.size(smcFvgs) > 0
            for index = 0 to array.size(smcFvgs) - 1
                FVG item = array.get(smcFvgs, index)
                if (item.side == DIR_BULLISH and smcCloseTicks < item.bottom_ticks) or (item.side == DIR_BEARISH and smcCloseTicks > item.top_ticks)
                    item.terminal := true
                    item.end_reason := "CLOSE_BREACH"
                else if not item.filled and ((item.side == DIR_BULLISH and smcLowTicks <= item.bottom_ticks) or (item.side == DIR_BEARISH and smcHighTicks >= item.top_ticks))
                    item.filled := true
                    item.terminal := true
                    item.end_reason := "FILLED"
                else if not item.mitigated and smcHighTicks >= item.bottom_ticks and smcLowTicks <= item.top_ticks
                    item.mitigated := true
                    item.first_touch_bar := smcCanonicalBarIndex
                array.set(smcFvgs, index, item)
        if array.size(smcObs) > 0
            for index = 0 to array.size(smcObs) - 1
                OrderBlock item = array.get(smcObs, index)
                if (item.side == DIR_BULLISH and smcCloseTicks < item.bottom_ticks) or (item.side == DIR_BEARISH and smcCloseTicks > item.top_ticks)
                    item.terminal := true
                    item.end_reason := "CLOSE_BREACH"
                else if not item.mitigated and smcHighTicks >= item.bottom_ticks and smcLowTicks <= item.top_ticks
                    item.mitigated := true
                    item.first_touch_bar := smcCanonicalBarIndex
                array.set(smcObs, index, item)
        bool smcNewFvg = false
        int smcNewFvgSide = DIR_NEUTRAL
        bool continuousTriple = time == time_close[1] and time[1] == time_close[2]
        if not na(high[2]) and not continuousTriple and (low > high[2] or high < low[2])
            smcGapCount += 1
        if not na(high[2]) and continuousTriple
            int smcPrior2High = f_to_ticks(high[2], syminfo.mintick)
            int smcPrior2Low = f_to_ticks(low[2], syminfo.mintick)
            int smcPriorHigh = f_to_ticks(high[1], syminfo.mintick)
            int smcPriorLow = f_to_ticks(low[1], syminfo.mintick)
            if smcLowTicks > smcPrior2High and smcPriorHigh > smcPrior2High and smcLowTicks - smcPrior2High >= SMC_FVG_MIN_GAP_TICKS
                smcCreationSequenceId += 1
                array.push(smcFvgs, FVG.new(DIR_BULLISH, smcCreationSequenceId, smcCanonicalBarIndex, time, smcLowTicks, smcPrior2High, false, false, false, time[2]))
                smcNewFvg := true
                smcNewFvgSide := DIR_BULLISH
            else if smcHighTicks < smcPrior2Low and smcPriorLow < smcPrior2Low and smcPrior2Low - smcHighTicks >= SMC_FVG_MIN_GAP_TICKS
                smcCreationSequenceId += 1
                array.push(smcFvgs, FVG.new(DIR_BEARISH, smcCreationSequenceId, smcCanonicalBarIndex, time, smcPrior2Low, smcHighTicks, false, false, false, time[2]))
                smcNewFvg := true
                smcNewFvgSide := DIR_BEARISH
        bool smcNewLow = c16c02SwingLowConfirmationTime == time
        bool smcNewHigh = c16c02SwingHighConfirmationTime == time
        smcLatestInducementTicks := f_smc_inducement_value(0, smcTrend, smcNewLow, smcNewHigh, smcPriorSwingLowTicks, smcPriorSwingHighTicks, c16c02SwingLowTicks, c16c02SwingHighTicks, c16c02SwingLowSourceTime, c16c02SwingHighSourceTime, smcLatestInducementTicks, smcLatestInducementTime, smcLatestInducementSide)
        smcLatestInducementTime := f_smc_inducement_value(1, smcTrend, smcNewLow, smcNewHigh, smcPriorSwingLowTicks, smcPriorSwingHighTicks, c16c02SwingLowTicks, c16c02SwingHighTicks, c16c02SwingLowSourceTime, c16c02SwingHighSourceTime, smcLatestInducementTicks, smcLatestInducementTime, smcLatestInducementSide)
        smcLatestInducementSide := f_smc_inducement_value(2, smcTrend, smcNewLow, smcNewHigh, smcPriorSwingLowTicks, smcPriorSwingHighTicks, c16c02SwingLowTicks, c16c02SwingHighTicks, c16c02SwingLowSourceTime, c16c02SwingHighSourceTime, smcLatestInducementTicks, smcLatestInducementTime, smcLatestInducementSide)
        if not na(smcLatestInducementTicks) and (smcLatestInducementSide == DIR_BULLISH ? smcLowTicks <= smcLatestInducementTicks : smcHighTicks >= smcLatestInducementTicks)
            smcLatestInducementTicks := na
            smcLatestInducementTime := na
            smcLatestInducementSide := DIR_NEUTRAL
        if smcNewLow or smcNewHigh
            for sidePass = 0 to 1
                int newSide = sidePass == 0 ? DIR_BULLISH : DIR_BEARISH
                bool exists = newSide == DIR_BULLISH ? smcNewLow : smcNewHigh
                int newLevel = newSide == DIR_BULLISH ? c16c02SwingLowTicks : c16c02SwingHighTicks
                if exists
                    bool merged = false
                    if array.size(smcLiquidity) > 0
                        for index = 0 to array.size(smcLiquidity) - 1
                            Liquidity item = array.get(smcLiquidity, index)
                            if not item.terminal and not item.swept and item.side == newSide and math.abs(newLevel - item.level_ticks) <= SMC_LIQUIDITY_TOLERANCE_TICKS and not merged
                                item.level_ticks := newSide == DIR_BEARISH ? math.max(item.level_ticks, newLevel) : math.min(item.level_ticks, newLevel)
                                array.set(smcLiquidity, index, item)
                                merged := true
                    if not merged
                        smcCreationSequenceId += 1
                        array.push(smcLiquidity, Liquidity.new(newSide, smcCreationSequenceId, smcCanonicalBarIndex, time, newLevel, false, false, -1, na, newSide == DIR_BULLISH ? c16c02SwingLowSourceTime : c16c02SwingHighSourceTime))
        int smcEventType = SE_NONE
        int smcBrokenLevel = na
        bool smcBullBreak = not na(smcPriorSwingHighTicks) and not smcPriorSwingHighConsumed and smcCloseTicks > smcPriorSwingHighTicks
        bool smcBearBreak = not na(smcPriorSwingLowTicks) and not smcPriorSwingLowConsumed and smcCloseTicks < smcPriorSwingLowTicks
        if smcBullBreak and smcBearBreak
            smcTrend := DIR_NEUTRAL
        else
            if smcBullBreak
                smcEventType := smcTrend == DIR_BEARISH ? SE_CHOCH_BULLISH : SE_BOS_BULLISH
                smcBrokenLevel := smcPriorSwingHighTicks
                smcTrend := DIR_BULLISH
                smcSwingHighConsumed := true
            else if smcBearBreak
                smcEventType := smcTrend == DIR_BULLISH ? SE_CHOCH_BEARISH : SE_BOS_BEARISH
                smcBrokenLevel := smcPriorSwingLowTicks
                smcTrend := DIR_BEARISH
                smcSwingLowConsumed := true
        if smcNewHigh
            smcSwingHighConsumed := false
        if smcNewLow
            smcSwingLowConsumed := false
        if smcEventType != SE_NONE
            smcLatestStructure := StructuralEvent.new(smcEventType, smcBrokenLevel, time, f_ticks_to_price(smcBrokenLevel, syminfo.mintick) + (smcEventType > 0 ? -1 : 1) * nz(inspectorAtr) * 0.35)
            array.push(smcStructureHistory, smcLatestStructure)
            if array.size(smcStructureHistory) > 3
                array.shift(smcStructureHistory)
        if smcEventType != SE_NONE and smcNewFvg and ((smcEventType > 0 and smcNewFvgSide == DIR_BULLISH) or (smcEventType < 0 and smcNewFvgSide == DIR_BEARISH))
            int smcObSide = smcEventType > 0 ? DIR_BULLISH : DIR_BEARISH
            bool smcFoundOb = false
            int smcObTop = na
            int smcObBottom = na
            int smcObSourceTime = na
            for offset = 1 to SMC_OB_LOOKBACK_BARS
                if not na(open[offset]) and not smcFoundOb
                    int sourceOpen = f_to_ticks(open[offset], syminfo.mintick)
                    int sourceClose = f_to_ticks(close[offset], syminfo.mintick)
                    if (smcObSide == DIR_BULLISH and sourceClose < sourceOpen) or (smcObSide == DIR_BEARISH and sourceClose > sourceOpen)
                        smcObTop := f_to_ticks(high[offset], syminfo.mintick)
                        smcObBottom := f_to_ticks(low[offset], syminfo.mintick)
                        smcObSourceTime := time[offset]
                        smcFoundOb := true
            if smcFoundOb
                smcCreationSequenceId += 1
                array.push(smcObs, OrderBlock.new(smcObSide, smcCreationSequenceId, smcCanonicalBarIndex, time, smcObTop, smcObBottom, false, false, smcObSourceTime))
        if array.size(smcLiquidity) > 0
            for index = array.size(smcLiquidity) - 1 to 0
                if array.get(smcLiquidity, index).terminal
                    array.remove(smcLiquidity, index)
            if array.size(smcLiquidity) > LIQUIDITY_CAPACITY
                runtime.error("V3 invariant: smcLiquidity exceeded lifetime bound")
        if array.size(smcFvgs) > 0
            for index = array.size(smcFvgs) - 1 to 0
                if array.get(smcFvgs, index).terminal
                    array.remove(smcFvgs, index)
            if array.size(smcFvgs) > FVG_CAPACITY
                runtime.error("V3 invariant: smcFvgs exceeded lifetime bound")
        if array.size(smcObs) > 0
            for index = array.size(smcObs) - 1 to 0
                if array.get(smcObs, index).terminal
                    array.remove(smcObs, index)
            if array.size(smcObs) > OB_CAPACITY
                runtime.error("V3 invariant: smcObs exceeded lifetime bound")

// Fixed observation contract: reversal after a sweep, valid through age 10 inclusive.
int SETUP_MAX_AGE = 10
type SweepRecord
    int bar = na
    int stamp = na
    float level = na
    float extreme = na
    bool invalid = false
    bool structure = false
    bool pending = false
    int break_ticks = na

method update(SweepRecord this, int side, float level, float extreme, int bar, int stamp, float candleClose) =>
    if not na(level)
        this.bar := bar
        this.stamp := stamp
        this.level := level
        this.extreme := extreme
        this.invalid := false
        this.structure := false
        this.pending := false
        this.break_ticks := na
    else if not na(this.bar)
        this.invalid := this.invalid or (side == 1 ? f_to_ticks(candleClose, syminfo.mintick) < f_to_ticks(this.extreme, syminfo.mintick) : f_to_ticks(candleClose, syminfo.mintick) > f_to_ticks(this.extreme, syminfo.mintick))
    this.invalid

method age(SweepRecord this, int bar) =>
    na(this.bar) ? -1 : bar - this.bar

f_setup_structure(int side, int trend, int eventType, int eventTime, int sweepTime) =>
    not na(sweepTime) and not na(eventTime) and eventTime > sweepTime and trend == side and math.sign(eventType) == side

method confirmStructure(SweepRecord this, int side, int bar, int stamp, int trend, int eventType, int eventTime, int eventTicks, float candleClose) =>
    int age = this.age(bar)
    bool freshEvent = eventTime == stamp and math.sign(eventType) == side and trend == side
    if age < 0 or age > SETUP_MAX_AGE or this.invalid or trend != side
        this.structure := false
        this.pending := false
    else
        if this.pending and age == 1
            int closing = f_to_ticks(candleClose, syminfo.mintick)
            this.structure := side == 1 ? closing > this.break_ticks : closing < this.break_ticks
            this.pending := false
        if freshEvent and age == 0
            this.pending := true
            this.break_ticks := eventTicks
            this.structure := false
        else if freshEvent and f_setup_structure(side, trend, eventType, eventTime, this.stamp)
            this.structure := true
            this.pending := false
    this.structure

// Additive flags keep every blocking reason available to the dashboard and audit.
f_setup_mask(int age, bool invalid, bool oppositeRecent, bool structure, bool htf, bool vsa, bool extended, bool dataReady) =>
    (dataReady ? 0 : 1) + (age < 0 ? 2 : 0) + (age > SETUP_MAX_AGE ? 4 : 0) + (invalid ? 8 : 0) + (oppositeRecent ? 16 : 0) + (structure ? 0 : 32) + (htf ? 0 : 64) + (vsa ? 0 : 128) + (extended ? 256 : 0)
f_setup_has(int mask, int flag) =>
    int(math.floor(mask / flag)) % 2 == 1
// Stage is independent of the optional evidence; invalidation remains latched.
f_setup_phase(int mask) =>
    f_setup_has(mask, 8) ? 5 : f_setup_has(mask, 4) ? 6 : f_setup_has(mask, 2) ? 0 : f_setup_has(mask, 16) ? 4 : f_setup_has(mask, 32) ? 1 : mask == 0 ? 3 : 2
f_setup_phase_text(int phase) =>
    phase == 5 ? "Đã vô hiệu" : phase == 6 ? "Quét đã hết hạn" : phase == 4 ? "Quét hai phía · chờ" : phase == 3 ? "Điều kiện hội tụ" : phase == 2 ? "Cấu trúc xác nhận" : phase == 1 ? "Đã quét · chờ cấu trúc" : "Chưa ghi nhận quét"
f_setup_zone(int side, float price, float atr) =>
    float bestDistance = na
    int bestId = na
    string kind = ""
    bool touched = false
    int bestLow = na
    int bestHigh = na
    for z in smcFvgs
        if not z.terminal and z.side == side
            float distance = math.max(z.bottom_ticks * syminfo.mintick - price, math.max(price - z.top_ticks * syminfo.mintick, 0.0))
            if na(bestDistance) or distance < bestDistance or (distance == bestDistance and z.creation_sequence_id > bestId)
                bestDistance := distance
                bestId := z.creation_sequence_id
                kind := "FVG"
                touched := z.mitigated
                bestLow := z.bottom_ticks
                bestHigh := z.top_ticks
    for z in smcObs
        if not z.terminal and z.side == side
            float distance = math.max(z.bottom_ticks * syminfo.mintick - price, math.max(price - z.top_ticks * syminfo.mintick, 0.0))
            if na(bestDistance) or distance < bestDistance or (distance == bestDistance and z.creation_sequence_id > bestId)
                bestDistance := distance
                bestId := z.creation_sequence_id
                kind := "OB"
                touched := z.mitigated
                bestLow := z.bottom_ticks
                bestHigh := z.top_ticks
    int location = na(bestDistance) or na(atr) or atr <= 0 ? 0 : bestDistance == 0 ? 1 : bestDistance <= 0.5 * atr ? 2 : 3
    string description = location == 0 ? "Chưa có vùng" : (location == 1 ? "Trong " : location == 2 ? "Gần " : "Xa ") + kind + (touched ? " · đã chạm" : " · chưa chạm")
    if location != 0
        description += " #" + str.tostring(bestId) + "\n" + f_c08_price_text(bestLow) + " – " + f_c08_price_text(bestHigh)
        description += (kind == "FVG" ? not showFvg : not showOrderBlocks) ? " · đang ẩn" : "\nDấu ◇ trên chart: vùng bảng tham chiếu."
    [description, location, bestId, bestDistance]
f_setup_status(int mask) =>
    f_setup_has(mask, 8) ? "VÔ HIỆU" : f_setup_has(mask, 4) ? "HẾT HẠN" : f_setup_has(mask, 1) ? "THIẾU DỮ LIỆU" : f_setup_has(mask, 2) ? "CHƯA CÓ QUÉT" : f_setup_has(mask, 16) ? "HAI PHÍA / CHỜ" : mask == 0 ? "ĐỦ TIÊU CHÍ" : "CHỜ XÁC NHẬN"
f_setup_reason(int mask) =>
    f_setup_has(mask, 8) ? "Đóng vượt cực trị quét\nChờ một lần quét mới" : f_setup_has(mask, 4) ? "Quét đã quá 10 nến\nChờ một lần quét mới" : f_setup_has(mask, 1) ? "Thiếu volume / ATR\nChưa đánh giá đủ" : f_setup_has(mask, 2) ? "Chưa có quét được xác nhận" : f_setup_has(mask, 16) ? "Hai phía cùng có quét gần\nBối cảnh chưa rõ" : f_setup_has(mask, 32) ? "Chờ BOS/CHoCH thuận\nsau lần quét" : f_setup_has(mask, 64) ? "Chờ hai nến HTF\ncùng thuận hướng" : f_setup_has(mask, 128) ? "Chờ mẫu VSA thuận\ntrên nến đã đóng" : f_setup_has(mask, 256) ? "Giá xa EMA > 2.5 ATR\nTránh đánh giá khi đuổi giá" : "Quét + cấu trúc xác nhận\nHTF và VSA cùng thuận"
f_setup_reasons(int mask) =>
    string reasons = ""
    reasons += f_setup_has(mask, 1) ? "• Thiếu dữ liệu volume / ATR / warmup\n" : ""
    reasons += f_setup_has(mask, 2) ? "• Chưa ghi nhận quét ở phía này\n" : ""
    reasons += f_setup_has(mask, 4) ? "• Quét quá 10 nến\n" : ""
    reasons += f_setup_has(mask, 8) ? "• Đã có nến đóng vượt cực trị quét\n" : ""
    reasons += f_setup_has(mask, 16) ? "• Phía đối diện cũng có quét còn hiệu lực\n" : ""
    reasons += f_setup_has(mask, 32) ? "• Chưa có BOS/CHoCH thuận sau quét\n" : ""
    reasons += f_setup_has(mask, 64) ? "• Hai thân nến HTF chưa cùng thuận / thiếu HTF\n" : ""
    reasons += f_setup_has(mask, 128) ? "• VSA nến chốt chưa ủng hộ\n" : ""
    reasons += f_setup_has(mask, 256) ? "• Khoảng cách EMA vượt 2.5 ATR\n" : ""
    mask == 0 ? "Tất cả tiêu chí quan sát đạt. Chưa đánh giá spread, fill hoặc lợi nhuận." : reasons

// All observations below describe the last CLOSED standard candle.
var int obsTime = na
var int obsVsa = 99
var float obsRv = na
var float obsRr = na
var float obsLocation = na
var float obsEma = na
var float obsDistance = na
var float obsAtr = na
var float obsClose = na
var int obsSweep = 0
var int obsLastEventTime = na
var string obsLastEvent = "Chưa có sự kiện"
var string obsSession = "N/A"
var SweepRecord obsLowSweep = SweepRecord.new()
var SweepRecord obsHighSweep = SweepRecord.new()
var int obsLongMask = 1
var int obsShortMask = 1
var bool obsLongStructure = false
var bool obsShortStructure = false
var bool obsContextReady = false
var string obsLongZone = "Chưa có vùng"
var string obsShortZone = "Chưa có vùng"
var int obsLongZoneCode = 0
var int obsShortZoneCode = 0
var int obsLongZoneId = na
var int obsShortZoneId = na
var int obsConfDirection = 0
var int obsAnchorDirection = 0
var int obsVolumeStreak = 0
var string obsDataIssue = "Chờ dữ liệu"
var int obsGapCount = 0
var int obsLastLabelBar = -100
var int obsLastLabelCode = 99
var bool obsLastLabelAbove = false
var int obsLabelLane = 0
string obsCurrentSession = f_observer_session(timeframe.period)
var array<label> obsLabels = array.new<label>()
// LuxAlgo Liquidity Sweeps: wick rejection box and thick vertical marker.
var array<box> obsSweepBoxes = array.new<box>()
var array<line> obsSweepWicks = array.new<line>()
f_obs_sweep_area(float level, float extreme, color tone) =>
    int step = int(timeframe.in_seconds() * 1000)
    array.push(obsSweepBoxes, box.new(time, math.max(level, extreme), time + step * 3, math.min(level, extreme), xloc = xloc.bar_time, border_color = na, bgcolor = color.new(tone, 85)))
    array.push(obsSweepWicks, line.new(time, level, time, extreme, xloc = xloc.bar_time, color = tone, width = 3))
    while array.size(obsSweepBoxes) > eventLimit
        box.delete(array.shift(obsSweepBoxes))
        line.delete(array.shift(obsSweepWicks))
int obsRawVsa = f_obs_vsa(vwValid, vwRelativeVolume, vwRelativeRange, vwCloseLocation, close - close[1], volume < volume[1] and volume < volume[2])
f_obs_vsa_text(int code) =>
    code == 99 ? "N/A: thiếu volume / warmup / biên nến" : code == 1 ? "Volume cao • nến rộng, đóng cao" : code == -1 ? "Volume cao • nến rộng, đóng thấp" : code == 2 ? "Nỗ lực lớn, biên hẹp • đóng cao" : code == -2 ? "Nỗ lực lớn, biên hẹp • đóng thấp" : code == 3 ? "No Supply? • mẫu volume thấp" : code == -3 ? "No Demand? • mẫu volume thấp" : "Không có mẫu VSA nổi bật"
f_obs_dir(int direction) =>
    direction > 0 ? "TĂNG" : direction < 0 ? "GIẢM" : "CHƯA RÕ"
f_obs_num(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##")
f_obs_price(float value) =>
    na(value) ? "N/A" : str.tostring(value, format.mintick)
bool obsClosed = barstate.isconfirmed and smcCalculationTf
if obsClosed
    obsTime := time_close
    obsGapCount := smcGapCount
    obsVolumeStreak := not na(volume) and volume > 0 ? math.min(obsVolumeStreak + 1, 21) : 0
    obsDataIssue := na(volume) ? "Volume thiếu" : volume == 0 ? "Volume = 0" : obsVolumeStreak < 21 ? "VSA nạp " + str.tostring(obsVolumeStreak) + "/21" : high <= low or na(vwRangeMean) or vwRangeMean <= 0 ? "Biên nến = 0" : na(inspectorAtr) or inspectorAtr <= 0 ? "ATR chưa đủ" : committedFeatureBars < WARMUP_BARS ? "Nền " + str.tostring(committedFeatureBars) + "/" + str.tostring(WARMUP_BARS) : "VSA đủ dữ liệu"
    obsSession := obsCurrentSession
    obsVsa := obsRawVsa
    obsRv := vwRelativeVolume
    obsRr := vwRelativeRange
    obsLocation := vwCloseLocation
    obsEma := ema200
    obsAtr := inspectorAtr
    obsClose := close
    obsDistance := not na(inspectorAtr) and inspectorAtr > 0 ? (close - ema200) / inspectorAtr : na
    obsLowSweep.update(1, smcSweptLowLevel, low, smcCanonicalBarIndex, time, close)
    obsHighSweep.update(-1, smcSweptHighLevel, high, smcCanonicalBarIndex, time, close)
    int lowAge = obsLowSweep.age(smcCanonicalBarIndex)
    int highAge = obsHighSweep.age(smcCanonicalBarIndex)
    bool lowRecent = lowAge >= 0 and lowAge <= SETUP_MAX_AGE and not obsLowSweep.invalid
    bool highRecent = highAge >= 0 and highAge <= SETUP_MAX_AGE and not obsHighSweep.invalid
    obsSweep := not na(smcSweptLowLevel) and not na(smcSweptHighLevel) ? 2 : not na(smcSweptLowLevel) ? 1 : not na(smcSweptHighLevel) ? -1 : 0
    obsLongStructure := obsLowSweep.confirmStructure(1, smcCanonicalBarIndex, time, smcTrend, smcLatestStructure.event_type, smcLatestStructure.time, smcLatestStructure.price_ticks, close)
    obsShortStructure := obsHighSweep.confirmStructure(-1, smcCanonicalBarIndex, time, smcTrend, smcLatestStructure.event_type, smcLatestStructure.time, smcLatestStructure.price_ticks, close)
    obsContextReady := supportedTf and confCommittedValid and anchorCommittedValid
    obsConfDirection := obsContextReady ? int(f_obs_candle_direction(confCommittedO, confCommittedC)) : 0
    obsAnchorDirection := obsContextReady ? int(f_obs_candle_direction(anchorCommittedO, anchorCommittedC)) : 0
    bool dataReady = vwValid and not na(inspectorAtr) and inspectorAtr > 0 and committedFeatureBars >= WARMUP_BARS
    bool extended = not na(obsDistance) and math.abs(obsDistance) > 2.5
    obsLongMask := f_setup_mask(lowAge, obsLowSweep.invalid, lowRecent and highRecent, obsLongStructure, obsContextReady and obsConfDirection == 1 and obsAnchorDirection == 1, obsVsa != 99 and obsVsa > 0, extended, dataReady)
    obsShortMask := f_setup_mask(highAge, obsHighSweep.invalid, lowRecent and highRecent, obsShortStructure, obsContextReady and obsConfDirection == -1 and obsAnchorDirection == -1, obsVsa != 99 and obsVsa < 0, extended, dataReady)
    [longZone, longZoneCode, longZoneId, longZoneDistance] = f_setup_zone(1, close, inspectorAtr)
    [shortZone, shortZoneCode, shortZoneId, shortZoneDistance] = f_setup_zone(-1, close, inspectorAtr)
    obsLongZone := longZone
    obsShortZone := shortZone
    obsLongZoneCode := longZoneCode
    obsShortZoneCode := shortZoneCode
    obsLongZoneId := longZoneId
    obsShortZoneId := shortZoneId
    string eventText = obsSweep == 2 ? "Quét hai phía" : obsSweep == 1 ? "Quét đáy • lấy lại mức" : obsSweep == -1 ? "Quét đỉnh • lấy lại mức" : ""
    if obsVsa != 0 and obsVsa != 99
        eventText += (eventText == "" ? "" : "\n") + f_obs_vsa_text(obsVsa)
    if eventText != ""
        obsLastEvent := eventText
        obsLastEventTime := time_close
        if showVsaEvents and (obsSweep != 0 or (showVsaDetails and (obsVsa != obsLastLabelCode or smcCanonicalBarIndex - obsLastLabelBar >= 3)))
            bool above = f_obs_label_above(obsSweep, obsVsa)
            color eventColor = obsSweep == 2 ? obsAttention : above ? obsDown : obsUp
            obsLabelLane := smcCanonicalBarIndex - obsLastLabelBar <= 5 and above == obsLastLabelAbove ? (obsLabelLane + 1) % 3 : 0
            float labelGap = math.max(nz(inspectorAtr, high - low) * (0.18 + 0.25 * obsLabelLane), syminfo.mintick * 3)
            string structureSuffix = showMarketStructure and smcLatestStructure.time == time ? "\nCùng nến BOS/CHoCH; còn cần xác nhận giữ mức." : ""
            label mark = label.new(time, above ? high + labelGap : low - labelGap, obsSweep != 0 ? (obsSweep == 2 ? "× ↕" : "×") : (math.abs(obsVsa) == 1 ? "V↑ R↑" : math.abs(obsVsa) == 2 ? "V↑ R↓" : "V↓ R↓"), xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up, color = color(na), textcolor = eventColor, size = obsChartSize, tooltip = eventText + structureSuffix + "\nChốt: " + str.format_time(time_close, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " VN\nRV: " + f_obs_num(obsRv) + " • Range: " + f_obs_num(obsRr) + "\nMẫu OHLC/volume; không xác nhận dòng tiền tổ chức.")
            if not na(smcSweptLowLevel)
                f_obs_sweep_area(smcSweptLowLevel, low, obsUp)
            if not na(smcSweptHighLevel)
                f_obs_sweep_area(smcSweptHighLevel, high, obsDown)
            array.push(obsLabels, mark)
            obsLastLabelBar := smcCanonicalBarIndex
            obsLastLabelCode := obsVsa
            obsLastLabelAbove := above
    while array.size(obsLabels) > eventLimit
        label.delete(array.shift(obsLabels))

color obsCandleColor = obsClosed and colorVsaBars and obsVsa != 0 and obsVsa != 99 ? (obsVsa > 0 ? obsUp : obsDown) : na
barcolor(obsCandleColor, title = "Mẫu VSA đã đóng")
plot(showEma and smcCalculationTf ? obsEma : na, "EMA đã đóng", color = color.new(color.rgb(96, 127, 171), 20), linewidth = 1, display = display.all - display.status_line)
float obsCloudCenter = (committedEmaFast + committedEmaSlow) / 2
bool obsCloudValid = showCloudContext and smcCalculationTf and committedFeatureBars >= WARMUP_BARS
obsCloudUpper = plot(obsCloudValid ? obsCloudCenter + committedAtr * 0.5 : na, "Dải EMA trên", color = color.new(color.gray, 70), style = plot.style_linebr, display = display.all - display.status_line)
obsCloudLower = plot(obsCloudValid ? obsCloudCenter - committedAtr * 0.5 : na, "Dải EMA dưới", color = color.new(color.gray, 70), style = plot.style_linebr, display = display.all - display.status_line)
fill(obsCloudUpper, obsCloudLower, color = color.new(color.gray, 93), title = "Dải tham chiếu")

// LuxAlgo Market Structure (Fractal) dashboard frame, palette and sizing.
color obsGood = obsUp
color obsWait = color.white
color obsMuted = #b2b5be
color obsPanelBg = #1e222d
string obsFont = panelFont == "Vừa" ? size.normal : panelFont == "Nhỏ" ? size.small : size.tiny
var table obsPanel = table.new(panelPosition == "Giữa trái" ? position.middle_left : panelPosition == "Trên phải" ? position.top_right : panelPosition == "Dưới phải" ? position.bottom_right : position.bottom_left, 2, 6, bgcolor = obsPanelBg, border_color = #373a46, border_width = 1, frame_color = #373a46, frame_width = 1)
f_obs_cell(int col, int row, string content, color tone, string hint = "") =>
    table.cell(obsPanel, col, row, " " + content + " ", text_color = tone, bgcolor = obsPanelBg, text_size = obsFont, text_halign = text.align_center, tooltip = hint)
f_obs_tf(string tf) =>
    tf == "60" ? "1h" : tf == "240" ? "4h" : tf == "D" or tf == "1D" ? "1D" : tf == "W" or tf == "1W" ? "1W" : na(str.tonumber(tf)) ? tf : tf + "m"
f_obs_brief(int mask, bool pending) =>
    not supportedTf ? "Khung chưa hỗ trợ" : f_setup_has(mask, 8) ? "Quét đã bị hủy" : f_setup_has(mask, 4) ? "Quét đã hết hạn" : f_setup_has(mask, 2) ? "Chờ quét" : f_setup_has(mask, 16) ? "Quét hai phía" : pending ? "Chờ nến giữ mức" : f_setup_has(mask, 32) ? "Chờ phá cấu trúc" : f_setup_has(mask, 1) ? "Thiếu dữ liệu" : f_setup_has(mask, 64) ? "Nến lớn chưa thuận" : f_setup_has(mask, 128) ? "VSA chưa thuận" : f_setup_has(mask, 256) ? "Giá xa EMA" : "Đủ tiêu chí quan sát"
f_obs_direction_column(int col, int side, int mask, SweepRecord sweep) =>
    bool liveSweep = sweep.age(smcCanonicalBarIndex) >= 0 and sweep.age(smcCanonicalBarIndex) <= SETUP_MAX_AGE and not sweep.invalid
    string invalidation = liveSweep ? "Hủy " + (side == 1 ? "< " : "> ") + f_obs_price(sweep.extreme) : "Chờ lần quét mới"
    string htfInfo = not supportedTf ? "Khung chưa hỗ trợ setup" : not obsContextReady ? "Thiếu HTF đã đóng" : "Thân " + confTf + ": " + f_obs_dir(obsConfDirection) + " · " + anchorTf + ": " + f_obs_dir(obsAnchorDirection) + "\nHTF chốt: " + str.format_time(confLastCommittedEnd, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " / " + str.format_time(anchorLastCommittedEnd, "dd/MM HH:mm", "Asia/Ho_Chi_Minh")
    string details = (side == 1 ? "HỒI LÊN" : "HỒI XUỐNG") + " — " + f_obs_brief(mask, sweep.pending) + "\n\n" + f_setup_reasons(mask) + "\n" + invalidation + "\n\n" + (sweep.age(smcCanonicalBarIndex) < 0 ? "Chưa ghi nhận quét" : "Quét mức " + f_obs_price(sweep.level) + " · " + str.tostring(sweep.age(smcCanonicalBarIndex)) + " nến") + "\n" + htfInfo + "\n" + str.replace_all(side == 1 ? obsLongZone : obsShortZone, "Dấu ◇ trên chart:", "Dấu · sau tên vùng:") + "\n\n" + obsDataIssue + " · RV " + f_obs_num(obsRv) + "\n" + f_obs_vsa_text(obsVsa) + "\nEMA " + f_obs_price(obsEma) + " · cách " + f_obs_num(obsDistance) + " ATR\nHủy khi ĐÓNG nến vượt mức. Nhận định không phải lệnh vào."
    color sideColor = side == 1 ? obsUp : obsDown
    string sweepText = (side == 1 ? "Đáy " : "Đỉnh ") + (sweep.age(smcCanonicalBarIndex) < 0 ? "—" : sweep.invalid ? "hủy" : not liveSweep ? "cũ" : "✓ " + str.tostring(sweep.age(smcCanonicalBarIndex)) + "n")
    string structureText = not liveSweep ? "—" : sweep.pending ? "Chờ giữ mức" : (side == 1 ? obsLongStructure : obsShortStructure) ? "✓ Xác nhận" : "Chưa phá"
    string reason = mask == 0 ? "Đủ tiêu chí" : not supportedTf ? "Không hỗ trợ" : not liveSweep ? "Quét mới" : f_setup_has(mask, 16) ? "Hai phía" : sweep.pending ? "Giữ mức" : f_setup_has(mask, 32) ? "BOS / CHoCH" : f_setup_has(mask, 1) ? "Dữ liệu" : f_setup_has(mask, 64) ? "Nến lớn" : f_setup_has(mask, 128) ? "VSA" : "Gần EMA"
    f_obs_cell(col, 1, side == 1 ? "HỒI LÊN" : "HỒI XUỐNG", sideColor, details)
    f_obs_cell(col, 2, "Quét " + sweepText, liveSweep ? sideColor : obsMuted, details)
    f_obs_cell(col, 3, "Cấu trúc " + structureText, liveSweep and not f_setup_has(mask, 32) ? sideColor : obsMuted, details)
    f_obs_cell(col, 4, (mask == 0 ? "" : "Chờ ") + reason, mask == 0 ? sideColor : obsWait, details)
if barstate.islast
    table.clear(obsPanel, 0, 0, 1, 5)
    table.set_frame_width(obsPanel, showInspector ? 1 : 0)
    table.set_border_width(obsPanel, showInspector ? 1 : 0)
    table.set_bgcolor(obsPanel, showInspector ? obsPanelBg : color(na))
    if showInspector
        string quality = not chart.is_standard ? "Nến phi tiêu chuẩn" : not supportedTf ? "Khung chưa hỗ trợ" : na(obsTime) ? "Chờ dữ liệu" : obsDataIssue
        string snapshotHint = "Nến đã đóng: " + (na(obsTime) ? "Chưa có" : str.format_time(obsTime, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " VN") + "\nBảng không theo crosshair.\n" + syminfo.tickerid + "\n" + quality + "\nGap không liên tục đã loại khỏi FVG: " + str.tostring(obsGapCount)
        f_obs_cell(0, 0, syminfo.ticker + " · " + f_obs_tf(timeframe.period) + " · " + (na(obsTime) ? "—" : str.format_time(obsTime, "HH:mm", "Asia/Ho_Chi_Minh")), color.white, snapshotHint)
        f_obs_direction_column(0, 1, obsLongMask, obsLowSweep)
        f_obs_direction_column(1, -1, obsShortMask, obsHighSweep)
        string htf = obsContextReady ? f_obs_tf(confTf) + (obsConfDirection > 0 ? " ↑" : obsConfDirection < 0 ? " ↓" : " —") + "  /  " + f_obs_tf(anchorTf) + (obsAnchorDirection > 0 ? " ↑" : obsAnchorDirection < 0 ? " ↓" : " —") : "HTF chưa đủ"
        f_obs_cell(0, 5, htf + "  ·  " + (quality == "VSA đủ dữ liệu" ? "Volume OK" : "! " + quality), quality == "VSA đủ dữ liệu" ? obsMuted : obsWait, "Hướng thân nến lớn đã đóng, không phải cấu trúc xu hướng.\n" + snapshotHint + "\nRê từng cột để xem đầy đủ lý do và mức hủy.")
        table.merge_cells(obsPanel, 0, 0, 1, 0)
        table.merge_cells(obsPanel, 0, 5, 1, 5)

bool obsStructureEvent = obsClosed and smcLatestStructure.time == time
alertcondition(enableContextAlerts and obsClosed and obsVsa != 0 and obsVsa != 99, "Mẫu VSA đã đóng", "Mẫu VSA mới trên {{ticker}} {{interval}}; quan sát bối cảnh.")
alertcondition(enableContextAlerts and obsClosed and obsSweep != 0, "Quét thanh khoản đã đóng", "Giá vượt và lấy lại một pool trên {{ticker}} {{interval}}.")
alertcondition(enableContextAlerts and obsStructureEvent, "Thay đổi cấu trúc đã đóng", "BOS/CHoCH được xác nhận trên {{ticker}} {{interval}}.")
plot(obsVsa, "Audit VSA code", display = display.data_window)
plot(obsRv, "RV nến đã đóng", display = display.data_window)
plot(obsRr, "Range ratio nến đã đóng", display = display.data_window)

plot(obsLongMask, "Setup hồi lên: lý do chặn", display = display.data_window)
plot(obsShortMask, "Setup hồi xuống: lý do chặn", display = display.data_window)

plot(f_setup_phase(obsLongMask), "V3 phase long", display = display.data_window)
plot(f_setup_phase(obsShortMask), "V3 phase short", display = display.data_window)
plot(obsLongZoneCode, "V3 zone long", display = display.data_window)
plot(obsShortZoneCode, "V3 zone short", display = display.data_window)
plot(confLastCommittedEnd, "V3 HTF conf end", display = display.data_window)
plot(anchorLastCommittedEnd, "V3 HTF anchor end", display = display.data_window)

f_smc_select_liquidity(array<Liquidity> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                Liquidity item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.swept) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemPrice = f_ticks_to_price(item.level_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.abs(itemPrice - price) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.swept ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_fvgs(array<FVG> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                FVG item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

f_smc_select_obs(array<OrderBlock> zones, float price, float atr, int limit, bool activeOnly) =>
    array<int> selected = array.new_int(0)
    if limit > 0 and array.size(zones) > 0
        for rank = 0 to limit - 1
            bool found = false
            int bestId = na
            int bestCreated = na
            int bestInactive = na
            float bestDistance = na
            for index = 0 to array.size(zones) - 1
                OrderBlock item = array.get(zones, index)
                bool eligible = not item.terminal and (not activeOnly or not item.mitigated) and not array.includes(selected, item.creation_sequence_id)
                if eligible
                    float itemLow = f_ticks_to_price(item.bottom_ticks, syminfo.mintick)
                    float itemHigh = f_ticks_to_price(item.top_ticks, syminfo.mintick)
                    float itemDistance = not na(price) ? math.max(itemLow - price, math.max(price - itemHigh, 0.0)) : 0.0
                    itemDistance := not na(atr) and atr > 0 ? itemDistance / atr : itemDistance
                    int itemInactive = item.mitigated ? 1 : 0
                    bool better = not found
                    if not better and itemInactive < bestInactive
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance < bestDistance
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index > bestCreated
                        better := true
                    else if not better and itemInactive == bestInactive and itemDistance == bestDistance and item.creation_bar_index == bestCreated and item.creation_sequence_id < bestId
                        better := true
                    if better
                        found := true
                        bestId := item.creation_sequence_id
                        bestCreated := item.creation_bar_index
                        bestInactive := itemInactive
                        bestDistance := itemDistance
            if found
                array.push(selected, bestId)
    selected

// Slots persist across bars; setters preserve IDs and Pine rollback semantics.
var array<line> obsLines = array.new<line>()
var array<box> obsBoxes = array.new<box>()
var array<label> obsStructureLabels = array.new<label>()
var array<line> obsStructureLines = array.new<line>()
var array<int> obsStructureStarts = array.new<int>()
var array<StructuralEvent> obsStructureEvents = array.new<StructuralEvent>()
var array<line> obsMidLines = array.new<line>()
var array<label> obsLevelLabels = array.new<label>()
var int obsRenderedBar = na
// The break consumes the prior swing, even if a new pivot confirms on this bar.
if obsClosed and smcLatestStructure.time == time
    array.push(obsStructureStarts, smcLatestStructure.event_type > 0 ? c16c02SwingHighSourceTime[1] : c16c02SwingLowSourceTime[1])
    array.push(obsStructureEvents, smcLatestStructure.copy())
    if array.size(obsStructureStarts) > obsStructureLimit
        array.shift(obsStructureStarts)
        array.shift(obsStructureEvents)
if barstate.isfirst
    for slot = 0 to 10
        array.push(obsLines, line.new(na, na, na, na, xloc = xloc.bar_time))
        array.push(obsLevelLabels, label.new(na, na, "", xloc = xloc.bar_time, color = color(na), style = label.style_label_left))
    for slot = 0 to 13
        array.push(obsBoxes, box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.none))
        array.push(obsMidLines, line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_dashed))
    for slot = 0 to obsStructureLimit - 1
        array.push(obsStructureLabels, label.new(na, na, "", xloc = xloc.bar_time))
        array.push(obsStructureLines, line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.none))
f_obs_line(int slot, int left, int ticks, color tone, string style, int width) =>
    line object = array.get(obsLines, slot)
    float price = f_ticks_to_price(ticks, syminfo.mintick)
    line.set_xy1(object, left, price)
    line.set_xy2(object, obsTime, price)
    line.set_color(object, tone)
    line.set_style(object, style)
    line.set_width(object, width)
    line.set_extend(object, extend.none)
    int right = obsTime + int(timeframe.in_seconds() * 1000 * 8)
    line.set_x2(object, right)
    label tag = array.get(obsLevelLabels, slot)
    // Liquidity labels take precedence over overlapping swing names.
    label.set_xy(tag, left, showZoneLabels and (slot >= 2 or not showLiquidity) ? price : na)
    label.set_style(tag, slot == 0 ? label.style_label_down : slot == 1 ? label.style_label_up : label.style_label_lower_left)
    label.set_text(tag, slot == 0 ? "Swing High" : slot == 1 ? "Swing Low" : slot == 2 ? "IDM" : "Liquidity")
    label.set_textcolor(tag, tone)
    label.set_size(tag, obsChartSize)
f_obs_box(int slot, int left, int top, int bottom, int id, int side, bool touched, string kind) =>
    box object = array.get(obsBoxes, slot)
    bool referenced = id == obsLongZoneId or id == obsShortZoneId
    color fillTone = obsStyle == "Monochrome" ? color.new(side == 1 ? obsUp : obsDown, 85) : kind == "OB" ? (side == 1 ? obsObBull : obsObBear) : (side == 1 ? obsFvgBull : obsFvgBear)
    color tone = color.new(fillTone, 0)
    string widthText = showZoneQuality and obsAtr > 0 ? " / " + str.tostring((top - bottom) * syminfo.mintick / obsAtr, "#.##") + " ATR" : ""
    string caption = showZoneLabels and (referenced or (top - bottom) * syminfo.mintick >= nz(obsAtr) * 0.2) ? kind : ""
    if caption != ""
        caption += (side == 1 ? " +" : " −") + (referenced ? " ·" : "") + (touched ? " chạm" : "") + widthText
    box.set_lefttop(object, left, f_ticks_to_price(top, syminfo.mintick))
    box.set_rightbottom(object, obsTime + int(timeframe.in_seconds() * 1000 * 8), f_ticks_to_price(bottom, syminfo.mintick))
    box.set_extend(object, obsExtendZones ? extend.right : extend.none)
    box.set_border_color(object, kind == "OB" ? color.new(tone, 70) : color(na))
    box.set_border_width(object, 1)
    box.set_border_style(object, line.style_solid)
    box.set_bgcolor(object, touched ? color.new(tone, 93) : fillTone)
    box.set_text(object, caption)
    box.set_text_color(object, obsDark ? color.new(tone, 0) : color.new(chart.fg_color, 20))
    box.set_text_size(object, obsChartSize)
    box.set_text_halign(object, text.align_right)
    box.set_text_valign(object, side == 1 ? text.align_bottom : text.align_top)
    // LuxAlgo Order Block Detector: independent average line inside each box.
    line mid = array.get(obsMidLines, slot)
    float midPrice = (top + bottom) * syminfo.mintick * 0.5
    line.set_xy1(mid, left, obsShowMid ? midPrice : na)
    line.set_xy2(mid, obsTime + int(timeframe.in_seconds() * 1000 * 8), obsShowMid ? midPrice : na)
    line.set_extend(mid, obsExtendZones ? extend.right : extend.none)
    line.set_color(mid, color.new(#9598a1, 37))

if (barstate.islastconfirmedhistory or barstate.islast) and (na(obsRenderedBar) or obsRenderedBar != smcCanonicalBarIndex)
    array<int> poolIds = f_smc_select_liquidity(smcLiquidity, obsClose, obsAtr, showLiquidity ? smcLiquidityDisplayLimit : 0, showOnlyActiveZones)
    array<int> fvgIds = f_smc_select_fvgs(smcFvgs, obsClose, obsAtr, showFvg ? smcFvgDisplayLimit : 0, showOnlyActiveZones)
    array<int> obIds = f_smc_select_obs(smcObs, obsClose, obsAtr, showOrderBlocks ? smcObDisplayLimit : 0, showOnlyActiveZones)
    // At most one referenced zone per side may bypass the untouched/display filter.
    for z in smcFvgs
        if showFvg and not z.terminal and (z.creation_sequence_id == obsLongZoneId or z.creation_sequence_id == obsShortZoneId) and not array.includes(fvgIds, z.creation_sequence_id)
            array.push(fvgIds, z.creation_sequence_id)
    for z in smcObs
        if showOrderBlocks and not z.terminal and (z.creation_sequence_id == obsLongZoneId or z.creation_sequence_id == obsShortZoneId) and not array.includes(obIds, z.creation_sequence_id)
            array.push(obIds, z.creation_sequence_id)
    for object in obsLines
        line.set_y1(object, na)
        line.set_y2(object, na)
    for object in obsMidLines
        line.set_y1(object, na)
        line.set_y2(object, na)
    for object in obsLevelLabels
        label.set_xy(object, na, na)
    for object in obsBoxes
        box.set_top(object, na)
        box.set_bottom(object, na)
        box.set_text(object, "")
    if showMarketStructure
        f_obs_line(0, c16c02SwingHighConfirmationTime, c16c02SwingHighTicks, color.new(obsDown, 45), line.style_dashed, 1)
        f_obs_line(1, c16c02SwingLowConfirmationTime, c16c02SwingLowTicks, color.new(obsUp, 45), line.style_dashed, 1)
        if showInducement
            f_obs_line(2, smcLatestInducementTime, smcLatestInducementTicks, color.new(smcLatestInducementSide == 1 ? color.teal : color.red, 20), line.style_dotted, 1)
    int poolSlot = 3
    for z in smcLiquidity
        if array.includes(poolIds, z.creation_sequence_id)
            f_obs_line(poolSlot, z.creation_time, z.level_ticks, color.new(z.side == 1 ? obsUp : obsDown, z.swept ? 85 : 0), line.style_dotted, 1)
            label.set_text(array.get(obsLevelLabels, poolSlot), z.side == 1 ? "Sellside liquidity" : "Buyside liquidity")
            poolSlot += 1
    int boxSlot = 0
    for z in smcFvgs
        if array.includes(fvgIds, z.creation_sequence_id)
            f_obs_box(boxSlot, z.creation_time, z.top_ticks, z.bottom_ticks, z.creation_sequence_id, z.side, z.mitigated, "FVG")
            boxSlot += 1
    for z in smcObs
        if array.includes(obIds, z.creation_sequence_id)
            f_obs_box(boxSlot, z.creation_time, z.top_ticks, z.bottom_ticks, z.creation_sequence_id, z.side, z.mitigated, "OB")
            boxSlot += 1
    int lastBull = -1
    int lastBear = -1
    if array.size(obsStructureEvents) > 0
        for index = 0 to array.size(obsStructureEvents) - 1
            if array.get(obsStructureEvents, index).event_type > 0
                lastBull := index
            else
                lastBear := index
    for slot = 0 to obsStructureLimit - 1
        label object = array.get(obsStructureLabels, slot)
        line segment = array.get(obsStructureLines, slot)
        label.set_xy(object, na, na)
        line.set_xy1(segment, na, na)
        line.set_xy2(segment, na, na)
        if showMarketStructure and slot < array.size(obsStructureEvents) and (obsMode == "Historical" or slot == lastBull or slot == lastBear)
            StructuralEvent event = array.get(obsStructureEvents, slot)
            int origin = array.get(obsStructureStarts, slot)
            float level = f_ticks_to_price(event.price_ticks, syminfo.mintick)
            color tone = event.event_type > 0 ? obsUp : obsDown
            string caption = math.abs(event.event_type) == 2 ? "CHoCH" : "BOS"
            line.set_xy1(segment, origin, level)
            line.set_xy2(segment, event.time, level)
            line.set_color(segment, tone)
            line.set_style(segment, line.style_solid)
            line.set_width(segment, 1)
            label.set_xy(object, int(math.avg(origin, event.time)), level)
            label.set_text(object, caption)
            label.set_style(object, event.event_type > 0 ? label.style_label_down : label.style_label_up)
            label.set_color(object, color(na))
            label.set_textcolor(object, tone)
            label.set_size(object, obsChartSize)
            label.set_tooltip(object, caption + " · đóng vượt " + f_c08_price_text(event.price_ticks) + "\nĐường nối pivot tới nến xác nhận; chỉ xuất hiện sau nến xác nhận.\nXác nhận: " + str.format_time(event.time, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " VN")
    obsRenderedBar := smcCanonicalBarIndex
